// QEMU bare-metal soak: thousands of scheduler cycles with mixed-size
// string churn (short + multi-KB payloads -- the classic split/free
// pattern for a first-fit allocator without coalescing) and variable
// timer delays. Progress every 400 cycles; the exit report's pool
// watermarks are the verdict: live back near the baseline while
// peak >> live means the churn was survived without leaking.
class Program {
    static void Main() {
        string big = "seed";
        int len = 4;
        int i = 0;
        while (i < 8000) {
            string small = "s" + i;
            big = big + "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
            len = len + 64;
            if (len > 4096) { big = "reset"; len = 5; }
            if (i % 400 == 0) { Console.WriteLine("cycle " + i); }
            if (i % 2 == 0) { await Task.Delay(15); }
            i = i + 1;
        }
        Console.WriteLine("soak done");
    }
}
