// QEMU bare-metal probe: prints a counter once a second (Task.Delay idles
// on the CLINT timer interrupt via the board's poll()), string building and
// console output through newlib. Five ticks then exit -- the run script
// timestamps the ticks so timer accuracy and CPU behaviour are visible.
class Program {
    static void Main() {
        int n = 0;
        while (true) {
            Console.WriteLine("tick " + n);
            n = n + 1;
            if (n >= 5) { break; }
            await Task.Delay(1000);
        }
    }
}
