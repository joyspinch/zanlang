// ESP32-C3 hello: prints a counter over the console (UART) once a second.
// Exercises the whole bare-metal path: Console output (newlib printf ->
// UART), string building, the timer reactor's heap (Task.Delay) and the
// coroutine driver's park/unpark round trip. No threads, no sockets.
class Program {
    static void Main() {
        int n = 0;
        while (true) {
            Console.WriteLine("hello from Zan on rv32: " + n);
            n = n + 1;
            await Task.Delay(1000);
        }
    }
}
