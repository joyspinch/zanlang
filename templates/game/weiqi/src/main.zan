// 围棋 -- a quiet 9x9 go salon. You play black against a local heuristic AI
// with real capture/ko/suicide rules and area scoring (komi 7), plus classic
// life-and-death drills (征子 / 直三杀 / 关门吃) that teach the eternal shapes.
// Kaya board and slate/clamshell stone textures, capture bursts, floating
// "提子" popups, rank progression (布衣→棋圣). Esc back/exit.
// GuiHost+Canvas 版：窗口/事件/呈现由 Gui 原生外壳承担（Game.Foundation.Gui），
// 绘制走 Game.Kit.CanvasPrims 直绘，不依赖 SDL。
using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

namespace Weiqi;

class WqProfile {
    int pts;
    int wins;
    int losses;
    int streak;
    int bestStreak;
    int drills;

    static string Path() { return "weiqi_profile.txt"; }
    static int ParseInt(string s, int start) {
        int i = start; int v = 0; bool any = false;
        while (i < s.Length) { int c = s[i] & 255; if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); any = true; i = i + 1; } else { i = s.Length; } }
        if (!any) { return 0; }
        return v;
    }
    static int ReadKey(List<string> lines, string key, int fb) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i]; int eq = -1;
            for (int j = 0; j < ln.Length; j = j + 1) { if (ln[j] == 61) { eq = j; j = ln.Length; } }
            if (eq > 0) { if (ln.Substring(0, eq) == key) { return WqProfile.ParseInt(ln, eq + 1); } }
        }
        return fb;
    }
    static WqProfile Load() {
        WqProfile p = new WqProfile();
        if (!File.Exists(WqProfile.Path())) { return p; }
        List<string> lines = File.ReadAllLines(WqProfile.Path());
        p.pts = WqProfile.ReadKey(lines, "pts", 0);
        p.wins = WqProfile.ReadKey(lines, "wins", 0);
        p.losses = WqProfile.ReadKey(lines, "losses", 0);
        p.streak = WqProfile.ReadKey(lines, "streak", 0);
        p.bestStreak = WqProfile.ReadKey(lines, "bestStreak", 0);
        p.drills = WqProfile.ReadKey(lines, "drills", 0);
        return p;
    }
    void Save() {
        string s = "pts=" + this.pts + "\nwins=" + this.wins
            + "\nlosses=" + this.losses + "\nstreak=" + this.streak
            + "\nbestStreak=" + this.bestStreak + "\ndrills=" + this.drills + "\n";
        File.WriteAllText(WqProfile.Path(), s);
    }
    string Title() {
        if (this.pts >= 420) { return "棋圣"; }
        if (this.pts >= 260) { return "九段"; }
        if (this.pts >= 150) { return "六段"; }
        if (this.pts >= 70) { return "三段"; }
        if (this.pts >= 25) { return "初段"; }
        return "布衣";
    }
}

class WqParticle {
    int x; int y; int vx; int vy; int bornAt; int cr; int cg; int cb;
}
class WqPopup {
    int x; int y; string text; int bornAt; int cr; int cg; int cb;
}

class WqGame {
    GuiHost host;
    Canvas c;
    WqProfile prof;
    Rng rng;

    int[] board;      // 9x9: 0 empty, 1 black (player), 2 white (AI)
    int scene;        // 0 menu, 1 play, 2 over
    int mode;         // 0 game, 1..3 drills
    int moves;
    int lastSq;
    int koSq;         // forbidden ko point or -1
    int passes;       // consecutive passes
    int capB;         // stones captured BY black
    int capW;         // stones captured BY white
    int winner;       // 1 player, 2 ai
    int scoreB;
    int scoreW;
    int aiThinkAt;
    bool aiTurn;
    int mouseX;
    int mouseY;
    int toastAt;
    string toastText;
    int placedAt;
    List<WqParticle> parts;
    List<WqPopup> pops;
    string menuBg;    // asset paths (null = 画布回退画法)
    string titlePath;
    string boardPath;
    string blackPath;
    string whitePath;
    string menuBg2;   // 手绘美术资产（新名，绝不覆盖旧素材）
    string playBg;
    string boardArt;
    string panel;
    string blackPath2;
    string whitePath2;
    bool texTried;
    bool demo;
    int demoAt;

    static int N() { return 9; }
    // 竖屏（舞台高>宽：手机竖屏或竖长窗口）参照手机棋类布局自适应：
    // 9 路棋盘水平居中放大（格距 92），顶部对手条 + 回合徽标，底部
    // 停一手按钮行；横屏维持"左棋盘 + 右信息栏"原布局。
    static bool Portrait() { return WqGame.VW() < WqGame.VH(); }
    static int Cell() {
        if (!WqGame.Portrait()) { return 64; }
        // 竖屏自适应：格距收进当前舞台宽（盘面 8c+76 ≤ VW-20），
        // 否则 92 格距在 720 宽的延展舞台上棋盘会左右出界被裁。
        int c = (WqGame.VW() - 96) / 8;
        if (c > 92) { c = 92; }
        if (c < 24) { c = 24; }
        return c;
    }
    static int BX() { return (WqGame.VW() - 8 * WqGame.Cell()) / 2; }
    static int BY() {
        if (!WqGame.Portrait()) { return 104; }
        // 顶部条(0..150) + 徽标带(到 250)之下、底部按钮行(高 120)之上居中
        return 250 + (WqGame.VH() - 250 - 170 - 8 * WqGame.Cell()) / 2;
    }
    // 视口按宿主舞台每帧延展（宽窗多看宽度）：VW/VH 是当前帧的舞台
    // 逻辑尺寸，帧首在 SyncStage 更新——布局锚定它即可满铺任意窗口，
    // 否则长轴超出的部分就是宿主 margin 底色的空条。
    static int VW() { return vw > 0 ? vw : 1280; }
    static int VH() { return vh > 0 ? vh : 720; }

    // 帧首对齐宿主延展舞台（GuiHost.Render 回调开头调用）。
    void SyncStage(GuiHost host) {
        WqGame.vw = host.StageWidth();
        WqGame.vh = host.StageHeight();
    }
    static int vw;
    static int vh;

    static WqGame Create(GuiHost h) {
        WqGame g = new WqGame();
        g.host = h;
        g.c = h.App().canvas;
        g.prof = WqProfile.Load();
        g.rng = Rng.Seed((long)Window.GetTickMs() + 24680135);
        g.scene = 0;
        g.mouseX = 640;
        g.mouseY = 360;
        g.parts = new List<WqParticle>();
        g.pops = new List<WqPopup>();
        g.toastAt = -9999;
        g.demo = File.Exists("weiqi_demo.txt");
        if (g.demo) { g.StartGame(0, Window.GetTickMs()); }
        return g;
    }

    void EnsureTex() {
        if (this.texTried) { return; }
        this.texTried = true;
        this.menuBg = WqGame.FindAsset("assets/menu_bg.png");
        this.titlePath = WqGame.FindAsset("assets/title.png");
        this.boardPath = WqGame.FindAsset("assets/board_wood.png");
        this.blackPath = WqGame.FindAsset("assets/stone_black.png");
        this.whitePath = WqGame.FindAsset("assets/stone_white.png");
        this.menuBg2 = WqGame.FindAsset("assets/menu_bg2.png");
        this.playBg = WqGame.FindAsset("assets/play_bg.png");
        this.boardArt = WqGame.FindAsset("assets/board_wood2.png");
        this.panel = WqGame.FindAsset("assets/panel.png");
        this.blackPath2 = WqGame.FindAsset("assets/stone_black2.png");
        this.whitePath2 = WqGame.FindAsset("assets/stone_white2.png");
    }
    static string FindAsset(string path) {
        string p = Assets.Find(path);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // 全出血 cover：居中裁剪贴满舞台（长短边都铺满，不留 letterbox 条）。
    static void BlitCover(Canvas c, string path, int dw, int dh) {
        int iw = Canvas.ImageWidth(path);
        int ih = Canvas.ImageHeight(path);
        if (iw <= 0 || ih <= 0) { return; }
        int sw = iw;
        int sh = sw * dh / dw;
        if (sh > ih) { sh = ih; sw = sh * dw / dh; }
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, CDraw.MapX(CDraw.originX), CDraw.MapY(CDraw.originY),
                    CDraw.MapW(dw), CDraw.MapW(dh),
                    (iw - sw) / 2, (ih - sh) / 2, sw, sh);
    }

    // ----- feedback --------------------------------------------------------

    void Toast(string t, int now) { this.toastText = t; this.toastAt = now; }
    void AddPop(int px, int py, string t, int now, int cr, int cg, int cb) {
        if (this.pops.Count > 14) { this.pops.RemoveAt(0); }
        WqPopup p = new WqPopup();
        p.x = px; p.y = py; p.text = t; p.bornAt = now;
        p.cr = cr; p.cg = cg; p.cb = cb;
        this.pops.Add(p);
    }
    void Burst(int px, int py, int n, int now, int cr, int cg, int cb) {
        if (this.parts.Count > 240) { return; }
        for (int i = 0; i < n; i = i + 1) {
            WqParticle p = new WqParticle();
            p.x = px * 256; p.y = py * 256;
            int a = this.rng.Range(0, 16);
            int spd = 60 + this.rng.Range(0, 160);
            int ux = 0; int uy = 0;
            int q = a % 4;
            if (q == 0) { ux = 256; uy = (a / 4 - 2) * 128; }
            if (q == 1) { ux = -256; uy = (a / 4 - 2) * 128; }
            if (q == 2) { uy = 256; ux = (a / 4 - 2) * 128; }
            if (q == 3) { uy = -256; ux = (a / 4 - 2) * 128; }
            p.vx = ux * spd / 256;
            p.vy = uy * spd / 256;
            p.bornAt = now;
            p.cr = cr; p.cg = cg; p.cb = cb;
            this.parts.Add(p);
        }
    }

    // ----- setup -----------------------------------------------------------

    void Put(int x, int y, int c) { this.board[y * WqGame.N() + x] = c; }

    void StartGame(int mode, int now) {
        int n = WqGame.N();
        this.board = new int[n * n];
        this.mode = mode;
        this.moves = 0;
        this.lastSq = -1;
        this.koSq = -1;
        this.passes = 0;
        this.capB = 0;
        this.capW = 0;
        this.winner = 0;
        this.scoreB = 0;
        this.scoreW = 0;
        this.aiTurn = false;
        this.parts = new List<WqParticle>();
        this.pops = new List<WqPopup>();
        this.toastAt = -9999;
        if (mode == 1) {
            // 征子: chase the lone white stone into the wall
            this.Put(2, 3, 1); this.Put(3, 2, 1);
            this.Put(3, 3, 2);
            this.Toast("死活题·征子：黑先，叫吃到底提掉白子", now);
        } else if (mode == 2) {
            // 直三杀: white ring alive only through the three inner points
            this.Put(2, 1, 2); this.Put(3, 1, 2); this.Put(4, 1, 2); this.Put(5, 1, 2); this.Put(6, 1, 2);
            this.Put(2, 2, 2); this.Put(6, 2, 2);
            this.Put(2, 3, 2); this.Put(3, 3, 2); this.Put(4, 3, 2); this.Put(5, 3, 2); this.Put(6, 3, 2);
            this.Put(1, 1, 1); this.Put(1, 2, 1); this.Put(1, 3, 1);
            this.Put(2, 0, 1); this.Put(3, 0, 1); this.Put(4, 0, 1); this.Put(5, 0, 1); this.Put(6, 0, 1);
            this.Put(7, 1, 1); this.Put(7, 2, 1); this.Put(7, 3, 1);
            this.Put(2, 4, 1); this.Put(3, 4, 1); this.Put(4, 4, 1); this.Put(5, 4, 1); this.Put(6, 4, 1);
            this.Toast("死活题·直三杀：点在要害，白不得两眼", now);
        } else if (mode == 3) {
            // 关门吃: shut the door on the white cutter
            this.Put(5, 6, 1); this.Put(6, 5, 1);
            this.Put(6, 6, 2);
            this.Toast("死活题·关门吃：一步关门，白子无路", now);
        } else {
            this.Toast("黑先，围地多者胜（贴七目）", now);
        }
        this.scene = 1;
        if (this.demo) { this.demoAt = now + 500; }
    }

    static string DrillName(int m) {
        if (m == 1) { return "征子"; }
        if (m == 2) { return "直三杀"; }
        return "关门吃";
    }
    static int DrillTarget(int m) {
        if (m == 2) { return 8; }
        return 1;
    }

    // ----- rules -----------------------------------------------------------

    int At(int x, int y) {
        int n = WqGame.N();
        if (x < 0 || y < 0 || x >= n || y >= n) { return -1; }
        return this.board[y * n + x];
    }

    // collects the group containing (x,y) into outSq; returns its liberties
    int Group(int x, int y, List<int> outSq) {
        int n = WqGame.N();
        int c = this.At(x, y);
        if (c <= 0) { return 0; }
        bool[] seen = new bool[n * n];
        bool[] libSeen = new bool[n * n];
        List<int> stack = new List<int>();
        stack.Add(y * n + x);
        seen[y * n + x] = true;
        int libs = 0;
        while (stack.Count > 0) {
            int sq = stack[stack.Count - 1];
            stack.RemoveAt(stack.Count - 1);
            outSq.Add(sq);
            int sx = sq % n; int sy = sq / n;
            for (int d = 0; d < 4; d = d + 1) {
                int tx = sx; int ty = sy;
                if (d == 0) { tx = sx + 1; }
                if (d == 1) { tx = sx - 1; }
                if (d == 2) { ty = sy + 1; }
                if (d == 3) { ty = sy - 1; }
                int v = this.At(tx, ty);
                if (v == 0) {
                    int tsq = ty * n + tx;
                    if (!libSeen[tsq]) { libSeen[tsq] = true; libs = libs + 1; }
                } else if (v == c) {
                    int tsq = ty * n + tx;
                    if (!seen[tsq]) { seen[tsq] = true; stack.Add(tsq); }
                }
            }
        }
        return libs;
    }

    // plays color c at (x,y); returns captured count or -1 if illegal
    int TryPlay(int x, int y, int c, int now) {
        int n = WqGame.N();
        if (this.At(x, y) != 0) { return -1; }
        int sq = y * n + x;
        if (sq == this.koSq) { return -1; }
        this.board[sq] = c;
        int other = 3 - c;
        int captured = 0;
        int lastCapSq = -1;
        for (int d = 0; d < 4; d = d + 1) {
            int tx = x; int ty = y;
            if (d == 0) { tx = x + 1; }
            if (d == 1) { tx = x - 1; }
            if (d == 2) { ty = y + 1; }
            if (d == 3) { ty = y - 1; }
            if (this.At(tx, ty) == other) {
                List<int> g = new List<int>();
                int libs = this.Group(tx, ty, g);
                if (libs == 0) {
                    for (int i = 0; i < g.Count; i = i + 1) {
                        this.board[g[i]] = 0;
                        lastCapSq = g[i];
                        int px = WqGame.BX() + (g[i] % n) * WqGame.Cell();
                        int py = WqGame.BY() + (g[i] / n) * WqGame.Cell();
                        this.Burst(px, py, 6, now, 255, 200, 110);
                    }
                    captured = captured + g.Count;
                }
            }
        }
        List<int> own = new List<int>();
        int ownLibs = this.Group(x, y, own);
        if (captured == 0 && ownLibs == 0) {
            this.board[sq] = 0;
            return -1;
        }
        // simple ko: single-stone capture by a single lone stone
        this.koSq = -1;
        if (captured == 1 && own.Count == 1 && ownLibs == 1) { this.koSq = lastCapSq; }
        return captured;
    }

    // probe without mutation: copies the board, plays, restores
    int Probe(int x, int y, int c) {
        int n = WqGame.N();
        int[] save = new int[n * n];
        int i = 0;
        for (; i < n * n; i = i + 1) { save[i] = this.board[i]; }
        int res = this.TryPlayRaw(x, y, c);
        i = 0;
        while (i < n * n) { this.board[i] = save[i]; i = i + 1; }
        return res;
    }
    // returns captured count, or -1 illegal (mutates board; caller restores)
    int TryPlayRaw(int x, int y, int c) {
        int n = WqGame.N();
        if (this.At(x, y) != 0) { return -1; }
        int sq = y * n + x;
        if (sq == this.koSq) { return -1; }
        this.board[sq] = c;
        int other = 3 - c;
        int captured = 0;
        for (int d = 0; d < 4; d = d + 1) {
            int tx = x; int ty = y;
            if (d == 0) { tx = x + 1; }
            if (d == 1) { tx = x - 1; }
            if (d == 2) { ty = y + 1; }
            if (d == 3) { ty = y - 1; }
            if (this.At(tx, ty) == other) {
                List<int> g = new List<int>();
                int libs = this.Group(tx, ty, g);
                if (libs == 0) {
                    for (int i = 0; i < g.Count; i = i + 1) { this.board[g[i]] = 0; }
                    captured = captured + g.Count;
                }
            }
        }
        List<int> own = new List<int>();
        int ownLibs = this.Group(x, y, own);
        if (captured == 0 && ownLibs == 0) { return -1; }
        return captured;
    }

    // area scoring: stones + territory reachable from exactly one color
    void Score() {
        int n = WqGame.N();
        int b = 0; int w = 0;
        bool[] seen = new bool[n * n];
        for (int i = 0; i < n * n; i = i + 1) {
            int v = this.board[i];
            if (v == 1) { b = b + 1; }
            if (v == 2) { w = w + 1; }
            if (v == 0 && !seen[i]) {
                // flood-fill the empty region, note bordering colors
                List<int> reg = new List<int>();
                List<int> stack = new List<int>();
                stack.Add(i);
                seen[i] = true;
                bool tb = false; bool tw = false;
                while (stack.Count > 0) {
                    int sq = stack[stack.Count - 1];
                    stack.RemoveAt(stack.Count - 1);
                    reg.Add(sq);
                    int sx = sq % n; int sy = sq / n;
                    for (int d = 0; d < 4; d = d + 1) {
                        int tx = sx; int ty = sy;
                        if (d == 0) { tx = sx + 1; }
                        if (d == 1) { tx = sx - 1; }
                        if (d == 2) { ty = sy + 1; }
                        if (d == 3) { ty = sy - 1; }
                        int v2 = this.At(tx, ty);
                        if (v2 == 0) {
                            int tsq = ty * n + tx;
                            if (!seen[tsq]) { seen[tsq] = true; stack.Add(tsq); }
                        } else if (v2 == 1) { tb = true; }
                        else if (v2 == 2) { tw = true; }
                    }
                }
                if (tb && !tw) { b = b + reg.Count; }
                if (tw && !tb) { w = w + reg.Count; }
            }
        }
        this.scoreB = b;
        this.scoreW = w + 7;   // komi
    }

    void EndByScore(int now) {
        this.Score();
        if (this.scoreB > this.scoreW) { this.Win(1, now); } else { this.Win(2, now); }
    }

    void Win(int who, int now) {
        this.winner = who;
        this.scene = 2;
        if (who == 1) {
            int gain = 15;
            if (this.mode > 0) { gain = 18; this.prof.drills = this.prof.drills + 1; }
            this.prof.pts = this.prof.pts + gain;
            this.prof.wins = this.prof.wins + 1;
            this.prof.streak = this.prof.streak + 1;
            if (this.prof.streak > this.prof.bestStreak) { this.prof.bestStreak = this.prof.streak; }
            this.Burst(640, 300, 60, now, 255, 210, 100);
        } else {
            this.prof.losses = this.prof.losses + 1;
            this.prof.streak = 0;
            this.prof.pts = this.prof.pts - 5;
            if (this.prof.pts < 0) { this.prof.pts = 0; }
        }
        this.prof.Save();
    }

    void Place(int x, int y, int c, int now) {
        int n = WqGame.N();
        int captured = this.TryPlay(x, y, c, now);
        if (captured < 0) { return; }
        this.moves = this.moves + 1;
        this.passes = 0;
        this.lastSq = y * n + x;
        this.placedAt = now;
        int sx = WqGame.BX() + x * WqGame.Cell();
        int sy = WqGame.BY() + y * WqGame.Cell();
        if (captured > 0) {
            if (c == 1) { this.capB = this.capB + captured; }
            else { this.capW = this.capW + captured; }
            this.AddPop(sx, sy - 28, "提 " + captured + " 子", now, 255, 205, 110);
            if (captured >= 3) { this.Toast("大块提子！痛快", now); }
        }
        // drill win check
        if (this.mode > 0 && c == 1 && this.capB >= WqGame.DrillTarget(this.mode)) {
            this.Win(1, now);
            return;
        }
        this.aiTurn = (c == 1);
        if (this.aiTurn) { this.aiThinkAt = now + 350 + this.rng.Range(0, 450); }
    }

    void PlayerPass(int now) {
        if (this.aiTurn || this.scene != 1) { return; }
        this.passes = this.passes + 1;
        this.moves = this.moves + 1;
        this.koSq = -1;
        this.Toast("你选择停一手", now);
        if (this.passes >= 2) { this.EndByScore(now); return; }
        this.aiTurn = true;
        this.aiThinkAt = now + 400;
    }

    // ----- AI --------------------------------------------------------------

    int NeighborCount(int x, int y, int c) {
        int k = 0;
        for (int d = 0; d < 8; d = d + 1) {
            int dx = d % 3 - 1;
            int dy = d / 3 - 1;
            if (this.At(x + dx, y + dy) == c) { k = k + 1; }
        }
        return k;
    }

    int AiScoreMove(int x, int y) {
        int cap = this.Probe(x, y, 2);
        if (cap < 0) { return -1000000; }
        int v = this.rng.Range(0, 14);
        v = v + cap * 260;
        // liberties after the move / avoid self-atari
        int n = WqGame.N();
        int[] save = new int[n * n];
        int i = 0;
        for (; i < n * n; i = i + 1) { save[i] = this.board[i]; }
        this.TryPlayRaw(x, y, 2);
        List<int> own = new List<int>();
        int libs = this.Group(x, y, own);
        // does this rescue a white group that was in atari?
        int rescued = 0;
        if (libs >= 2 && own.Count > 1) { rescued = 1; }
        i = 0;
        while (i < n * n) { this.board[i] = save[i]; i = i + 1; }
        if (libs <= 1 && cap == 0) { v = v - 700; }
        v = v + libs * 22;
        // threaten black groups: adjacent enemy stones with few liberties
        for (int d = 0; d < 4; d = d + 1) {
            int tx = x; int ty = y;
            if (d == 0) { tx = x + 1; }
            if (d == 1) { tx = x - 1; }
            if (d == 2) { ty = y + 1; }
            if (d == 3) { ty = y - 1; }
            if (this.At(tx, ty) == 1) {
                List<int> g = new List<int>();
                int gl = this.Group(tx, ty, g);
                if (gl == 2) { v = v + 90; }
                if (gl == 1) { v = v + 240; }
            } else if (this.At(tx, ty) == 2) {
                List<int> g = new List<int>();
                int gl = this.Group(tx, ty, g);
                if (gl == 1) { v = v + 320 * rescued; }
            }
        }
        // gentle shape prefs: contact play, edge in drills, center early
        v = v + this.NeighborCount(x, y, 2) * 8;
        v = v + this.NeighborCount(x, y, 1) * 12;
        if (this.mode == 0 && this.moves < 12) {
            int cx = x - 4; int cy = y - 4;
            if (cx < 0) { cx = -cx; }
            if (cy < 0) { cy = -cy; }
            v = v + (4 - cx) * 6 + (4 - cy) * 6;
        }
        return v;
    }

    void AiMove(int now) {
        int n = WqGame.N();
        int bestV = -1000000;
        int bestX = -1; int bestY = -1;
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                if (this.At(x, y) == 0) {
                    int v = this.AiScoreMove(x, y);
                    if (v > bestV) { bestV = v; bestX = x; bestY = y; }
                }
            }
        }
        // pass when nothing worthwhile remains
        int threshold = -999999;
        if (this.mode == 0 && this.moves > 30) { threshold = 40; }
        if (bestX < 0 || bestV < threshold) {
            this.passes = this.passes + 1;
            this.moves = this.moves + 1;
            this.koSq = -1;
            this.Toast("白棋停一手", now);
            this.aiTurn = false;
            if (this.passes >= 2) { this.EndByScore(now); }
            return;
        }
        this.Place(bestX, bestY, 2, now);
        this.aiTurn = false;
    }

    // ----- input -----------------------------------------------------------

    void OnDown(int cx, int cy, int now) {
        if (this.scene == 0) {
            if (WqGame.Portrait()) {
                // 竖屏菜单：单列居中（与 DrawMenu 同矩形）
                if (CDraw.PointIn(cx, cy, WqGame.VW() / 2 - 210, 330, 420, 74)) { this.StartGame(0, now); }
                if (CDraw.PointIn(cx, cy, WqGame.VW() / 2 - 210, 420, 420, 74)) { this.StartGame(1, now); }
                if (CDraw.PointIn(cx, cy, WqGame.VW() / 2 - 210, 510, 420, 74)) { this.StartGame(2, now); }
                if (CDraw.PointIn(cx, cy, WqGame.VW() / 2 - 210, 600, 420, 74)) { this.StartGame(3, now); }
                return;
            }
            if (CDraw.PointIn(cx, cy, 430, 300, 420, 74)) { this.StartGame(0, now); }
            if (CDraw.PointIn(cx, cy, 430, 390, 420, 74)) { this.StartGame(1, now); }
            if (CDraw.PointIn(cx, cy, 430, 480, 420, 74)) { this.StartGame(2, now); }
            if (CDraw.PointIn(cx, cy, 430, 570, 420, 74)) { this.StartGame(3, now); }
            return;
        }
        if (this.scene == 2) {
            if (CDraw.PointIn(cx, cy, 420, 430, 210, 60)) { this.StartGame(this.mode, now); return; }
            if (CDraw.PointIn(cx, cy, 650, 430, 210, 60)) { this.scene = 0; return; }
            return;
        }
        // pass button（竖屏 = 底部按钮行）
        if (WqGame.Portrait()) {
            int vw = WqGame.VW();
            int by = WqGame.VH() - 120;
            if (!this.aiTurn && this.winner == 0
                && CDraw.PointIn(cx, cy, vw / 2 - 210, by, 420, 64)) { this.PlayerPass(now); return; }
        } else if (CDraw.PointIn(cx, cy, 770, 560, 200, 56) && !this.aiTurn) { this.PlayerPass(now); return; }
        if (this.aiTurn || this.winner != 0) { return; }
        int c = WqGame.Cell();
        int gx = (cx - WqGame.BX() + c / 2) / c;
        int gy = (cy - WqGame.BY() + c / 2) / c;
        int n = WqGame.N();
        if (gx < 0 || gy < 0 || gx >= n || gy >= n) { return; }
        if (this.At(gx, gy) != 0) { return; }
        if (this.Probe(gx, gy, 1) < 0) { this.Toast("此处不能落子", now); return; }
        this.Place(gx, gy, 1, now);
    }

    void OnKey(int key, int now) {
        if (key == 27) { if (this.scene == 0) { this.host.RequestStop(); } else { this.scene = 0; } return; }
        if (key == 80 && this.scene == 1) { this.PlayerPass(now); return; }   // P
        if (this.scene == 2 && (key == 13 || key == 32)) { this.StartGame(this.mode, now); }
    }

    void Tick(int now) {
        if (this.scene == 1 && this.aiTurn && now >= this.aiThinkAt) {
            this.AiMove(now);
            this.demoAt = now + 420;
        }
        if (this.demo && this.scene == 1 && !this.aiTurn && now >= this.demoAt) {
            this.DemoMove(now);
        }
    }

    // demo: black mirrors the AI heuristic so screenshots show a real game
    void DemoMove(int now) {
        int n = WqGame.N();
        int bestV = -1000000;
        int bestX = -1; int bestY = -1;
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                if (this.At(x, y) == 0) {
                    int cap = this.Probe(x, y, 1);
                    if (cap >= 0) {
                        int v = cap * 260 + this.NeighborCount(x, y, 2) * 14
                            + this.NeighborCount(x, y, 1) * 8 + this.rng.Range(0, 60);
                        if (v > bestV) { bestV = v; bestX = x; bestY = y; }
                    }
                }
            }
        }
        if (bestX < 0 || this.moves > 52) { this.PlayerPass(now); return; }
        this.Place(bestX, bestY, 1, now);
    }

    // ----- rendering -------------------------------------------------------

    void DrawAmbient() {
        this.EnsureTex();
        int vw = WqGame.VW();
        int vh = WqGame.VH();
        if (this.playBg != null) {
            // 对局底：整幅 cover + 轻压暗，两处暖光晕提棋室氛围。
            WqGame.BlitCover(this.c, this.playBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(150, 18, 10, 7));
            this.c.FillRadial(CDraw.MapX(vw / 3), CDraw.MapY(vh / 3), CDraw.MapW(430),
                              CDraw.Argb(255, 220, 150, 80), 16);
            this.c.FillRadial(CDraw.MapX(vw * 2 / 3), CDraw.MapY(vh * 4 / 5), CDraw.MapW(360),
                              CDraw.Argb(255, 220, 140, 70), 12);
        } else if (this.menuBg != null) {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(190, 18, 14, 10));
            CDraw.FillCircle(this.c, vw / 3, vh / 3, 420, 255, 190, 110, 14);
        }
        CFx.Vignette(this.c, vw, vh, 70);
    }

    void DrawBoard(int now) {
        int n = WqGame.N();
        int c = WqGame.Cell();
        int x0 = WqGame.BX();
        int y0 = WqGame.BY();
        int span = (n - 1) * c;
        // 漆木桌 + 真实榧木棋盘面（先投影后落板，再描金边）
        if (this.boardArt != null) {
            CFx.ShadowRect(this.c, x0 - 38, y0 - 30, span + 76, span + 76, 18, 22, 0, 0, 0, 130);
            CDraw.BlitImage(this.c, this.boardArt, x0 - 38, y0 - 38, span + 76, span + 76);
            CDraw.FillRect(this.c, x0 - 38, y0 - 38, span + 76, span + 76,
                CDraw.Argb(18, 255, 226, 170));
            CFx.Ring(this.c, x0 - 38, y0 - 38, span + 76, span + 76, 12, 1, 40, 20, 8, 150);
        } else {
            CDraw.RoundRectFill(this.c, x0 - 48, y0 - 48, span + 96, span + 96, 14, 60, 38, 20, 255);
            if (this.boardPath != null) {
                CDraw.BlitImage(this.c, this.boardPath, x0 - 40, y0 - 40, span + 80, span + 80);
                CDraw.FillRect(this.c, x0 - 40, y0 - 40, span + 80, span + 80,
                    CDraw.Argb(18, 255, 220, 160));
            } else {
                CDraw.RoundRectFill(this.c, x0 - 40, y0 - 40, span + 80, span + 80, 10, 214, 168, 106, 255);
            }
        }
        int grid = CDraw.Argb(240, 40, 24, 12);
        for (int i = 0; i < n; i = i + 1) {
            CDraw.FillRect(this.c, x0, y0 + i * c - 1, span, 2, grid);
            CDraw.FillRect(this.c, x0 + i * c - 1, y0, 2, span, grid);
        }
        // star points (9x9: corners at 2, center at 4)
        CDraw.FillCircle(this.c, x0 + 2 * c, y0 + 2 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 6 * c, y0 + 2 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 2 * c, y0 + 6 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 6 * c, y0 + 6 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 4 * c, y0 + 4 * c, 4, 40, 24, 12, 240);
        // stones
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                int v = this.At(x, y);
                if (v > 0) {
                    int sx = x0 + x * c;
                    int sy = y0 + y * c;
                    int rad = c * 27 / 92;
                    bool isLast = this.lastSq == y * n + x;
                    if (isLast) {
                        int age = now - this.placedAt;
                        int grow = rad * 2 / 9;
                        if (age < 220 && age >= 0) { rad = rad - grow + age * grow / 220; }
                        CDraw.FillCircle(this.c, sx, sy, rad + 8, 255, 200, 110, 60);
                    }
                    CDraw.FillCircle(this.c, sx + 2, sy + 4, rad, 30, 18, 8, 90);
                    string stone = this.blackPath2;
                    if (v == 2) { stone = this.whitePath2; }
                    if (stone == null) { stone = this.blackPath; }
                    if (v == 2 && this.whitePath2 == null) { stone = this.whitePath; }
                    if (stone != null) {
                        CDraw.BlitImage(this.c, stone, sx - rad, sy - rad, rad * 2, rad * 2);
                    } else if (v == 1) {
                        CDraw.FillCircle(this.c, sx, sy, rad, 34, 36, 44, 255);
                        CDraw.FillCircle(this.c, sx - 6, sy - 8, rad / 3, 130, 140, 160, 200);
                    } else {
                        CDraw.FillCircle(this.c, sx, sy, rad, 236, 232, 222, 255);
                        CDraw.FillCircle(this.c, sx - 6, sy - 8, rad / 3, 255, 255, 255, 230);
                    }
                    if (isLast) {
                        CDraw.FillCircle(this.c, sx, sy, 5, 255, 90, 90, 220);
                    }
                }
            }
        }
        // ko marker
        if (this.koSq >= 0) {
            int kx = x0 + (this.koSq % n) * c;
            int ky = y0 + (this.koSq / n) * c;
            int km = c * 10 / 92;
            CDraw.RingRect(this.c, kx - km, ky - km, km * 2, km * 2, 2, 220, 90, 80, 200);
        }
        // hover ghost
        if (this.scene == 1 && !this.aiTurn) {
            int gx = (this.mouseX - x0 + c / 2) / c;
            int gy = (this.mouseY - y0 + c / 2) / c;
            if (gx >= 0 && gy >= 0 && gx < n && gy < n && this.At(gx, gy) == 0) {
                CDraw.FillCircle(this.c, x0 + gx * c, y0 + gy * c, c * 24 / 92, 34, 36, 44, 90);
            }
        }
    }

    void DrawSide(int now) {
        if (WqGame.Portrait()) { this.DrawTopBar(now); return; }
        int px = 720;
        CFx.Card(this.c, px, 66, 492, 588, 16, 40, 28, 16, 30, 20, 12, 226, 186, 128, 90, 1, 0);
        CFx.Rule(this.c, px + 246, 148, 190, 226, 186, 128, 130);
        CText.Draw(this.c, "围棋", px + 36, 96, 5, 240, 224, 195, 255);
        string mn = "九路对弈 · 贴七目";
        if (this.mode > 0) { mn = "死活题 · " + WqGame.DrillName(this.mode); }
        CText.Draw(this.c, mn, px + 36, 170, 2, 255, 216, 152, 255);
        string turn = "轮到你落子";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "白棋长考中…"; tr = 255; tg = 214; tb = 150; }
        CText.Draw(this.c, turn, px + 36, 214, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分", px + 36, 286, 2, 235, 226, 205, 255);
        CText.Draw(this.c, "胜 " + this.prof.wins + " · 负 " + this.prof.losses, px + 36, 326, 2, 200, 192, 172, 255);
        CText.Draw(this.c, "连胜 " + this.prof.streak + " · 最佳 " + this.prof.bestStreak, px + 36, 366, 2, 200, 192, 172, 255);
        CText.Draw(this.c, "你提子 " + this.capB + " · 白提子 " + this.capW, px + 36, 406, 2, 200, 192, 172, 255);
        if (this.mode > 0) {
            CText.Draw(this.c, "目标：提 " + WqGame.DrillTarget(this.mode) + " 子", px + 36, 446, 2, 255, 205, 130, 255);
        } else {
            CText.Draw(this.c, "第 " + (this.moves + 1) + " 手", px + 36, 446, 2, 200, 192, 172, 255);
        }
        CKitUi.Button(this.c, this.mouseX, this.mouseY, 770, 560, 200, 56, "停一手 (P)", 2, 0);
        CText.Draw(this.c, "Esc 菜单", px + 36, 630, 2, 160, 152, 136, 255);
    }

    // 竖屏对局 HUD：顶部对手条 + 回合徽标（参考手机棋类布局），
    // 底部"停一手"整宽按钮行。
    void DrawTopBar(int now) {
        int vw = WqGame.VW();
        CFx.Card(this.c, 16, 24, vw - 32, 112, 16, 40, 28, 16, 30, 20, 12, 226, 186, 128, 90, 1, 0);
        CText.Draw(this.c, "对手 · 白棋", 40, 44, 3, 240, 224, 195, 255);
        string mn = "九路对弈 · 贴七目";
        if (this.mode > 0) { mn = "死活题 · " + WqGame.DrillName(this.mode); }
        CText.Draw(this.c, mn, 40, 92, 2, 255, 216, 152, 255);
        string turn = "轮到你落子";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "白棋长考中…"; tr = 255; tg = 214; tb = 150; }
        CFx.Pill(this.c, vw - 300, 48, 268, 64, 0, 26, 16, 10, 16, 9, 5, 226, 186, 128, 70);
        CText.DrawCentered(this.c, turn, vw - 166, 66, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分 · 胜 "
            + this.prof.wins + " 负 " + this.prof.losses, 40, 200, 2, 200, 192, 172, 255);
        CText.Draw(this.c, "你提子 " + this.capB + " · 白提子 " + this.capW
            + " · 第 " + (this.moves + 1) + " 手", 40, 236, 2, 200, 192, 172, 255);
        int by = WqGame.VH() - 120;
        CKitUi.Button(this.c, this.mouseX, this.mouseY, vw / 2 - 210, by, 420, 64, "停一手 (P)", 3, 0);
    }

    void DrawFx(int now) {
        int i = 0;
        while (i < this.parts.Count) {
            WqParticle p = this.parts[i];
            int age = now - p.bornAt;
            if (age > 900) { this.parts.RemoveAt(i); continue; }
            int px = (p.x + p.vx * age / 4) / 256;
            int py = (p.y + p.vy * age / 4) / 256 + age * age / 26000;
            int alpha = 235 - age * 235 / 900;
            CDraw.FillCircle(this.c, px, py, 3, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        i = 0;
        while (i < this.pops.Count) {
            WqPopup p = this.pops[i];
            int age = now - p.bornAt;
            if (age > 1400) { this.pops.RemoveAt(i); continue; }
            int alpha = 255 - age * 255 / 1400;
            CText.DrawCentered(this.c, p.text, p.x, p.y - age / 14, 2, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        if (now - this.toastAt < 2200) {
            CText.DrawCenteredShadow(this.c, this.toastText, WqGame.VW() / 2, WqGame.VH() / 2 - 120, 2, 255, 224, 150, 255);
        }
    }

    void DrawPlay(int now) {
        CDraw.Clear(this.c, WqGame.VW(), WqGame.VH(), CDraw.Argb(255, 30, 22, 14));
        this.DrawAmbient();
        this.DrawBoard(now);
        this.DrawSide(now);
        this.DrawFx(now);
    }

    void DrawMenu(int now) {
        this.EnsureTex();
        int vw = WqGame.VW();
        int vh = WqGame.VH();
        CDraw.Clear(this.c, vw, vh, CDraw.Argb(255, 24, 18, 12));
        if (this.menuBg2 != null) {
            WqGame.BlitCover(this.c, this.menuBg2, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(110, 18, 10, 6));
        } else {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(120, 14, 10, 6));
        }
        CFx.Vignette(this.c, vw, vh, 90);
        if (this.titlePath != null) {
            CDraw.BlitImage(this.c, this.titlePath, vw / 2 - 300, 30, 600, 200);
        } else {
            CText.DrawCenteredShadow(this.c, "围棋", vw / 2, 70, 9, 245, 232, 205, 255);
        }
        CText.DrawCenteredShadow(this.c, "黑白之间 · 死活经典 · 段位成长", vw / 2, 244, 3, 255, 218, 160, 255);
        CFx.Rule(this.c, vw / 2, 280, 150, 226, 186, 128, 190);
        if (WqGame.Portrait()) {
            CFx.GoldButton(this.c, this.mouseX, this.mouseY, vw / 2 - 210, 330, 420, 74, "九路对弈", 3, 1);
            CFx.GoldButton(this.c, this.mouseX, this.mouseY, vw / 2 - 210, 420, 420, 74, "死活题 · 征子", 3, 0);
            CFx.GoldButton(this.c, this.mouseX, this.mouseY, vw / 2 - 210, 510, 420, 74, "死活题 · 直三杀", 3, 1);
            CFx.GoldButton(this.c, this.mouseX, this.mouseY, vw / 2 - 210, 600, 420, 74, "死活题 · 关门吃", 3, 0);
            CText.DrawCenteredShadow(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts
                + " 分 · 胜 " + this.prof.wins + " 负 " + this.prof.losses
                + " · 死活通关 " + this.prof.drills, vw / 2, 704, 2, 230, 212, 182, 255);
            return;
        }
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, 430, 300, 420, 74, "九路对弈", 3, 1);
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, 430, 390, 420, 74, "死活题 · 征子", 3, 0);
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, 430, 480, 420, 74, "死活题 · 直三杀", 3, 1);
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, 430, 570, 420, 74, "死活题 · 关门吃", 3, 0);
        CText.DrawCenteredShadow(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts
            + " 分 · 胜 " + this.prof.wins + " 负 " + this.prof.losses
            + " · 死活通关 " + this.prof.drills, WqGame.VW() / 2, WqGame.VH() - 52, 2, 230, 212, 182, 255);
    }

    void DrawOver(int now) {
        CDraw.Clear(this.c, WqGame.VW(), WqGame.VH(), CDraw.Argb(255, 30, 22, 14));
        this.DrawAmbient();
        this.DrawBoard(now);
        this.DrawSide(now);
        CDraw.FillRect(this.c, 0, 0, WqGame.VW(), WqGame.VH(), CDraw.Argb(165, 12, 10, 6));
        int by = WqGame.Portrait() ? WqGame.VH() / 2 - 170 : 190;
        int bx = WqGame.VW() / 2 - 250;
        if (this.panel != null) {
            CFx.ShadowRect(this.c, bx, by, 500, 320, 18, 16, 0, 0, 0, 120);
            CDraw.BlitImage(this.c, this.panel, bx, by, 500, 320);
            CFx.Ring(this.c, bx, by, 500, 320, 18, 1, 226, 186, 128, 180);
        } else {
            CFx.Card(this.c, bx, by, 500, 320, 22, 36, 26, 14, 26, 18, 10, 250, 226, 186, 128, 160, 1);
        }
        CFx.Rule(this.c, WqGame.VW() / 2, by + 26, 150, 226, 186, 128, 190);
        if (this.winner == 1) {
            CText.DrawCenteredShadow(this.c, "妙手成局，黑胜！", WqGame.VW() / 2, by + 34, 5, 255, 218, 110, 255);
            if (this.mode == 0) {
                CText.DrawCentered(this.c, "黑 " + this.scoreB + " · 白 " + this.scoreW + "（含贴目）", WqGame.VW() / 2, by + 110, 3, 240, 226, 200, 255);
            } else {
                CText.DrawCentered(this.c, "死活要点，一击即中", WqGame.VW() / 2, by + 110, 3, 240, 226, 200, 255);
            }
            string cheer = "棋形优美，再来一盘！";
            if (this.prof.streak >= 3) { cheer = this.prof.streak + " 连胜！势不可挡"; }
            CText.DrawCentered(this.c, cheer, WqGame.VW() / 2, by + 166, 2, 150, 230, 190, 255);
        } else {
            CText.DrawCenteredShadow(this.c, "白棋略胜半子", WqGame.VW() / 2, by + 34, 5, 235, 165, 150, 255);
            if (this.mode == 0) {
                CText.DrawCentered(this.c, "黑 " + this.scoreB + " · 白 " + this.scoreW + "（含贴目）", WqGame.VW() / 2, by + 110, 3, 225, 210, 190, 255);
            } else {
                CText.DrawCentered(this.c, "差一步之遥，再试一次", WqGame.VW() / 2, by + 110, 3, 225, 210, 190, 255);
            }
            CText.DrawCentered(this.c, "复盘一手，胜负手就在眼前", WqGame.VW() / 2, by + 166, 2, 255, 216, 152, 255);
        }
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, bx + 30, by + 240, 210, 60, "再来一局", 3, 1);
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, bx + 260, by + 240, 210, 60, "回到菜单", 3, 0);
        this.DrawFx(now);
    }

    void Render(int now) {
        if (this.scene == 0) { this.DrawMenu(now); }
        else if (this.scene == 2) { this.DrawOver(now); }
        else { this.DrawPlay(now); }
    }
}

// GuiHost 主循环回调：事件 → 固定步长模拟（16ms，追帧上限内多次）→
// 渲染（BeginFrame/PresentFrame 由宿主包好；帧预算自限速约 60fps）。
class WqLoop : IGuiHostLoop {
    WqGame g;

    public void Start(GuiHost host) {
        this.g = WqGame.Create(host);
    }
    public void Event(GuiHost host, int kind, int code) {
        int now = Window.GetTickMs();
        // 指针坐标经 host.MouseX/Y 反变换回舞台逻辑坐标（桌面视口
        // letterbox / 手机驱动反变换都在宿主之下完成）。
        if (kind == 4) {
            this.g.OnKey(code, now);
        // 鼠标 kind:1=移动 2=按下 3=释放(Win32Shell 契约)。
        } else if (kind == 1) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
        } else if (kind == 2) {
            if (code == 0) {
                this.g.mouseX = host.MouseX();
                this.g.mouseY = host.MouseY();
                this.g.OnDown(this.g.mouseX, this.g.mouseY, now);
            }
        }
    }
    public void FixedUpdate(GuiHost host, int dt) {
        this.g.Tick(Window.GetTickMs());
    }
    public void Update(GuiHost host, int dt) { }
    public void Render(GuiHost host, Canvas c, double alpha) {
        // Android 上表面晚于 Start 到达(转向/后台往返亦然),App 会整体
        // 换新画布对象(App.SwapCanvas);Start 时抓的引用画进已销毁的
        // 旧表面,永不 present。每帧对齐到宿主传入的当前画布。
        this.g.c = c;
        // 舞台 0 基绘制：原点落到标准标题栏之下，chrome 由宿主在
        // 内容之上叠画。帧首先把宿主延展后的舞台尺寸同步进 VW/VH，
        // 布局才能铺满整窗（宽窗多看宽度，不落 margin 空条）。
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.Render(Window.GetTickMs());
    }
    public void Stop(GuiHost host) { }
}

class WqApp {
    static void Main() {
        // 手机竖屏：GuiHost 逻辑宽高比定外壳方向（见 xiangqi 同注）。
        GuiHost host = new GuiHost("围棋", 720, 1280, 16);
        host.Run(new WqLoop());
    }
}
