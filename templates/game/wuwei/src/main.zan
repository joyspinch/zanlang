    static List<Button> SectButtons=new List<Button>(); static List<Button> TalentButtons=new List<Button>(); static List<Button> BagRecycle=new List<Button>();
    static double LastTick=0;
    static Stopwatch Clock;
    // 删档确认弹窗（保留式 LayerState，静态构造一次保证 id 稳定）。
    // DeleteArmed=待删槽位，0 表示没有弹窗在等答案。
    static int DeleteArmed=0;
    static DialogHost Dialogs;
    static List<Button> SlotDelete=new List<Button>();
    static LayerState DeleteDialog=LayerState.Confirm("删除仙缘","将永久删除该仙缘的存档与备份，无法恢复。确定删除？",2);
    static void Heartbeat() {
        double now=Clock.ElapsedSeconds();
        if(!InMenu){Model.Tick(now-LastTick);}
        LastTick=now;Refresh();
    }
    // 删除确认弹窗的渲染与答案消费：由 DialogHost.OnPaint 在保留树的
    // 绘制阶段调用（每帧、事件仍为“当前事件”），点击与回车都能在同
    // 一帧被读取。action 1=删除，2/3=取消或关闭。心跳定时器不行：
    // PumpTasks 阶段事件已被清零，回车赶不上键盘门槛。
    static void PumpDeleteDialog() {
        if(DeleteArmed==0){return;}
        Layer.Render(Window.GetApp(),DeleteDialog);
        int a=DeleteDialog.action;
        if(a==0){return;}
        int slot=DeleteArmed;DeleteArmed=0;DeleteDialog.action=0;DeleteDialog.open=false;
        if(a==1){DeleteSlot(slot);}
        Window.GetApp().RequestRedraw();
    }
    static void DeleteSlot(int slot) {
        if(!InMenu || slot<1 || slot>5){return;}
        if(slot==ActiveSlot && !Profiles.Metadata(slot).Exists){return;}
        if(!Profiles.Delete(slot)){MenuStatus.Text=Profiles.Error();Refresh();return;}
        if(ActiveSlot==slot){SavePath="";}
        MenuStatus.Text="仙缘 "+Number(slot)+" 已删除，该槽位回到空白。";
        RefreshProfiles();Refresh();
    }
    static void AskDelete(int slot) {
        if(!InMenu || DeleteArmed!=0){return;}
        DeleteDialog.title="删除仙缘 "+Number(slot);
        DeleteDialog.okText="删除";
        DeleteDialog.cancelText="保留";
        DeleteArmed=slot;
        DeleteDialog.Open();
        Window.GetApp().RequestRedraw();
    }

    static void Size(Control c,int width,int height) { c.logW=width;c.logH=height;c.Prefer(width,height); }
    static Label Text(string value,string cls,int height) {
        Label l=new Label(value);l.Class=cls;Size(l,0,height);return l;
    }
    static Label Wrap(string value,string cls,int height) {
        Label l=Text(value,cls,height);l.wrap=true;return l;
    }
    static Label Spacer() { Label l=Text("","",0);l.Grow();return l; }
    // Panel.Row only honours Grow on the first child (and places it last), so
    // right-aligned rows use a Flex row with a "grow" spacer instead.
    static Label GrowSpace() { Label sp=Text("","",0);sp.Class="grow";return sp; }
    static Flex CardRow(int height) { Flex r=Flex.Row().AlignCenter();r.Class="card";Size(r,0,height);r.Gap(12);return r; }
    static Panel Column(string cls) { Panel p=Panel.Column();p.Class=cls;p.logGap=12;return p; }
    static Panel RowBox() { Panel p=Panel.Row();p.logGap=12;Size(p,0,36);return p; }
    static Flex CenterRow(Control c,int gap) {
        Flex r=Flex.Row().Center().AlignCenter();r.Gap(gap);r.With(c);return r;
    }
    static Flex MakePager(string prevName,string nextName,Label counter,Action prev,Action next) {
        // 一行 flex 的高度由内容测量兜底，但 ScrollColumn.Arrange 首帧只看
        // StyleHeight()/prefH——未测量完的 pager 高 0，整行被跳过（按钮
        // 注册了探针却点不到）。声明高度把它钉住，与按钮 40px 行档一致。
        Flex pager=Flex.Row().Center().AlignCenter();pager.Gap(12);Size(pager,0,44);
        pager.With(RowButton(prevName,"上一页",prev,"ghost",96));
        Size(counter,0,40);pager.With(counter);
        pager.With(RowButton(nextName,"下一页",next,"ghost",96));
        return pager;
    }
    static List<Button> ProbeButtons=new List<Button>();
    static Button ActionButton(string name,string label,Action action,string cls) {
        Button b=new Button(label);b.name=name;b.Class=cls+" medium";b.OnClick(action);ProbeButtons.Add(b);return b;
    }
    // List-row and page-level actions use the large tier (40px, large font) so
    // they read as clearly clickable instead of thin inline chips.
    static Button RowButton(string name,string label,Action action,string cls,int width) {
        Button b=ActionButton(name,label,action,cls);b.Class=cls+" large";Size(b,width,40);return b;
    }
    static void PublishProbes() {
        // Form.Run starts UiDriver after Build; construction-time probes are discarded.
        // Republish on refresh, including the menu heartbeat, before any page early return.
        if(!UiDriver.Active()){return;}
        UiDriver.SetProbe("ready",Ready?"1":"0");UiDriver.SetProbe("loadStep",Number(LoadStep));if(!Ready){return;}
        UiDriver.SetProbe("menuPage",Number(MenuPage));
        foreach(Button b in ProbeButtons){UiDriver.SetProbe("id."+b.name,Number(b.wid));}
        UiDriver.SetProbe("menu",InMenu?"1":"0");UiDriver.SetProbe("profile",Number(ActiveSlot));UiDriver.SetProbe("bagFilter",Number(BagFilter));UiDriver.SetProbe("prestigeArmed",PrestigeArmed?"1":"0");UiDriver.SetProbe("ascended",Model.Ascended?"1":"0");UiDriver.SetProbe("musicVolume",Number(Music.Volume()));UiDriver.SetProbe("page",Number(Page));UiDriver.SetProbe("section",Number(Section));UiDriver.SetProbe("activity",Number(Model.Activity));UiDriver.SetProbe("level",Number(Model.Level));UiDriver.SetProbe("stones",Number(Model.Stones));UiDriver.SetProbe("saveStatus",SaveStatus);
        UiDriver.SetProbe("recipeFilter",CraftFilter);UiDriver.SetProbe("recipePage",Number(RecipePage));UiDriver.SetProbe("recipePages",Number((RecipeCount()+2)/3));
        string slotSkills="";for(int s=0;s<3;s=s+1){int gi=RecipeRowAt(RecipePage*3+s);slotSkills=slotSkills+(gi>=0?Model.Data.Recipes[gi].Text("skill"):"-")+(s<2?" ":"");}
        UiDriver.SetProbe("recipeSkills",slotSkills);
        UiDriver.SetProbe("musicPlaying",Music.IsPlaying()?"1":"0");UiDriver.SetProbe("musicError",Music.Error());
        UiDriver.SetProbe("embeddedArt",File.EmbedExists("assets/images/main_menu_bg.webp")?"1":"0");UiDriver.SetProbe("embeddedMusic",File.EmbedExists("assets/audio/bgm_main.ogg")?"1":"0");UiDriver.SetProbe("embeddedBaseSkin",File.EmbedExists("skins/base.css")?"1":"0");
        UiDriver.SetProbe("menuArtLoaded",Canvas.ImageWidth(ArtPath("main_menu_bg.webp"))>0 && Canvas.ImageHeight(ArtPath("main_menu_bg.webp"))>0?"1":"0");
        UiDriver.SetProbe("autoHeal",Model.AutoHeal?"1":"0");UiDriver.SetProbe("musicAdjusted",Number(Model.Count(Model.RunState,"music_adjusted")));UiDriver.SetProbe("manualSaves",Number(Model.ManualSaves));
        UiDriver.SetProbe("deleteAsk",DeleteArmed>0?"1":"0");
    }
    static Dictionary<string,string> ArtCache=new Dictionary<string,string>();
    static string ToWebp(string file) {
        if(file.Length>4 && file.Substring(file.Length-4)==".png"){return file.Substring(0,file.Length-4)+".webp";}
        return file;
    }
    static string ArtPath(string file) {
        file=ToWebp(file);
        if(ArtCache.ContainsKey(file)){return ArtCache[file];}
        string source="assets/images/"+file;
        if(File.EmbedExists(source)){byte[] bytes=File.ReadAllBytes(source);string key="mem:wuwei:"+file;Canvas.ImageLoadMem(key,bytes,bytes.Length);ArtCache[file]=key;return key;}
        return Root+"/assets/images/"+file;
    }
    static Image Art(string file,int height) {
        Image i=new Image(ArtPath(file));i.Fit="cover";i.Alt="画卷未载入 · 请运行 prepare_assets.py";i.Class="art";Size(i,0,height);return i;
    }
    static string Number(double n) { return Convert.ToString((int)n); }
    static void SelectPage(int p) { PrestigeArmed=false;PrestigeButton.Text="转生 · 再续仙缘";Page=p;Refresh(); }
    static void SelectSection(int s) { Section=s;SelectPage(SectionDefault(s)); }
    static int SectionDefault(int s) { return s==0?0:s==1?4:s==2?7:s==3?8:s==4?10:s==5?13:14; }
    static void Result(bool ok) {Refresh();}
    static void SaveNow() { SaveGame(true); }
    static void SaveGame(bool manual) {
        if(InMenu){return;}
        if(SaveBlocked){SaveStatus="存档已保护，禁止覆盖。请切换空白仙缘。";}
        else {
            if(manual){Model.ManualSaves=Model.ManualSaves+1;}
            Model.SavedUnixSeconds=DateTime.UtcNow().ToUnixSeconds();
            if(Profiles.Write(ActiveSlot,Model.Serialize(),JourneyName,Model.RealmName()+" "+Number(Model.Layer())+"层")){SaveStatus="仙缘 "+Number(ActiveSlot)+" · 保存成功";}
            else {if(manual){Model.ManualSaves=Model.ManualSaves-1;}SaveStatus=Profiles.Error();}
        }
        if(manual){Model.Say(SaveStatus,!SaveBlocked);}Refresh();
    }
    static void LoadSave() { Profiles=new ProfileStore();Music=new AudioService();Music.Start(Root+"/assets/audio/bgm_main.ogg");string settings=Profiles.SettingsRead();if(settings!=""){List<string> bits=settings.Split(",");if(bits.Count==2){try{int volume=Convert.ToInt32(bits[0]);if(volume>=0 && volume<=100){Music.SetVolume(volume);}Music.SetMuted(bits[1]=="1");}catch(Exception e){SaveStatus="音量设置无效，使用默认值";}}} }
    static void OpenSlot(int slot,bool onlyNew) {
        ProfileInfo info=Profiles.Metadata(slot);
        if(onlyNew && (info.Exists || info.Error!="")){MenuStatus.Text="此仙缘已有存档或读取失败，绝不覆盖。请选择空白仙缘。";return;}
        string payload=Profiles.Read(slot);
        if(Profiles.Error()!=""){MenuStatus.Text=Profiles.Error();return;}
        Wuwei.Game candidate=new Wuwei.Game();candidate.Init(Root+"/data");
        if(payload!="" && !candidate.LoadState(payload)){MenuStatus.Text="此仙缘存档无效，原文件已保护。请选择其他仙缘。";return;}
        if(!InMenu){SaveGame(false);if(Profiles.Error()!=""){MenuStatus.Text="原仙缘保存失败，已取消切换。";return;}}
        long now=DateTime.UtcNow().ToUnixSeconds();if(payload!="" && candidate.SavedUnixSeconds>0 && now>candidate.SavedUnixSeconds){candidate.SimulateOffline((double)(now-candidate.SavedUnixSeconds));}
        Model=candidate;ActiveSlot=slot;JourneyName=info.Name==""?"仙缘 "+Number(slot):info.Name;ProfileName.SetText(JourneyName);SaveBlocked=false;SaveStatus=payload==""?"新仙缘已开启 · 每30秒自动保存":"仙缘载入成功 · 离线收益已结算";
        SavePath=Profiles.SlotPath(slot);InMenu=false;BagPage=0;BagFilter=0;Section=0;MapPage=0;MapDPage=0;MapEPage=0;RecipePage=0;CraftFilter="fishing";SelectPage(0);
    }
    static void NewJourney() { for(int i=1;i<=5;i=i+1){ProfileInfo info=Profiles.Metadata(i);if(!info.Exists && info.Error==""){OpenSlot(i,true);return;}}MenuStatus.Text="五段仙缘均有存档；请继续已有仙缘。新游戏不会删除任何存档。"; }
    static void ShowMenu() {SaveGame(false);if(Profiles.Error()!=""){return;}InMenu=true;MenuPage=0;PrestigeArmed=false;PrestigeButton.Text="转生 · 再续仙缘";RefreshProfiles();Refresh();}
    static void RefreshProfiles() {for(int i=0;i<5;i=i+1){ProfileInfo info=Profiles.Metadata(i+1);string title=info.Exists&&info.Name!=""&&info.Name!="仙缘 "+Number(i+1)?info.Name+"  ·  ":"";ProfileLabels[i].Text="仙缘 "+Number(i+1)+(title!=""?"  ·  "+info.Name:"")+"  ·  "+(info.Exists?info.Summary:"空白 · 开启新旅程")+(info.Error!=""?" · 已保护":"");if(i>0 && i-1<SlotDelete.Count){SlotDelete[i-1].visible=info.Exists;}}}
    static void SaveMusic() {if(!InMenu){Model.SetMusicAdjusted();}if(!Profiles.SettingsWrite(Number(Music.Volume())+","+(Music.Muted()?"1":"0"))){Model.Say(Profiles.Error(),false);}Refresh();}
    static void ChangeVolume(int delta) {Music.SetVolume(Music.Volume()+delta);SaveMusic();}
    static void Place(Control c,int x,int y,int w,int h) {Size(c,w,h);c.DockManual();c.logPlaceSet=true;c.logX=x;c.logY=y;}
    static void OpenMenuPage(int page) {MenuPage=page;RefreshProfiles();Refresh();}
    static ScrollColumn MenuPanel(string name,string title) {
        ScrollColumn p=new ScrollColumn();p.name=name;p.Class="menu-panel";p.logGap=12;Place(p,340,70,640,700);Menu.With(p);
        Panel heading=RowBox();Size(heading,0,44);heading.With(Text(title,"title",36).Grow());heading.With(RowButton(name+"Back","返回菜单",()=>{OpenMenuPage(0);},"secondary",150));p.With(heading);return p;
    }
    static void BuildMenu() {
        Menu=Panel.Root("menu");Menu.Class="menu";Menu.DockFill();Window.With(Menu);
        Image background=Art("main_menu_bg.webp",800);background.name="menuBackground";background.Class="menu-background";background.Fit="cover";background.DockFill();Menu.With(background);
        Landing=Panel.Root("landing");Landing.DockFill();Menu.With(Landing);
        Image title=Art("title_calligraphy.webp",255);title.name="menuTitle";title.Class="menu-title";title.Fit="contain";Place(title,92,78,600,255);Landing.With(title);
        Panel buttons=Column("menu-buttons");Place(buttons,92,381,300,276);Landing.With(buttons);
        Button start=ActionButton("menuStart","开始游戏",()=>{OpenMenuPage(1);},"menu-action");Size(start,300,60);buttons.With(start);
        Button settings=ActionButton("menuSettings","游戏设置",()=>{OpenMenuPage(2);},"menu-action");Size(settings,300,60);buttons.With(settings);
        Button achievements=ActionButton("menuAchievements","游戏成就",()=>{OpenMenuPage(3);},"menu-action");Size(achievements,300,60);buttons.With(achievements);
        Button exit=ActionButton("menuExit","退出游戏",()=>{Window.GetApp().isRunning=false;},"menu-action");Size(exit,300,60);buttons.With(exit);
        Label version=Text("无为修仙传  v1.0 · Zan 原生版","kicker",24);Place(version,40,716,480,24);Landing.With(version);
        Slots=MenuPanel("slots","选择仙缘");Slots.With(Wrap("五段仙缘，各自珍藏。新旅程只使用空白槽位，绝不覆盖旧存档。","muted",48));
        Panel actions=RowBox();Size(actions,0,44);actions.With(RowButton("menuContinue","继续仙缘",()=>{OpenSlot(ActiveSlot,false);},"primary",180));actions.With(RowButton("menuNew","开启新仙途",()=>{NewJourney();},"secondary",180));Slots.With(actions);
        for(int i=1;i<=5;i=i+1){int slot=i;Flex row=CardRow(76);Label summary=Text("","section",36);ProfileLabels.Add(summary);row.With(summary);row.With(GrowSpace());if(slot>1){SlotDelete.Add(RowButton("profileDelete"+Number(slot),"删除",()=>{AskDelete(slot);},"ghost",88));row.With(SlotDelete[SlotDelete.Count-1]);}row.With(RowButton("profile"+Number(i),"进入仙缘",()=>{OpenSlot(slot,false);},"secondary",150));Slots.With(row);}
        MenuStatus=Wrap("选择一段仙缘，即可启程。","notice",44);Slots.With(MenuStatus);
        MenuSettings=MenuPanel("menuAudio","游戏设置");MenuSettings.With(Text("山中清音","section",36));MenuMusicStatus=Wrap("","jade",72);MenuSettings.With(MenuMusicStatus);
        Panel audio=RowBox();Size(audio,0,44);audio.With(RowButton("menuVolumeDown","音量 −10",()=>{ChangeVolume(-10);},"secondary",120));audio.With(RowButton("menuMute","静音 / 恢复",()=>{Music.SetMuted(!Music.Muted());SaveMusic();},"secondary",150));audio.With(RowButton("menuVolumeUp","音量 +10",()=>{ChangeVolume(10);},"secondary",120));MenuSettings.With(audio);MenuSettings.With(Wrap("音乐设置独立保存。返回菜单不会创建或改写任何仙缘存档。","muted",72));
        MenuAchievements=MenuPanel("menuAwards","游戏成就");MenuAchievements.With(Wrap("当前仙缘的修行足迹 · 尚未开始时展示成就目标，不创建存档。","muted",48));
        for(int i=0;i<Model.AchievementCount();i=i+1){Label label=Wrap("","muted",80);MenuAchievementLabels.Add(label);MenuAchievements.With(label);}
        MenuAwardCounter=Text("","muted",32);
        MenuAchievements.With(MakePager("menuAwardsPrev","menuAwardsNext",MenuAwardCounter,()=>{if(MenuAwardPage>0){MenuAwardPage=MenuAwardPage-1;}Refresh();},()=>{if((MenuAwardPage+1)*AchPerPage()<Model.AchievementCount()){MenuAwardPage=MenuAwardPage+1;}Refresh();}));
        // 弹窗宿主排最后：绘制顺序在全部菜单内容之上，DockFill 全窗。
        Dialogs=new DialogHost();Dialogs.name="dialogHost";DialogHost.Pump=PumpDeleteDialog;Dialogs.DockFill();Menu.With(Dialogs);
        RefreshProfiles();
    }
    static int AchPerPage() { return 4; }
    static void ClampAchPages() {
        int count=Model.AchievementCount();
        if(MenuAwardPage*AchPerPage()>=count){MenuAwardPage=count>0?(count-1)/AchPerPage():0;}
        if(AchPage*AchPerPage()>=count){AchPage=count>0?(count-1)/AchPerPage():0;}
    }
    static string MapKey(int mode) { return mode==0?"wild":(mode==1?"danger":"extreme"); }
    static int MapCount(int mode) { int n=0;for(int i=0;i<Model.Data.Maps.Count;i=i+1){if(Model.Data.Maps[i].Text("mode")==MapKey(mode)){n=n+1;}}return n; }
    static int MapRowAt(int mode,int index) { int n=0;for(int i=0;i<Model.Data.Maps.Count;i=i+1){if(Model.Data.Maps[i].Text("mode")==MapKey(mode)){if(n==index){return i;}n=n+1;}}return 0-1; }
    static int RecipeCount() { int n=0;for(int i=0;i<Model.Data.Recipes.Count;i=i+1){if(Model.Data.Recipes[i].Text("skill")==CraftFilter){n=n+1;}}return n; }
    static int RecipeRowAt(int index) { int n=0;for(int i=0;i<Model.Data.Recipes.Count;i=i+1){if(Model.Data.Recipes[i].Text("skill")==CraftFilter){if(n==index){return i;}n=n+1;}}return 0-1; }
    static int ClampPage(int page,int count) { if(count<=0){return 0;}if(page*3>=count){return (count-1)/3;}return page; }
    static void CraftCategory(string skill) { CraftFilter=skill;RecipePage=0;Refresh(); }
    static string CraftLabel(string key) { List<string> keys=new List<string>();keys.Add("fishing");keys.Add("herbalism");keys.Add("mining");keys.Add("brewing");keys.Add("forging");keys.Add("alchemy");keys.Add("talismans");keys.Add("formations");List<string> names=new List<string>();names.Add("垂钓");names.Add("采药");names.Add("采矿");names.Add("酿造");names.Add("炼器");names.Add("炼丹");names.Add("符箓");names.Add("阵法");for(int i=0;i<keys.Count;i=i+1){if(keys[i]==key){return names[i];}}return key; }
    static void MapAction(int mode,int slot) {
        int page=MapPage;if(mode==1){page=MapDPage;}if(mode==2){page=MapEPage;}
        int gi=MapRowAt(mode,page*3+slot);if(gi>=0){Result(Model.StartBattle(gi));}
    }
    static void SkillAction(int slot) { Result(Model.UpgradeSkill(SkillPage*3+slot)); }
    static void RecipeAction(int slot) { int gi=RecipeRowAt(RecipePage*3+slot);if(gi>=0){Result(Model.StartCraft(gi));} }
    static void UseAction(int slot) { if (slot<BagIds.Count) { if (!Model.UseItem(BagIds[slot])) { Model.Say("此物暂不可使用：请检查境界、气血或配方材料",false); }Refresh(); } }
    static void SellAction(int slot) { if (slot<BagIds.Count) { Result(Model.Sell(BagIds[slot],1)); } }
    static void BuyAction(int slot) { Result(Model.Buy(MarketPage*3+slot)); }
    static void Rebirth() {
        if (!PrestigeArmed) { PrestigeArmed=true;PrestigeButton.Text="确认转生 · 重置本世进度";Model.Say("再次点击确认：本世修为与物品重置，天赋及因果保留",true); }
        else { Model.Prestige();PrestigeArmed=false;PrestigeButton.Text="转生 · 再续仙缘"; }
        Refresh();
    }
    static ScrollColumn NewPage() { ScrollColumn p=new ScrollColumn();p.name="pageScroll"+Number(Pages.Count);p.logGap=12;p.DockFill();Pages.Add(p);return p; }
    static void PageHead(ScrollColumn p,string title,string subtitle) {
        // 页名在子导航选项卡上已有，页面里只留一行副标题交代玩法，
        // 不再重复一张 40px 大标题（用户明确要求）。
        p.With(Text(subtitle,"page-sub",24));
    }
    static void BuildCultivate() {
        ScrollColumn p=NewPage();PageHead(p,"闭关","闭关会消耗修为经验并转化为闭关进度；只有闭关进度圆满才能提升层数。");
        // 左对齐信息列 + 右侧立绘锚点：文本、进度条、按钮共用一条左缘。
        Flex head=Flex.Row().AlignStart();head.Gap(16);Size(head,0,132);
        Panel info=Column("");info.logGap=8;info.Grow();
        ActivityText=Text("","kicker",22);info.With(ActivityText);
        QiText=Text("","jade",32);info.With(QiText);
        QiRateText=Text("","muted",22);info.With(QiRateText);
        head.With(info);
        Image icon=Art("icon_mind_skill.webp",120);icon.Fit="contain";icon.Class="card-art";Size(icon,120,120);head.With(icon);
        // 主卡按一屏预算定高(视口 633 逻辑高，副标题 22 + 行距 12)：
        // 卡撑满剩余 599，卡内 Spacer 把按钮行压到卡底。
        Panel card=Column("card");Size(card,0,597);card.With(head);
        QiBar=new Progress(0,1);QiBar.ShowText(false);Size(QiBar,0,24);card.With(QiBar);
        card.With(Spacer());
        Flex act=Flex.Row().AlignCenter();act.Gap(12);Size(act,0,40);
        RestBtn=RowButton("rest","出关休息",()=>{Model.StopActivity();Model.Say("已出关，静养气血",true);Refresh();},"secondary",150);act.With(RestBtn);
        act.With(GrowSpace());
        CulBtn=RowButton("cultivate","开始闭关",()=>{Result(Model.StartCultivation());},"primary",220);act.With(CulBtn);
        card.With(act);
        p.With(card);
    }
    static void BuildSkills() {
        ScrollColumn p=NewPage();PageHead(p,"功法","参悟消耗修为经验并需要一定时间；功法提升后永久生效。");
        Grid g=Grid.Of(3);g.logGap=12;
        for(int s=0;s<3;s=s+1){int slot=s;Panel card=Column("card");Size(card,0,540);Label title=Text("","section",28);SkillNames.Add(title);card.With(title);Image art=Art("icon_manual.webp",110);art.Fit="contain";art.Class="card-art";SkillImages.Add(art);Flex iw=CenterRow(art,0);Size(iw,0,110);card.With(iw);card.With(Spacer());Label detail=Wrap("","muted",96);SkillDescs.Add(detail);card.With(detail);SkillButtons.Add(RowButton("skill"+Number(s),"参悟",()=>{SkillAction(slot);},"secondary",0));card.With(SkillButtons[s]);g.With(card);}
        p.With(g);
        SkillCounter=Text("","muted",32);
        p.With(MakePager("skillsPrev","skillsNext",SkillCounter,()=>{if(SkillPage>0){SkillPage=SkillPage-1;}Refresh();},()=>{if((SkillPage+1)*3<Model.Data.Skills.Count){SkillPage=SkillPage+1;}Refresh();}));
    }
    static void BuildBreakthrough() {
        ScrollColumn p=NewPage();PageHead(p,"破境","本境十二层且闭关进度圆满后，服用对应破境丹突破。");
        Panel card=Column("card");Size(card,0,597);p.With(card);
        Image icon=Art("alchemy_breakthrough_pill.webp",110);icon.Fit="contain";icon.Class="card-art";Size(icon,110,110);card.With(CenterRow(icon,12));
        card.With(Spacer());
        BreakInfo=Text("","jade",28);card.With(CenterRow(BreakInfo,12));
        card.With(CenterRow(Text("每层突破消耗一枚对应破境丹，闭关进度圆满后方可尝试。","muted",24),12));
        BreakBtn=RowButton("breakthrough","尝试破境",()=>{Result(Model.Breakthrough());},"primary",220);card.With(CenterRow(BreakBtn,12));
    }
    static void BuildQuests() {
        ScrollColumn p=NewPage();PageHead(p,"主线任务","神秘老人的传音将引导你熟悉修行、历练、杂学与万宝。");
        QuestTitle=Wrap("","gold",56);p.With(QuestTitle);
        Panel speech=Column("card");Size(speech,0,519);p.With(speech);
        QuestBody=Wrap("","",80);speech.With(QuestBody);
        QuestBar=new Progress(0,1);QuestBar.ShowText(false);Size(QuestBar,0,16);speech.With(QuestBar);
        speech.With(Spacer());
        QuestReward=Wrap("","kicker",44);speech.With(QuestReward);
        Claim=RowButton("questClaim","领取仙缘",()=>{Result(Model.ClaimQuest());},"primary",180);speech.With(Claim);
    }
    static void FillRegionCards(Grid g,List<Image> imgs,List<Label> names,List<Label> details,List<Button> btns,int mode,string pfx) {
        // Explicit card/flex heights: text and art measure taller than their
        // Size() hints, and a Grid cell clamps to the card's measurement —
        // without headroom the bottom button gets squeezed flat.
        for(int s=0;s<3;s=s+1){int slot=s;Panel c=Column("card");Size(c,0,FillRegionCardH());Image art=Art("qingzhu_ridge.webp",120);art.Fit="cover";art.Class="card-art";imgs.Add(art);Flex iw=CenterRow(art,0);Size(iw,0,120);c.With(iw);Label name=Text("","section",28);names.Add(name);c.With(name);c.With(Spacer());Label detail=Wrap("","muted",124);details.Add(detail);c.With(detail);Button b=RowButton(pfx+Number(s),"前往历练",()=>{MapAction(mode,slot);},"secondary",0);btns.Add(b);c.With(b);g.With(c);}
    }
    // 野外页还要放战斗面板(190)，卡片 341；险地/绝境只有一张网格，
    // 卡片撑满一屏剩余的 543。卡内 Spacer 把详情压向卡底按钮上方。
    static int FillRegionCardH() { return Mode==0?339:540; }
    static int Mode=0;
    static void BuildRegions() {
        ScrollColumn wild=NewPage();PageHead(wild,"野外","选择一处地域，角色将持续战斗并带回装备与材料。");
        Mode=0;Grid g=Grid.Of(3);g.logGap=12;FillRegionCards(g,MapImages,MapNames,MapDetails,MapButtons,0,"map");wild.With(g);
        MapCounter=Text("","muted",32);
        wild.With(MakePager("mapsPrev","mapsNext",MapCounter,()=>{if(MapPage>0){MapPage=MapPage-1;}Refresh();},()=>{if((MapPage+1)*3<MapCount(0)){MapPage=MapPage+1;}Refresh();}));
        Panel battle=Column("card");Size(battle,0,190);battle.With(CombatText=Text("","section",28));
        battle.With(Text("自身气血","kicker",22));HpBar=new Progress(100,1);HpBar.ShowText(false);Size(HpBar,0,16);battle.With(HpBar);
        battle.With(Text("敌人气血","kicker",22));WorkBar=new Progress(0,1);WorkBar.ShowText(false);Size(WorkBar,0,16);battle.With(WorkBar);
        BattleStopBtn=RowButton("battleStop","收剑归山",()=>{Model.StopActivity();Model.Say("已离开战场，静养气血",true);Refresh();},"secondary",160);battle.With(CenterRow(BattleStopBtn,12));wild.With(battle);
        ScrollColumn danger=NewPage();PageHead(danger,"险地","点击地区查看盘踞的强敌，胜后带回更好的装备。");
        Mode=1;Grid gd=Grid.Of(3);gd.logGap=12;FillRegionCards(gd,MapDImages,MapDNames,MapDDetails,MapDButtons,1,"mapd");danger.With(gd);
        MapDCounter=Text("","muted",32);
        danger.With(MakePager("mapdPrev","mapdNext",MapDCounter,()=>{if(MapDPage>0){MapDPage=MapDPage-1;}Refresh();},()=>{if((MapDPage+1)*3<MapCount(1)){MapDPage=MapDPage+1;}Refresh();}));
        ScrollColumn extreme=NewPage();PageHead(extreme,"绝境","每次挑战包含九波连战：前八波为野外与险地强敌，第九波为镇守 Boss。");
        Mode=2;Grid ge=Grid.Of(3);ge.logGap=12;FillRegionCards(ge,MapEImages,MapENames,MapEDetails,MapEButtons,2,"mape");extreme.With(ge);
        MapECounter=Text("","muted",32);
        extreme.With(MakePager("mapePrev","mapeNext",MapECounter,()=>{if(MapEPage>0){MapEPage=MapEPage-1;}Refresh();},()=>{if((MapEPage+1)*3<MapCount(2)){MapEPage=MapEPage+1;}Refresh();}));
    }
    static void BuildCraft() {
        ScrollColumn p=NewPage();PageHead(p,"杂学","垂钓、采药、采矿取得灵材；丹器符阵皆可反哺修行。");
        CraftText=Wrap("","jade",28);p.With(CraftText);
        CraftBar=new Progress(0,1);CraftBar.ShowText(false);Size(CraftBar,0,12);p.With(CraftBar);
        Grid g=Grid.Of(3);g.logGap=12;
        for(int s=0;s<3;s=s+1){int slot=s;Panel c=Column("card");Size(c,0,415);Image image=Art("herb_dew_grass.webp",100);image.Fit="contain";image.Class="card-art";RecipeImages.Add(image);Flex iw=CenterRow(image,0);Size(iw,0,100);c.With(iw);Label name=Text("","section",28);RecipeNames.Add(name);c.With(CenterRow(name,0));c.With(Spacer());Label detail=Wrap("","muted",56);RecipeDetails.Add(detail);c.With(detail);RecipeButtons.Add(RowButton("recipe"+Number(s),"开始制作",()=>{RecipeAction(slot);},"secondary",150));c.With(CenterRow(RecipeButtons[s],0));g.With(c);}
        p.With(g);
        RecipeCounter=Text("","muted",32);
        p.With(MakePager("recipesPrev","recipesNext",RecipeCounter,()=>{if(RecipePage>0){RecipePage=RecipePage-1;}Refresh();},()=>{if((RecipePage+1)*3<RecipeCount()){RecipePage=RecipePage+1;}Refresh();}));
        CraftStopBtn=RowButton("craftStop","停止百艺",()=>{Model.StopActivity();Model.Say("已停下手中事务",true);Refresh();},"secondary",160);p.With(CenterRow(CraftStopBtn,12));
    }
    static void FilterBag(int filter) {BagFilter=filter;BagPage=0;Refresh();}
    static bool BagMatches(Row r) {if(r==null){return BagFilter==0;}string t=r.Text("type");return BagFilter==0 || (BagFilter==1 && t=="equipment") || (BagFilter==2 && (t=="alchemy" || t=="pill" || t=="consumable" || t=="breakthrough")) || (BagFilter==3 && (t=="resource" || t=="material")) || (BagFilter==4 && t!="equipment" && t!="alchemy" && t!="pill" && t!="consumable" && t!="breakthrough" && t!="resource" && t!="material");}
    static string ItemName(string id) {return Model.ItemName(id);}
    static string Delta(double n) {return (n>=0?"+":"")+Number(n);}
    static string ItemDetail(string id) {
        Row r=Model.ItemRow(id);
        if(r==null){return "";}string result=r.Text("desc");
        if(r.Text("slot")!="") {Row old=null;string slot=r.Text("slot");if(Model.Equipment.ContainsKey(slot)){old=Model.ItemRow(Model.Equipment[slot]);}
            result=result+"\n攻击 "+Number(Model.GearStat(id,"atk"))+"  防御 "+Number(Model.GearStat(id,"def"))+"  气血 "+Number(Model.GearStat(id,"hp"));
            result=result+"\n对比"+(old==null?"空栏":old.Name)+"：攻 "+Delta(Model.GearStat(id,"atk")-(old==null?0:Model.GearStat(Model.Equipment[slot],"atk")))+" / 防 "+Delta(Model.GearStat(id,"def")-(old==null?0:Model.GearStat(Model.Equipment[slot],"def")))+" / 血 "+Delta(Model.GearStat(id,"hp")-(old==null?0:Model.GearStat(Model.Equipment[slot],"hp")));}
        return result+"\n境界需求 "+r.Text("req")+"层 · 售价 "+Number(Wuwei.Game.Max(1,r.Num("price")*0.35))+" 灵石";
    }
    static void BuildInventory() {
        ScrollColumn p=NewPage();PageHead(p,"行囊","鼠标悬停查看详情；装备后提升攻防气血。");
        GearText=Wrap("","jade",32);p.With(GearText);
        Panel filters=RowBox();Size(filters,0,44);List<string> names=new List<string>();names.Add("全部");names.Add("装备");names.Add("丹药");names.Add("灵材");names.Add("符阵 / 其他");for(int i=0;i<5;i=i+1){int f=i;Button fb=RowButton("bagFilter"+Number(i),names[i],()=>{FilterBag(f);},"ghost",0);filters.With(fb);}p.With(filters);
        GearSlots.Add("weapon");GearSlots.Add("head");GearSlots.Add("robe");GearSlots.Add("boots");GearSlots.Add("bracers");GearSlots.Add("amulet");GearSlots.Add("ring");
        // 七栏装备位两列栅格收纳：单列七行会把页高顶出视口，两列
        // 四行省回一屏高度，行内容不变。
        Grid gearGrid=Grid.Of(2);gearGrid.logGap=10;
        for(int i=0;i<GearSlots.Count;i=i+1){string slot=GearSlots[i];Flex row=CardRow(44);Label label=Text("","muted",24);EquippedLabels.Add(label);row.With(label);row.With(GrowSpace());UnequipButtons.Add(RowButton("unequip"+Number(i),"卸下",()=>{if(!Model.Unequip(slot)){Model.Say("行囊已满或此栏未装备，无法卸下",false);}Refresh();},"ghost",112));row.With(UnequipButtons[i]);gearGrid.With(row);}
        p.With(gearGrid);
        // 物品卡三张并排（Grid.Of(3)）：竖排三张必超一屏；卡高 196
        // 让装备栏、物品行与分页器一起恰好收进一屏，滚动条消失。
        Grid bagGrid=Grid.Of(3);bagGrid.logGap=12;
        for(int s=0;s<3;s=s+1){int slot=s;Panel card=Column("card");Size(card,0,196);Panel row=Panel.Row();row.logGap=12;Image art=Art("alchemy_heal_pill.webp",90);Size(art,90,104);BagImages.Add(art);art.Fit="contain";art.Class="card-art";row.With(art);Panel detail=Column("");detail.Grow();Label name=Text("","section",24);BagNames.Add(name);detail.With(name);Label description=Wrap("","muted",60);BagDetails.Add(description);detail.With(description);row.With(detail);card.With(row);Panel actions=RowBox();Size(actions,0,44);BagUse.Add(RowButton("itemUse"+Number(s),"使用 / 装备",()=>{UseAction(slot);},"secondary",160));actions.With(BagUse[s]);BagSell.Add(RowButton("itemSell"+Number(s),"售出一件",()=>{SellAction(slot);},"ghost",132));actions.With(BagSell[s]);BagRecycle.Add(RowButton("recycle"+Number(s),"分解装备",()=>{if(slot<BagIds.Count){if(!Model.RecycleGear(BagIds[slot])){Model.Say("仅可分解行囊中的装备",false);}Refresh();}},"ghost",132));actions.With(BagRecycle[s]);card.With(actions);bagGrid.With(card);}
        p.With(bagGrid);
        BagCounter=Text("","muted",32);
        p.With(MakePager("bagPrev","bagNext",BagCounter,()=>{if(BagPage>0){BagPage=BagPage-1;}Refresh();},()=>{if((BagPage+1)*3<BagTotal){BagPage=BagPage+1;}Refresh();}));
    }
    static void BuildMarket() {
        ScrollColumn p=NewPage();PageHead(p,"坊市","坊市每隔一段时间换一批货品，购入修行所需。");
        for(int s=0;s<3;s=s+1){int slot=s;Flex row=CardRow(172);Label name=Wrap("","",28);MarketNames.Add(name);row.With(name);row.With(GrowSpace());MarketBuy.Add(RowButton("buy"+Number(s),"购买",()=>{BuyAction(slot);},"secondary",124));row.With(MarketBuy[s]);p.With(row);}
        MarketCounter=Text("","muted",32);
        p.With(MakePager("marketPrev","marketNext",MarketCounter,()=>{if(MarketPage>0){MarketPage=MarketPage-1;}Refresh();},()=>{if((MarketPage+1)*3<Model.Data.Market.Count){MarketPage=MarketPage+1;}Refresh();}));
    }
    static int MaxSectRows(List<Row> rows) {int maximum=0;foreach(Row sect in Model.Data.Sects){int count=0;foreach(Row row in rows){if(row.Text("sect")==sect.Id){count=count+1;}}if(count>maximum){maximum=count;}}return maximum;}
    static void BuildSect() {
        ScrollColumn affairs=NewPage();PageHead(affairs,"宗门事务","承接宗门差遣，完成后获得贡献点。");
        SectText=Wrap("","muted",48);affairs.With(SectText);
        for(int s=0;s<Model.Data.Sects.Count;s=s+1){int index=s;Row r=Model.Data.Sects[s];Flex row=CardRow(60);row.With(Text(r.Name,"section",32));row.With(GrowSpace());SectButtons.Add(RowButton("sect"+Number(s),"拜入宗门",()=>{Result(Model.JoinSect(index));},"secondary",156));row.With(SectButtons[s]);affairs.With(row);}
        SectTrainBtn=RowButton("sectTrain","研习宗门心法 · 520 贡献",()=>{if(!Model.TrainSect()){Model.Say("请先加入宗门，并积累520贡献",false);}Refresh();},"secondary",280);affairs.With(SectTrainBtn);
        affairs.With(Text("宗门委托 · 达标后领取，可重复完成","section",32));
        // 六条委托两列栅格三行收纳，行高随剩余屏高定，行内容不变。
        Grid taskGrid=Grid.Of(2);taskGrid.logGap=10;
        for(int s=0;s<Model.Data.SectTasks.Count;s=s+1){int index=s;Flex row=CardRow(84);Label detail=Wrap("","muted",48);TaskLabels.Add(detail);row.With(detail);row.With(GrowSpace());TaskButtons.Add(RowButton("sectTask"+Number(s),"领取贡献",()=>{Result(Model.ClaimSectTask(index));},"secondary",140));row.With(TaskButtons[s]);taskGrid.With(row);}
        affairs.With(taskGrid);
        ScrollColumn vault=NewPage();PageHead(vault,"宗门宝库","以贡献兑换当前宗门的专属装备、功法与丹药。");
        // 宝库只有三行：行高撑到一屏剩余高度，兑换行不再挤在页面上沿。
        for(int i=0;i<MaxSectRows(Model.Data.SectVault);i=i+1){int index=i;Flex row=CardRow(190);Label label=Wrap("","muted",48);VaultLabels.Add(label);row.With(label);row.With(GrowSpace());VaultButtons.Add(RowButton("vault"+Number(i),"兑换",()=>{Result(Model.ExchangeSectVault(index));},"secondary",124));row.With(VaultButtons[i]);vault.With(row);}
        ScrollColumn arena=NewPage();PageHead(arena,"宗门擂台","擂台定期开放五分钟，可挑战宗门内各级高手。");
        ArenaStatus=Wrap("","jade",60);arena.With(ArenaStatus);
        // 六名对手分两列栅格，行高撑满一屏剩余空间。
        Grid arenaGrid=Grid.Of(2);arenaGrid.logGap=10;
        for(int i=0;i<MaxSectRows(Model.Data.Arena);i=i+1){int index=i;Flex row=CardRow(160);Label label=Wrap("","muted",48);ArenaLabels.Add(label);row.With(label);row.With(GrowSpace());ArenaButtons.Add(RowButton("arena"+Number(i),"挑战",()=>{Result(Model.ArenaFightOpponent(index));},"secondary",124));row.With(ArenaButtons[i]);arenaGrid.With(row);}
        arena.With(arenaGrid);
    }
    static void BuildPrestige() {
        ScrollColumn p=NewPage();PageHead(p,"轮回","寿元已尽或飞升之后，可携因果与永久天赋再续一世。");
        EndingText=Wrap("","jade",100);p.With(EndingText);KarmaText=Text("","jade",32);p.With(KarmaText);p.With(Wrap("转生会重置本世境界、物品与宗门。因果和永久天赋保留，下一世走得更远。此操作需再次确认。","muted",52));
        for(int s=0;s<Model.Data.Talents.Count;s=s+1){int index=s;Flex row=CardRow(70);Label talent=Wrap("","section",32);TalentLabels.Add(talent);row.With(talent);row.With(GrowSpace());TalentButtons.Add(RowButton("talent"+Number(s),"以因果升华",()=>{Result(Model.UpgradeTalent(index));},"secondary",156));row.With(TalentButtons[s]);p.With(row);}
        PrestigeButton=RowButton("prestige","转生 · 再续仙缘",()=>{Rebirth();},"secondary",220);p.With(PrestigeButton);
    }
    static void BuildSettings() {
        ScrollColumn p=NewPage();PageHead(p,"系统 · 守护这段仙缘","本地存档 · 自动保存 · 离线收益");
        Flex rename=Flex.Row().AlignCenter();rename.Gap(12);Size(rename,0,44);ProfileName=new Input();ProfileName.name="profileName";ProfileName.Class="grow";rename.With(ProfileName);rename.With(RowButton("renameProfile","保存仙缘名",()=>{string name=ProfileName.GetText();if(name.Length>0 && name.Length<=40){JourneyName=name;SaveNow();}else{Model.Say("仙缘名请输入1至40个字符",false);Refresh();}},"secondary",150));p.With(rename);
        Panel card=Column("card");Size(card,0,215);SaveText=Wrap(SaveStatus,"notice",64);card.With(SaveText);card.With(RowButton("save","立即保存",()=>{SaveNow();},"primary",160));card.With(Spacer());card.With(Wrap("每30秒自动保存。离开游戏前可手动保存；离线最多结算八小时，沿用离开时的活动。","muted",64));p.With(card);
        HealSetting=RowButton("autoHeal","自动服药：开启",()=>{Model.AutoHeal=!Model.AutoHeal;Refresh();},"secondary",200);p.With(HealSetting);
        p.With(Wrap("气血低于35%时自动使用行囊中的回春丹。关闭后需在行囊页手动服药。","muted",48));
        MusicStatus=Text("","jade",32);p.With(MusicStatus);Panel audio=RowBox();Size(audio,0,44);audio.With(RowButton("volumeDown","音量 −10",()=>{ChangeVolume(-10);},"secondary",120));audio.With(RowButton("musicMute","静音 / 恢复",()=>{Music.SetMuted(!Music.Muted());SaveMusic();},"secondary",120));audio.With(RowButton("volumeUp","音量 +10",()=>{ChangeVolume(10);},"secondary",120));p.With(audio);
        p.With(RowButton("profiles","管理五段仙缘",()=>{ShowMenu();},"secondary",180));
        p.With(Wrap("无为修仙 · 原生 Zan Gui。慢慢来，山中岁月长。所有修为、物品与任务都在本机运行，无需联网。","muted",48));
    }
    static void BuildCodex() {
        ScrollColumn p=NewPage();PageHead(p,"山海图鉴 · 留下每一步","历练胜绩与万物收集 · 每一份努力都有回响");
        // 成就 4/页、图录 6/卷各自分页；条目两列栅格收纳，页高恰好一屏。
        p.With(Text("仙途成就","section",28));
        Grid ag=Grid.Of(2);ag.logGap=12;
        for(int i=0;i<Model.AchievementCount();i=i+1){Label achievement=Wrap("","muted",66);AchievementLabels.Add(achievement);ag.With(achievement);}
        p.With(ag);
        AchCounter=Text("","muted",32);
        p.With(MakePager("achPrev","achNext",AchCounter,()=>{if(AchPage>0){AchPage=AchPage-1;}Refresh();},()=>{if((AchPage+1)*AchPerPage()<Model.AchievementCount()){AchPage=AchPage+1;}Refresh();}));
        p.With(Text("万物图录","section",28));
        Grid cg=Grid.Of(2);cg.logGap=12;
        for(int i=0;i<6;i=i+1){Label label=Wrap("","section",66);CodexLabels.Add(label);cg.With(label);}
        p.With(cg);
        CodexCounter=Text("","muted",32);
        p.With(MakePager("codexPrev","codexNext",CodexCounter,()=>{if(CodexPage>0){CodexPage=CodexPage-1;}Refresh();},()=>{if((CodexPage+1)*6<Model.Data.Enemies.Count+Model.Data.Items.Count){CodexPage=CodexPage+1;}Refresh();}));
    }
    static void Refresh() {
        if(Model==null || Model.Data==null){return;}
        PublishProbes();
        ClampAchPages();
        Shell.visible=!InMenu;Menu.visible=InMenu;
        Landing.visible=MenuPage==0;Slots.visible=MenuPage==1;MenuSettings.visible=MenuPage==2;MenuAchievements.visible=MenuPage==3;
        MenuMusicStatus.Text="音量 "+Number(Music.Volume())+"% · "+(Music.Muted()?"已静音":Music.IsPlaying()?"播放中":"未播放")+(Music.Error()!=""?" · "+Music.Error():"");
        for(int i=0;i<MenuAchievementLabels.Count;i=i+1){Row a=Model.AchievementRow(i);if(a!=null){MenuAchievementLabels[i].Text=(Model.AchievementUnlocked(i)?"已达成 · ":"未达成 · ")+a.Name+"\n"+a.Text("desc");MenuAchievementLabels[i].visible=i/AchPerPage()==MenuAwardPage;}}
        MenuAwardCounter.Text="第 "+Number(MenuAwardPage+1)+" / "+Number((Model.AchievementCount()+AchPerPage()-1)/AchPerPage())+" 页";
        for(int i=0;i<Nav.Count;i=i+1){string want=(!InMenu && Section==i)?"navsec navsec-current medium":"navsec medium";if(Nav[i].Class!=want){Nav[i].Class=want;}}
        for(int i=0;i<SectionBars.Count;i=i+1){SectionBars[i].visible=!InMenu && Section==i;}
        for(int i=0;i<Tabs.Count;i=i+1){string want=(!InMenu && Page==TabPages[i])?"tab tab-current medium":"tab medium";if(Tabs[i].Class!=want){Tabs[i].Class=want;}}
        for(int i=0;i<CraftButtons.Count;i=i+1){string want=(!InMenu && CraftFilter==CraftKeys[i])?"tab tab-current medium":"tab medium";if(CraftButtons[i].Class!=want){CraftButtons[i].Class=want;}}
        if(InMenu){return;}
        for(int i=0;i<Pages.Count;i=i+1){Pages[i].visible=i==Page;}
        NameText.Text=JourneyName;
        RealmText.Text=Model.RealmName()+" "+Number(Model.Layer())+" 层";
        AgeText.Text="年龄 "+Number(Model.Age());
        LifeText.Text="寿元 "+Number(Model.Lifespan()-Model.Age())+" 年";
        StonesText.Text="灵石 "+Number(Model.Stones);
        XpText.Text="修为 "+Number(Model.Xp);
        ActivityText.Text=Model.Activity==1?"正在闭关 · 吐纳天地":Model.Activity==2?"正在历练":Model.Activity==3?"正在百艺 · 制作中":"静养生息 · 尘缘未扰";
        Notice.Text=Model.LastMessage;
        QiText.Text="境界根基    "+Number(Model.Qi)+" / "+Number(Model.QiNeed());
        QiRateText.Text="每秒转化 "+Number(Model.CultivationRate());
        if(BreakBtn!=null){
            bool breakReady=!Model.NeedsPrestige&&Model.Layer()==12&&Model.Realm()<8&&Model.Qi>=Model.QiNeed();
            string pill=Model.Realm()<8?Model.Data.Realms[Model.Realm()].Text("pill"):"";bool hasPill=pill!=""&&Model.ItemCount(pill)>0;
            BreakBtn.Disabled=!breakReady||!hasPill;
            BreakBtn.Tip=!breakReady?(Model.Layer()!=12?"需当前境界修至十二层圆满":(Model.Realm()<8?"需闭关进度圆满 · 当前 "+Number(Model.Qi)+" / "+Number(Model.QiNeed()):"此境已至巅峰")):(hasPill?("条件齐备 · 消耗一枚"+ItemName(pill)+"即可破境"):("缺少 "+(pill==""?"破境丹":ItemName(pill))+" · 绝境首领首杀必得"));
            BreakInfo.Text=Model.RealmName()+" "+Number(Model.Layer())+"层 · "+BreakBtn.Tip;
        }
        if(CulBtn!=null){CulBtn.Disabled=Model.NeedsPrestige||Model.Activity==1;CulBtn.Tip=Model.Activity==1?"已在闭关中 · 可出关休息":"将修为经验转化为闭关进度，圆满后可破境";RestBtn.Disabled=Model.Activity==0;RestBtn.Tip=Model.Activity==0?"当前静养，无需出关":"结束当前闭关，静养恢复";BattleStopBtn.Disabled=Model.Activity!=2;CraftStopBtn.Disabled=Model.Activity!=3;}
        QiBar.SetPercent((int)(Model.Qi*100/Model.QiNeed()));HpBar.SetPercent((int)(Model.Hp*100/Model.MaxHp()));
        if(Model.QuestIndex<Model.Data.Quests.Count){Row q=Model.Data.Quests[Model.QuestIndex];QuestTitle.Text=q.Text("chapter")+"\n"+q.Name;QuestBody.Text=q.Text("objective");QuestReward.Text="奖励  灵石 "+q.Text("stones")+" · 修为 "+q.Text("xp");QuestBar.SetPercent((int)(Model.QuestProgress()*100/q.Num("target")));Claim.Disabled=Model.QuestProgress()<q.Num("target");}else{QuestTitle.Text="仙途未尽";QuestBody.Text="传承已收，余路由你。";Claim.Disabled=true;}
        MapPage=ClampPage(MapPage,MapCount(0));MapDPage=ClampPage(MapDPage,MapCount(1));MapEPage=ClampPage(MapEPage,MapCount(2));
        MapCounter.Text="第 "+Number(MapPage+1)+" / "+Number((MapCount(0)+2)/3)+" 页";
        MapDCounter.Text="第 "+Number(MapDPage+1)+" / "+Number((MapCount(1)+2)/3)+" 页";
        MapECounter.Text="第 "+Number(MapEPage+1)+" / "+Number((MapCount(2)+2)/3)+" 页";
        FillMapSlots(MapImages,MapNames,MapDetails,MapButtons,0,MapPage);
        FillMapSlots(MapDImages,MapDNames,MapDDetails,MapDButtons,1,MapDPage);
        FillMapSlots(MapEImages,MapENames,MapEDetails,MapEButtons,2,MapEPage);
        SkillCounter.Text=Number(SkillPage+1)+" / "+Number((Model.Data.Skills.Count+2)/3);
        for(int s=0;s<3;s=s+1){int si=SkillPage*3+s;SkillButtons[s].visible=si<Model.Data.Skills.Count;SkillImages[s].visible=si<Model.Data.Skills.Count;if(si<Model.Data.Skills.Count){Row sk=Model.Data.Skills[si];SkillNames[s].Text=sk.Name+" · "+Number(Model.Skill(sk.Id))+"层";SkillImages[s].Src=ArtPath(sk.Text("icon"));SkillDescs[s].Text=sk.Text("desc")+"\n境界需求 "+sk.Text("req")+" 层 · 上限 "+sk.Int("max_level")+" 层";SkillButtons[s].Text="参悟 · "+Number(Model.SkillCost(si))+"修为";SkillButtons[s].Tip=sk.Text("desc")+"\n境界需求 "+sk.Text("req")+" 层 · 上限 "+sk.Int("max_level")+" 层 · 消耗 "+Number(Model.SkillCost(si))+" 修为";SkillButtons[s].Disabled=Model.NeedsPrestige||Model.Level<sk.Int("req")||Model.Skill(sk.Id)>=sk.Int("max_level")||Model.Xp<Model.SkillCost(si);}else{SkillNames[s].Text="万法归一";SkillImages[s].Src=ArtPath("icon_manual.png");SkillDescs[s].Text="功法已尽数参悟";SkillButtons[s].Text="参悟";SkillButtons[s].Disabled=true;}}
        RecipePage=ClampPage(RecipePage,RecipeCount());
        RecipeCounter.Text="第 "+Number(RecipePage+1)+" / "+Number((RecipeCount()+2)/3)+" 页";
        for(int s=0;s<3;s=s+1){int ri=RecipeRowAt(RecipePage*3+s);RecipeButtons[s].visible=ri>=0;if(ri>=0){Row r=Model.Data.Recipes[ri];RecipeNames[s].Text=r.Name;RecipeImages[s].Src=ArtPath(r.Text("image"));RecipeDetails[s].Text=r.Text("desc")+"\n杂学 "+Number(Model.ArtLevel(r.Text("skill")))+" / 需求 "+r.Text("unlock")+" · "+r.Text("duration")+"秒";RecipeButtons[s].Text=r.Text("kind")=="gather"?"开始采集":"开始制作";RecipeButtons[s].Disabled=Model.NeedsPrestige||!Model.CanCraft(ri);RecipeButtons[s].Tip=RecipeDetail(ri)+(Model.CanCraft(ri)?"":"\n材料或杂学等级不足，暂不可开始");}else{RecipeNames[s].Text="百艺尽览";RecipeDetails[s].Text="";}}
        CraftText.Text=(Model.Activity==3?Model.Data.Recipes[Model.RecipeIndex].Name+" · "+Number(Model.CraftProgress)+" / "+Number(Model.CraftDuration())+"秒":"百艺闲置 · 选择配方后自动继续制作")+"    ·    当前分类 "+CraftLabel(CraftFilter);
        CraftBar.SetPercent(Model.Activity==3?(int)(Model.CraftProgress*100/Model.CraftDuration()):0);
        CombatText.Text=Model.Activity==2?Model.Data.Enemies[Model.EnemyIndex].Name+"    气血 "+Number(Model.EnemyHp)+" / "+Number(Model.EnemyMaxHp):"收剑听风    ·    本世胜场 "+Number(Model.Kills);
        WorkBar.SetPercent(Model.Activity==2?(int)(Model.EnemyHp*100/Model.EnemyMaxHp):0);
        BagTotal=0;foreach(string id in Model.Inventory.Keys){Row item=Model.ItemRow(id);if(Model.ItemCount(id)>0 && BagMatches(item)){BagTotal=BagTotal+1;}}
        if(BagPage*3>=BagTotal){BagPage=BagTotal>0?(BagTotal-1)/3:0;}
        BagIds.Clear();int offset=0;foreach(string id in Model.Inventory.Keys){Row item=Model.ItemRow(id);if(Model.ItemCount(id)>0 && BagMatches(item)){if(offset>=BagPage*3 && BagIds.Count<3){BagIds.Add(id);}offset=offset+1;}}
        for(int s=0;s<3;s=s+1){bool exists=s<BagIds.Count;BagUse[s].visible=exists;BagSell[s].visible=exists;BagImages[s].visible=exists;BagRecycle[s].visible=exists;if(exists){string id=BagIds[s];Row item=Model.ItemRow(id);if(item==null){continue;}BagNames[s].Text=ItemName(id)+" × "+Number(Model.ItemCount(id));BagDetails[s].Text=ItemDetail(id);BagImages[s].Src=ArtPath(item.Text("image")==""?"herb_dew_grass.png":item.Text("image"));bool usable=UsableItem(item,id);BagUse[s].Disabled=Model.NeedsPrestige||Model.Level<item.Int("req")||!usable;BagUse[s].Tip=ItemDetail(id)+(usable?"":"\n此物用于制作或破境，不可直接使用");bool gear=item.Text("slot")!="";BagRecycle[s].Disabled=!gear;BagRecycle[s].Tip=gear?"分解为灵石与淬炼材料":"仅装备可分解";}else{BagNames[s].Text=s==0?"此分类暂无物品":"空位";BagDetails[s].Text="去历练、采集或坊市取得新的珍藏。";}}
        BagCounter.Text="筛选 "+Number(BagTotal)+" / 行囊 "+Number(Model.Inventory.Count)+" 类 · 第 "+Number(BagPage+1)+"页";MarketCounter.Text="第 "+Number(MarketPage+1)+" / "+Number((Model.Data.Market.Count+2)/3)+" 页";
        for(int s=0;s<3;s=s+1){int market=MarketPage*3+s;MarketBuy[s].visible=market<Model.Data.Market.Count;if(market<Model.Data.Market.Count){Row item=Model.Data.Market[market];MarketNames[s].Text=item.Name+"    ·    "+item.Text("price")+" 灵石";bool canBuy=!Model.NeedsPrestige&&Model.Stones>=item.Num("price")&&Model.Level>=item.Int("req")&&Model.ItemCount(item.Id)<Model.Data.Rule("stack_limit");MarketBuy[s].Disabled=!canBuy;MarketBuy[s].Tip=item.Text("desc")+"\n价格 "+item.Text("price")+" 灵石 · 需境界 "+item.Text("req")+" 层"+(canBuy?"":(Model.Level<item.Int("req")?" · 境界不足":(Model.Stones<item.Num("price")?" · 灵石不足":" · 已达行囊上限")));}else{MarketNames[s].Text="";}}
        for(int i=0;i<GearSlots.Count;i=i+1){string slot=GearSlots[i];bool on=Model.Equipment.ContainsKey(slot);string title=i==0?"兵器":i==1?"法冠":i==2?"法袍":i==3?"灵履":i==4?"护腕":i==5?"护符":"灵戒";EquippedLabels[i].Text=title+" · "+(on?ItemName(Model.Equipment[slot]):"空栏");UnequipButtons[i].visible=on;UnequipButtons[i].Disabled=!on;}
        string gear="攻击 "+Number(Model.Attack())+"   防御 "+Number(Model.Defense())+"   气血 "+Number(Model.Hp)+" / "+Number(Model.MaxHp())+"    阵法："+(Model.Formation==""?"未布置":ItemName(Model.Formation))+" · 灵酒："+(Model.WineSeconds>0?ItemName(Model.Wine)+" "+Number(Model.WineSeconds)+"秒":"未饮用");
        GearText.Text=gear;
        if(StatVals.Count>=7){StatVals[0].Text=Model.RealmName()+" "+Number(Model.Layer())+"层";StatVals[1].Text=Number(Model.Hp)+" / "+Number(Model.MaxHp());StatVals[2].Text=Number(Model.Attack());StatVals[3].Text=Number(Model.Defense());StatVals[4].Text=Model.Activity==1?"闭关":Model.Activity==2?"历练":Model.Activity==3?"百艺":"静养";StatVals[5].Text=Model.SectIndex<0?"未加入":Model.Data.Sects[Model.SectIndex].Name;StatVals[6].Text="因果 "+Number(Model.Karma)+" · "+Number(Model.Rebirths)+"世";}
        string loot="";int start=Model.Log.Count-6;if(start<0){start=0;}for(int i=start;i<Model.Log.Count;i=i+1){loot=loot+Model.Log[i];}for(int i=0;i<LootLabels.Count;i=i+1){if(i<Model.Log.Count-start){LootLabels[i].Text=Model.Log[start+i];}else{LootLabels[i].Text="";}}
        MusicStatus.Text="山中清音 · 音量 "+Number(Music.Volume())+"% · "+(Music.Muted()?"已静音":Music.IsPlaying()?"播放中":"未播放")+(Music.Error()!=""?" · "+Music.Error():"");
        for(int i=0;i<TaskLabels.Count;i=i+1){Row t=Model.Data.SectTasks[i];bool own=Model.SectIndex>=0 && t.Text("sect")==Model.Data.Sects[Model.SectIndex].Id;TaskLabels[i].Text=t.Name+"\n进度 "+Number(Model.SectTaskProgress(i))+" / "+t.Text("target")+" · 奖励 "+t.Text("reward")+" 贡献";TaskButtons[i].Disabled=!own || Model.SectTaskProgress(i)<t.Num("target");}
        for(int i=0;i<TalentLabels.Count;i=i+1){TalentLabels[i].Text=Model.Data.Talents[i].Name+" · "+Number(Model.TalentLevel(i))+"级 · 消耗 "+Number(Model.TalentCost(i))+"因果";bool canUp=!Model.NeedsPrestige&&Model.TalentLevel(i)<100&&Model.Karma>=Model.TalentCost(i);TalentButtons[i].Disabled=!canUp;TalentButtons[i].Tip="升至 "+Number(Model.TalentLevel(i)+1)+" 级 · 消耗 "+Number(Model.TalentCost(i))+" 因果"+(canUp?"":(Model.TalentLevel(i)>=100?" · 已至百级圆满":" · 因果不足"));}
        EndingText.Text=Model.Ascended?"飞升 · 山海归一\n九重天劫已渡，长生之路终成。仍可巡游万界、完成图鉴，或携因果再续一世。":Model.NeedsPrestige?"寿元已尽 · 此世已成往事\n请在下方确认转生，保留因果与永久天赋，再续仙缘。":"天门未开 · 前往绝境，逐一渡过九重试炼。\n击败最终天劫，即可成就飞升结局。";
        for(int i=0;i<VaultLabels.Count;i=i+1){Row v=Model.SectVaultRow(i);if(v!=null){VaultLabels[i].Text=v.Name+" · "+Number(Model.SectVaultCost(i))+"贡献\n"+v.Text("desc");VaultButtons[i].Disabled=Model.SectIndex<0 || Model.Contribution<Model.SectVaultCost(i) || Model.Level<v.Int("req");}else{VaultLabels[i].Text="拜入宗门后查看本宗宝库";VaultButtons[i].Disabled=true;}}
        ArenaStatus.Text=(Model.ArenaAvailable()?"论剑开放":"论剑尚未开放")+" · 胜场 "+Number(Model.ArenaWins())+" · 战力 "+Number(Model.ArenaPower())+"\n每 "+Number(Model.ArenaCycleSeconds())+"秒开放 "+Number(Model.ArenaWindowSeconds())+"秒 · 距下轮 "+Number(Model.ArenaCycleSeconds()-(Model.PlayedSeconds-Model.ArenaCycle()*Model.ArenaCycleSeconds()))+"秒";
        for(int i=0;i<ArenaLabels.Count;i=i+1){Row a=Model.ArenaOpponent(i);if(a!=null){ArenaLabels[i].Text=a.Name+" · 战力 "+a.Text("power")+" · 奖励 "+a.Text("reward")+"贡献"+(Model.ArenaOpponentWon(i)?" · 已胜":"");ArenaButtons[i].Disabled=!Model.ArenaAvailable() || Model.ArenaOpponentAttempted(i) || Model.Level<a.Int("req");}else{ArenaLabels[i].Text="拜入宗门后解锁同道论剑";ArenaButtons[i].Disabled=true;}}
        RefreshCodex();
        SectText.Text=Model.SectIndex<0?"筑基之后，可择一宗门。正魔殊途，皆可求长生。":"已入 "+Model.Data.Sects[Model.SectIndex].Name+" · 贡献 "+Number(Model.Contribution)+" · 心法 "+Number(Model.SectManual)+"层";
        for(int i=0;i<SectButtons.Count&&i<Model.Data.Sects.Count;i=i+1){Row r=Model.Data.Sects[i];bool mine=Model.SectIndex==i;bool joined=Model.SectIndex>=0;bool can=!Model.NeedsPrestige&&!joined&&Model.Level>=r.Int("req");SectButtons[i].Disabled=!can;SectButtons[i].Text=mine?"本宗":"拜入宗门";SectButtons[i].Tip=r.Text("desc")+"\n境界需求 "+r.Text("req")+" 层"+(mine?" · 已拜入本宗":(joined?" · 一世只择一宗":""));}
        if(SectTrainBtn!=null){int trainCost=(Model.SectManual+1)*520;bool canTrain=!Model.NeedsPrestige&&Model.SectIndex>=0&&Model.Contribution>=trainCost&&Model.SectManual<99;SectTrainBtn.Disabled=!canTrain;SectTrainBtn.Text="研习宗门心法 · "+Number(trainCost)+" 贡献";SectTrainBtn.Tip=(Model.SectIndex<0?"需先拜入宗门":(Model.SectManual>=99?"心法已至 99 层圆满":(Model.Contribution<trainCost?"贡献不足 · 尚差 "+Number(trainCost-(int)Model.Contribution):"消耗贡献，精进本宗心法")));}
        KarmaText.Text="因果 "+Number(Model.Karma)+"    ·    已历 "+Number(Model.Rebirths)+"世";HealSetting.Text=Model.AutoHeal?"自动服药：开启":"自动服药：关闭";SaveText.Text=SaveStatus+"\n"+SavePath;
    }
    static void FillMapSlots(List<Image> imgs,List<Label> names,List<Label> details,List<Button> btns,int mode,int page) {
        for(int s=0;s<3;s=s+1){int gi=MapRowAt(mode,page*3+s);btns[s].visible=gi>=0;if(gi>=0){Row m=Model.Data.Maps[gi];names[s].Text=m.Name;details[s].Text=m.Text("desc")+"\n境界要求："+m.Text("req")+"层";imgs[s].Src=ArtPath(m.Text("image"));btns[s].Text=Model.MapUnlocked(gi)?"前往历练":"尚未解锁";btns[s].Disabled=!Model.MapUnlocked(gi);}else{names[s].Text="云深不知处";details[s].Text="前方再无地图";imgs[s].Src=ArtPath("qingzhu_ridge.png");}}
    }
    // Mirror of Model.UseItem's branch coverage: only these kinds have a
    // direct-use effect; everything else is crafting/breakthrough material.
    static bool UsableItem(Row r,string id) {
        if(r==null){return false;}
        if(id=="treasure_box"||id=="blank_jade_slip"){return true;}
        string t=r.Text("type");
        return t=="equipment"||t=="manual"||t=="formation"||t=="formations"||t=="talisman"||t=="wine"||t=="consumable"||t=="alchemy"||t=="pill"||r.Text("slot")!="";
    }
    static string RecipeDetail(int index) {
        Row r=Model.Data.Recipes[index];string detail=r.Text("desc")+"\n杂学 "+Number(Model.ArtLevel(r.Text("skill")))+" / 需求 "+r.Text("unlock")+"级 · "+r.Text("duration")+"秒\n熟练度 "+Number(Model.Count(Model.Mastery,r.Id))+" · 产出 "+ItemName(r.Text("result"));
        bool cost=false;foreach(Row c in Model.Data.Ingredients){if(c.Text("recipe")==r.Id){cost=true;string id=c.Text("item");detail=detail+"\n"+(id=="stones"?"灵石":ItemName(id))+" "+Number(id=="stones"?Model.Stones:Model.ItemCount(id))+" / "+c.Text("count");}}
        return detail+(cost?"":"\n无需材料 · 可持续采集");
    }
    static void RefreshCodex() {
        for(int i=0;i<AchievementLabels.Count;i=i+1){Row a=Model.AchievementRow(i);if(a!=null){AchievementLabels[i].Text=(Model.AchievementUnlocked(i)?"已达成 · ":"修行中 · ")+a.Name+"  "+Number(Model.AchievementProgress(i))+" / "+a.Text("target")+"\n"+a.Text("desc");AchievementLabels[i].visible=i/AchPerPage()==AchPage;}}
        AchCounter.Text="第 "+Number(AchPage+1)+" / "+Number((Model.AchievementCount()+AchPerPage()-1)/AchPerPage())+" 页";
        for(int i=0;i<6;i=i+1){int index=CodexPage*6+i;if(index<Model.Data.Enemies.Count){Row e=Model.Data.Enemies[index];CodexLabels[i].Text=e.Name+" · 已击败 "+Number(Model.Count(Model.EnemyKills,e.Id))+"次\n气血 "+e.Text("hp")+" · 攻击 "+e.Text("atk")+" · 掉落 "+ItemName(e.Text("drop"));}else{index=index-Model.Data.Enemies.Count;if(index<Model.Data.Items.Count){Row r=Model.Data.Items[index];CodexLabels[i].Text=r.Name+" · 持有 "+Number(Model.ItemCount(r.Id))+"件\n"+r.Text("desc");}else{CodexLabels[i].Text="本卷终";}}}
        CodexCounter.Text="第 "+Number(CodexPage+1)+" / "+Number((Model.Data.Enemies.Count+Model.Data.Items.Count+5)/6)+"卷";
    }
    static void BuildShell() {
        Shell=Panel.Root("shell");Shell.DockFill();Window.With(Shell);
        Image world=Art("qingzhu_ridge.webp",800);world.name="worldBackground";world.Class="world-bg";world.Fit="cover";world.DockFill();Shell.With(world);
        Panel wash=Panel.Root("wash");wash.Class="bg-wash";wash.DockFill();Shell.With(wash);
        Flex top=Flex.Row().AlignCenter();top.Class="topbar";Size(top,0,78);top.Gap(12);top.DockTop();wash.With(top);
        NameText=Text(JourneyName,"topname",40);Size(NameText,0,40);top.With(NameText);
        RealmText=Text("","pill-text-ink",24);top.With(Pill("pill-res",RealmText));
        AgeText=Text("","pill-text-ink",24);top.With(Pill("pill-res",AgeText));
        LifeText=Text("","pill-text-ink",24);top.With(Pill("pill-res",LifeText));
        top.With(GrowSpace());
        StonesText=Text("","pill-strong",24);top.With(Pill("pill-strong",StonesText));
        XpText=Text("","pill-strong",24);top.With(Pill("pill-strong",XpText));
        Panel nav=Column("sidebar");Size(nav,185,0);nav.logGap=6;wash.With(nav);nav.DockLeft();
        Image logo=Art("logo.webp",128);logo.Fit="contain";logo.Class="nav-logo";Size(logo,0,128);nav.With(logo);
        List<string> sections=new List<string>();sections.Add("修行");sections.Add("历练");sections.Add("杂学");sections.Add("万宝");sections.Add("宗门");sections.Add("轮回");sections.Add("系统");
        for(int i=0;i<7;i=i+1){int index=i;Button b=ActionButton("nav"+Number(i),sections[i],()=>{SelectSection(index);},"navsec");Size(b,0,48);Nav.Add(b);nav.With(b);}
        nav.With(Spacer());
        nav.With(Text("无为修仙传 v1.0.7","navfoot",22));
        Panel center=Column("center");center.DockFill();center.logGap=12;wash.With(center);
        Panel subnavs=Panel.Root("subnavs");Size(subnavs,0,58);center.With(subnavs);
        // 修行区段的三个页签靠左即可；宽区段（杂学 8 个、宗门 3 个）也一律
        // 靠左，靠 grow 拉满会稀释页签节奏。当前项由 Refresh 上色。
        Flex bar0=NewSubnav(subnavs);AddTab(bar0,0,"闭关");AddTab(bar0,1,"功法");AddTab(bar0,2,"破境");
        SectionBars.Add(bar0);
        Flex bar1=NewSubnav(subnavs);AddTab(bar1,3,"任务");AddTab(bar1,4,"野外");AddTab(bar1,5,"险地");AddTab(bar1,6,"绝境");
        SectionBars.Add(bar1);
        Flex bar2=NewSubnav(subnavs);AddCraftTab(bar2,"fish","垂钓","fishing");AddCraftTab(bar2,"herbs","采药","herbalism");AddCraftTab(bar2,"mining","采矿","mining");AddCraftTab(bar2,"brew","酿造","brewing");AddCraftTab(bar2,"forge","炼器","forging");AddCraftTab(bar2,"alchemy","炼丹","alchemy");AddCraftTab(bar2,"talisman","符箓","talismans");AddCraftTab(bar2,"formation","阵法","formations");
        SectionBars.Add(bar2);
        Flex bar3=NewSubnav(subnavs);AddTab(bar3,8,"行囊");AddTab(bar3,9,"坊市");
        SectionBars.Add(bar3);
        Flex bar4=NewSubnav(subnavs);AddTab(bar4,10,"宗门事务");AddTab(bar4,11,"宗门宝库");AddTab(bar4,12,"宗门擂台");
        SectionBars.Add(bar4);
        Flex bar5=NewSubnav(subnavs);Subnote=Text("轮回 · 因果与永久天赋","muted grow",42);bar5.With(Subnote);
        SectionBars.Add(bar5);
        Flex bar6=NewSubnav(subnavs);AddTab(bar6,14,"设置");AddTab(bar6,15,"图鉴");
        SectionBars.Add(bar6);
        Panel body=Panel.Root("pages");body.Grow();center.With(body);
        BuildCultivate();BuildSkills();BuildBreakthrough();BuildQuests();BuildRegions();BuildCraft();BuildInventory();BuildMarket();BuildSect();BuildPrestige();BuildSettings();BuildCodex();
        foreach(ScrollColumn p in Pages){body.With(p);}
        Notice=Text("","notice",24);center.With(Notice);Notice.DockBottom();
        Panel aside=Column("rightbar");Size(aside,330,0);aside.logGap=12;wash.With(aside);aside.DockRight();
        Panel statCard=Column("card");aside.With(statCard);
        statCard.With(Text("修士状态","section",30));
        List<string> statKeys=new List<string>();statKeys.Add("境界");statKeys.Add("气血");statKeys.Add("攻击");statKeys.Add("防御");statKeys.Add("行动");statKeys.Add("宗门");statKeys.Add("因果");
        for(int i=0;i<statKeys.Count;i=i+1){Flex row=Flex.Row().AlignCenter();row.Gap(8);Size(row,0,26);row.With(Text(statKeys[i],"stat-key",22));row.With(GrowSpace());Label val=Text("","stat-val",22);StatVals.Add(val);row.With(val);statCard.With(row);}
        aside.With(Text("最近收获","section",30));
        Panel lootCard=Column("card");aside.With(lootCard);
        for(int i=0;i<6;i=i+1){Label label=Wrap("","loot-line",24);LootLabels.Add(label);lootCard.With(label);}
    }
    static Flex Pill(string cls,Label text) {
        Flex p=Flex.Row().AlignCenter();p.Class="pill "+cls;p.Gap(0);p.With(text);return p;
    }
    static Flex NewSubnav(Panel holder) {
        Flex bar=Flex.Row().AlignCenter();bar.Class="subnav";Size(bar,0,58);bar.Gap(6);bar.DockFill();holder.With(bar);return bar;
    }
    static void AddTab(Flex subnav,int page,string label) {
        int target=page;Button b=ActionButton("tab"+Number(page),label,()=>{SelectPage(target);},"tab");Size(b,168,42);b.Class="tab medium";Tabs.Add(b);TabPages.Add(page);TabSections.Add(SectionOfPage(page));subnav.With(b);
    }
    static void AddCraftTab(Flex subnav,string name,string label,string key) {
        Button b=ActionButton(name,label,()=>{CraftCategory(key);},"tab");Size(b,96,42);b.Class="tab medium";CraftButtons.Add(b);CraftKeys.Add(key);subnav.With(b);
    }
    static int SectionOfPage(int page) { return page<=2?0:page<=6?1:page==7?2:page<=9?3:page<=12?4:page==13?5:6; }
    static void Build() {
        Window.GetApp().UseSkin("wuwei");Window.GetApp().SetChromeButtons(false,false,true,true);
        BuildMenu();BuildShell();Ready=true;Refresh();Clock=Stopwatch.StartNew();Window.Every(250,()=>{Heartbeat();});Window.Every(30000,()=>{SaveGame(false);});Window.OnExit(()=>{SaveGame(false);Music.Dispose();});
    }
    // 快捷键：Space 开始/暂停当前活动，Esc 打开系统页（侧栏有说明）。
    // 沿用 IDE 的做法：每帧读 App.EventKind + window.EventKeyCode。
    // 未实现 F11 全屏——Gui 标准库没有该 API，不为此发明接口。
    static void PumpKeys() {
        App app=Window.GetApp();
        int kind=app.EventKind();
        if(kind!=4 || !Ready || InMenu){return;}
        int kc=app.window.EventKeyCode();
        if(kc==32){
            if(Model.Activity==0){Result(Model.StartCultivation());}
            else {Model.StopActivity();Model.Say("已停下手中事务",true);}
            Refresh();
        }
        else if(kc==27){SelectSection(6);}
    }
    // One completed work unit per rendered frame; no artificial timer or sleep.
    static void LoadFrame() {
        PumpKeys();
        PublishProbes();if(Ready){return;}
        if(LoadStep==0){LoadStep=1;}
        else if(LoadStep==1){Model.Init(Root+"/data");LoadStep=2;OpeningText.Text="资源加载中 · 修行数据已解密";}
        else if(LoadStep==2){ArtPath("main_menu_bg.webp");ArtPath("title_calligraphy.webp");LoadStep=3;OpeningText.Text="资源加载中 · 山海画卷已展开";}
        else if(LoadStep==3){LoadSave();LoadStep=4;OpeningText.Text="资源加载中 · 清音与仙缘已就绪";}
        else {Build();Opening.visible=false;LoadStep=5;}
        OpeningBar.SetPercent((LoadStep-1)*25);Window.GetApp().RequestRedraw();Window.GetApp().RequestWakeIn(1);
    }
    static void Main() {
        Root=Skin.ExeDir();Model=new Wuwei.Game();
        try {
            Window=Form.Create("无为修仙传",1280,800);Window.GetApp().UseSkin("wuwei");
            Opening=Panel.Root("loading");Opening.Class="loading";Opening.DockFill();Window.With(Opening);
            Label title=Text("无为修仙传","loading-title text-3xl",72);Place(title,340,270,600,72);Opening.With(title);
            OpeningText=Text("资源加载中 · 准备山海画卷","loading-text",36);Place(OpeningText,340,382,600,36);Opening.With(OpeningText);
            OpeningBar=new Progress(0,1);OpeningBar.Class="loading-progress";OpeningBar.ShowText(false);Place(OpeningBar,340,434,600,22);Opening.With(OpeningBar);
            Window.FrameHook(()=>{LoadFrame();});Window.Run();
        }
        catch(Exception e){Form error=Form.Create("无为修仙 · 需要处理",720,280);Panel p=Column("p-4");p.DockFill();p.With(Wrap("游戏未能启动："+e.Message+"\n请检查数据包、素材与运行目录，然后重新构建。","",176));error.With(p);error.Run();}
    }
}
