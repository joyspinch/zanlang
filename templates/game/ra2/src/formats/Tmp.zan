using System;
using System.Collections.Generic;

namespace Ra2.Formats;

// Header of a single tile within a TMP(TS) template. The base graphic is an
// isometric diamond; a few gameplay fields (height/terrain/ramp) are exposed.
//
// A tile may also carry an "extra" graphic: the overhanging art of a cliff or
// a bridge, drawn as a plain rectangle at its own offset rather than as a
// diamond. Without it, a raised cell leaves a transparent diamond where the
// ground it rose above used to be.
class TmpTile {
    int x;
    int y;
    int height;
    int terrainType;
    int rampType;
    int offset;
    // Extra graphic, present only when bit 0 of the block's flags is set.
    // The other bytes of that field are uninitialised in the shipped art
    // (0xCDCDCDCD shows through), so the flag is the only reliable test.
    bool hasExtra;
    int extraOffset;
    int extraZOffset;
    int extraX;
    int extraY;
    int extraWidth;
    int extraHeight;

    int X() { return this.x; }
    int Y() { return this.y; }
    int Height() { return this.height; }
    int TerrainType() { return this.terrainType; }
    int RampType() { return this.rampType; }
    int Offset() { return this.offset; }
    bool IsEmpty() { return this.offset == 0; }

    bool HasExtra() { return this.hasExtra; }
    int ExtraOff() { return this.extraOffset; }
    int ExtraWidth() { return this.extraWidth; }
    int ExtraHeight() { return this.extraHeight; }
    /// <summary>Where the extra graphic sits relative to the tile's own
    /// apex, in pixels.</summary>
    int ExtraOffsetX() { return this.extraX - this.x; }
    int ExtraOffsetY() { return this.extraY - this.y; }
}

// Parses a TMP(TS) terrain template as used by Tiberian Sun / Red Alert 2.
// Pixels are 8-bit palette indices (0 = transparent); the base graphic of each
// tile is a centered isometric diamond of tileWidth x tileHeight. Depth and
// "extra" (cliff) data is parsed but not drawn by default -- see
// ExtraEnabled. Clean-room: tests synthesize tiles.
//
// Layout (little-endian), verified byte-by-byte against CLIFF01, WCLIFF02
// and WCLIFF03 of this install's ISOTEMP.MIX:
//   header    : blocksX(u32), blocksY(u32), tileWidth(u32), tileHeight(u32)
//   directory : u32 offset per tile (0 = empty)
//   tile hdr  : x(i32), y(i32), extraOfs(u32), extraZOfs(u32),
//               extraX(i32), extraY(i32), extraW(u32), extraH(u32),
//               flags(u32), height(u8), terrain(u8), ramp(u8),
//               radarRGB(6), pad(3) -- 52 bytes total.
//               Both offsets are relative to the tile's own header. The body
//               behind a header is [base pixels tw*th/2][base depth tw*th/2]
//               [extra pixels extraW*extraH][extra depth extraW*extraH], so
//               for the shipped 60x30 tiles extraOfs is 1852 and the extra
//               pixels run [hdr+1852, hdr+extraZOfs). In files that leave a
//               block unused the offsets keep their section values while the
//               pixel fields are 0xCDCDCDCD; the flag's bit 0 vouches for the
//               rectangle, and the range guard below catches the junk.
//   tile body : base rows are runs 4,8,.. centered, growing by 4 while
//               row < height/2-1 then shrinking by 4; the depth plane and
//               both extra planes are plain rectangles.
class TmpTemplate {
    string data;
    int length;
    int blocksX;
    int blocksY;
    int tileWidth;
    int tileHeight;
    List<TmpTile> tiles;

    // The extra-graphic pass draws the cliff faces and their cast shadows:
    // the vertical art a raised cell needs below and behind its diamond. With
    // the extra offset misread every overhang decoded from the wrong file
    // position and produced striped garbage, which is why this used to be
    // gated off behind RA2_EXTRA. It is on by default now; RA2_EXTRA=0 opts
    // out while debugging.
    [DllImport("crt")]
    static extern string getenv(string name);

    static bool ExtraEnabled() {
        string v = TmpTemplate.getenv("RA2_EXTRA");
        return v == null || v.Length == 0 || v != "0";
    }

    static TmpTemplate Parse(string data, int length) {
        TmpTemplate t = new TmpTemplate();
        t.data = data;
        t.length = length;
        t.tiles = new List<TmpTile>();

        BinaryReader r = BinaryReader.FromBuffer(data, length);
        t.blocksX = (int)r.ReadU32();
        t.blocksY = (int)r.ReadU32();
        t.tileWidth = (int)r.ReadU32();
        t.tileHeight = (int)r.ReadU32();

        int count = t.blocksX * t.blocksY;
        for (int i = 0; i < count; i = i + 1) {
            int off = (int)r.ReadU32();
            TmpTile tile = new TmpTile();
            tile.offset = off;
            if (off != 0) {
                int save = r.Position();
                r.Seek(off);
                tile.x = r.ReadI32();
                tile.y = r.ReadI32();
                // +8 points at the start of the extra's pixels (right after
                // the base's pixels+depth), +12 at the base's own depth plane
                // (52 + tw*th/2), and +16 at the extra's depth plane -- so the
                // extra pixels are [hdr+u32@8, hdr+u32@16). Read as file
                // absolutes they land in unrelated depth data, which is where
                // the striped garbage used to come from.
                tile.extraOffset = off + (int)r.ReadU32();
                r.Seek(off + 16);
                tile.extraZOffset = off + (int)r.ReadU32();
                tile.extraX = r.ReadI32();
                tile.extraY = r.ReadI32();
                tile.extraWidth = (int)r.ReadU32();
                tile.extraHeight = (int)r.ReadU32();
                int flags = (int)r.ReadU32();
                tile.hasExtra = (flags & 1) != 0;
                if (!TmpTemplate.ExtraEnabled()) { tile.hasExtra = false; }
                tile.height = r.ReadU8();
                tile.terrainType = r.ReadU8();
                tile.rampType = r.ReadU8();
                // Guard the rectangle even though the flag vouches for it.
                // Some shipped blocks set the flag but leave extraX/extraY as
                // uninitialised memory, which reads back as a huge value and
                // would size a texture into the gigabytes; a cliff overhang is
                // never more than a couple of tiles from its own diamond, so
                // anything past that is rejected outright.
                int limit = 512;
                int dx = tile.extraX - tile.x;
                int dy = tile.extraY - tile.y;
                if (tile.extraWidth <= 0 || tile.extraHeight <= 0
                    || tile.extraWidth > limit || tile.extraHeight > limit
                    || dx < 0 - limit || dx > limit
                    || dy < 0 - limit || dy > limit
                    || tile.extraOffset <= 0 || tile.extraOffset >= length) {
                    tile.hasExtra = false;
                }
                r.Seek(save);
            }
            t.tiles.Add(tile);
        }
        return t;
    }

    int BlocksX() { return this.blocksX; }
    int BlocksY() { return this.blocksY; }
    int TileWidth() { return this.tileWidth; }
    int TileHeight() { return this.tileHeight; }
    int TileCount() { return this.tiles.Count; }

    TmpTile TileAt(int index) {
        if (index < 0 || index >= this.tiles.Count) { return null; }
        return this.tiles[index];
    }

    // Decode a tile's base graphic into a tileWidth*tileHeight index buffer
    // (0 = transparent outside the diamond).
    byte[] DecodeTile(int index) {
        TmpTile tile = this.TileAt(index);
        int cx = this.tileWidth;
        int cy = this.tileHeight;
        byte[] outBuf = new byte[cx * cy + 1];
        if (tile == null || tile.IsEmpty()) { return outBuf; }

        BinaryReader r = BinaryReader.FromBuffer(this.data, this.length);
        r.Seek(tile.Offset() + 52);

        int width = 4;
        for (int j = 0; j < cy; j = j + 1) {
            int start = j * cx + (cx - width) / 2;
            for (int k = 0; k < width; k = k + 1) {
                outBuf[start + k] = (byte)r.ReadU8();
            }
            if (j < cy / 2 - 1) {
                width = width + 4;
            } else {
                width = width - 4;
            }
        }
        return outBuf;
    }

    // Decode a tile's extra graphic -- the overhang of a cliff or bridge --
    // into an extraWidth*extraHeight index buffer (0 = transparent).
    //
    // Unlike the base diamond this is a plain rectangle stored row by row with
    // no run structure, and it is what fills the gap a raised cell leaves
    // behind. Returns "" when the tile has no extra graphic.
    byte[] DecodeExtra(int index) {
        TmpTile tile = this.TileAt(index);
        if (tile == null || !tile.HasExtra()) { return new byte[1]; }
        int w = tile.ExtraWidth();
        int h = tile.ExtraHeight();
        byte[] outBuf = new byte[w * h + 1];

        BinaryReader r = BinaryReader.FromBuffer(this.data, this.length);
        r.Seek(tile.extraOffset);
        int n = w * h;
        // The file can end mid-rectangle; the tail stays transparent rather
        // than reading past the buffer.
        int avail = this.length - tile.extraOffset;
        if (avail < n) { n = avail; }
        for (int i = 0; i < n; i = i + 1) {
            outBuf[i] = (byte)r.ReadU8();
        }
        return outBuf;
    }
}
