using System;
using System.IO;

namespace Ra2.Formats;

// A 256-entry RGB palette parsed from a RA2/Tiberian Sun .pal file
// (256 entries * 3 bytes = 768 bytes, channel order R,G,B).
//
// Original game palettes store 6-bit channels (0..63); HD/replacement
// palettes use the full 8-bit range (0..255). The raw channel bytes are
// preserved as-read; Scale8 expands a 6-bit value to 8-bit on demand so the
// caller decides how to interpret a given palette.
class Palette {
    string data;   // count*3 raw channel bytes
    int count;     // colour entries (256 for a well-formed .pal)

    static Palette Parse(string data, int length) {
        Palette p = new Palette();
        p.data = data;
        int entries = length / 3;
        if (entries > 256) { entries = 256; }
        p.count = entries;
        return p;
    }

    static Palette FromFile(string path) {
        byte[] buf = File.ReadBytes(path, 0, 768);
        return Palette.Parse(buf, 768);
    }

    int Count() { return this.count; }

    int channel(int index, int comp) {
        if (index < 0 || index >= this.count) { return 0; }
        int b = this.data[index * 3 + comp];
        return b & 0xFF;
    }

    int R(int index) { return this.channel(index, 0); }
    int G(int index) { return this.channel(index, 1); }
    int B(int index) { return this.channel(index, 2); }

    // Expand a 6-bit channel (0..63) to 8-bit (0..255) by replicating the top
    // bits into the low ones, so 0 -> 0 and 63 -> 255 with even spacing.
    static int Scale8(int c6) {
        int v = (c6 << 2) | (c6 >> 4);
        return v & 0xFF;
    }

    int R8(int index) { return Palette.Scale8(this.R(index)); }
    int G8(int index) { return Palette.Scale8(this.G(index)); }
    int B8(int index) { return Palette.Scale8(this.B(index)); }

    /// <summary>Whether an entry is the native magenta colour key -- 6-bit
    /// (63,0,63), the "transparent" slot several palettes ship alongside
    /// index 0. Both mean the same thing to the engine.</summary>
    bool IsMagenta(int index) {
        return this.R(index) == 63 && this.G(index) == 0
            && this.B(index) == 63;
    }

    // Pack an entry into 0xRRGGBB using 8-bit-expanded channels.
    int Rgb8(int index) {
        return (this.R8(index) << 16) | (this.G8(index) << 8) | this.B8(index);
    }

    // RA2 stores player colours as an HSV triple with every channel 0..255
    // (the rules [Colors] section). Convert one to a packed 0xRRGGBB.
    static int HsvRgb(int hue, int sat, int val) {
        if (sat <= 0) { return (val << 16) | (val << 8) | val; }
        int sector = hue * 6 / 256;          // 0..5
        int frac = hue * 6 - sector * 256;   // position inside the sector
        int p = val * (255 - sat) / 255;
        int q = val * (255 - sat * frac / 256) / 255;
        int t = val * (255 - sat * (255 - frac) / 256) / 255;
        int r; int g; int b;
        if (sector == 0) { r = val; g = t; b = p; }
        else if (sector == 1) { r = q; g = val; b = p; }
        else if (sector == 2) { r = p; g = val; b = t; }
        else if (sector == 3) { r = p; g = q; b = val; }
        else if (sector == 4) { r = t; g = p; b = val; }
        else { r = val; g = p; b = q; }
        return (r << 16) | (g << 8) | b;
    }

    /// <summary>A copy of this palette with the 16 remap slots (16..31) --
    /// the zone unit sprites and voxel vertices use for player colour --
    /// recoloured to the given hue/saturation. The base ramp's brightness
    /// curve is kept, so only the colour moves: the engine hardcodes its own
    /// ramps and the install ships no table, and this reproduces the
    /// recolour the community palette tools perform. Slots store 6-bit
    /// channels like the rest of the file.</summary>
    Palette Remapped(int hue, int sat) {
        // The remap slots are a brightness ladder of the house colour: slot
        // 16 the brightest, 31 the darkest, the sixteen steps the shipped
        // art was painted against. Anchoring every step on the house colour
        // (not on whatever the unremapped palette ships there) keeps the
        // shaded ramp smooth.
        int[] factor = new int[] { 63, 59, 55, 52, 48, 44, 41, 37, 33, 30,
                                   26, 22, 19, 15, 11, 8 };
        byte[] buf = new byte[this.count * 3];
        for (int i = 0; i < this.count; i = i + 1) {
            if (i >= 16 && i < 32) {
                int v = factor[i - 16] * 255 / 63;
                int rgb = Palette.HsvRgb(hue, sat, v);
                buf[i * 3] = (byte)((rgb >> 16) >> 2);
                buf[i * 3 + 1] = (byte)(((rgb >> 8) & 0xFF) >> 2);
                buf[i * 3 + 2] = (byte)((rgb & 0xFF) >> 2);
            } else {
                buf[i * 3] = (byte)this.R(i);
                buf[i * 3 + 1] = (byte)this.G(i);
                buf[i * 3 + 2] = (byte)this.B(i);
            }
        }
        return Palette.Parse(buf, buf.Length);
    }
}
