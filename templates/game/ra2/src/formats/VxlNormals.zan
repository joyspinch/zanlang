    static double[] V(double x, double y, double z) {
        double[] v = new double[3];
        v[0] = x; v[1] = y; v[2] = z;
        return v;
    }

    /// <summary>The normal table for a limb's normalsMode. Unknown modes
    /// fall back to normals1, matching the reference's warning path.</summary>
    static List<double[]> Table(int mode) {
        if (mode == 2) { VxlNormals.LoadNormals2(); return VxlNormals.normals2; }
        if (mode == 3) { VxlNormals.LoadNormals3(); return VxlNormals.normals3; }
        if (mode == 4) { VxlNormals.LoadNormals4(); return VxlNormals.normals4; }
        VxlNormals.LoadNormals1();
        return VxlNormals.normals1;
    }

    /// <summary>The normal at an index, or null when out of range (the
    /// reference's array access would be undefined there).</summary>
    static double[] At(List<double[]> table, int index) {
        if (table == null || index < 0 || index >= table.Count) { return null; }
        return table[index];
    }
}
