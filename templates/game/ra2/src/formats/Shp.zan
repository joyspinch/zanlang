using System;
using System.Collections.Generic;

namespace Ra2.Formats;

// One frame of a SHP(TS) sprite. Coordinates are the frame's placement inside
// the sprite's bounding box; format selects the on-disk encoding.
class ShpFrame {
    int x;
    int y;
    int width;
    int height;
    int format;   // 1 = uncompressed, 2 = row-raw, 3 = row RLE-zero
    int offset;   // byte offset of the frame's pixel data in the file

    int X() { return this.x; }
    int Y() { return this.y; }
    int Width() { return this.width; }
    int Height() { return this.height; }
    int Format() { return this.format; }
    int Offset() { return this.offset; }
    bool IsEmpty() { return this.offset == 0 || this.width == 0 || this.height == 0; }
}

// Parses a SHP(TS) sprite as used by Tiberian Sun / Red Alert 2. Pixels are
// 8-bit palette indices (index 0 = transparent); pair with a Palette to get
// RGB. Clean-room: no original sprites are embedded; tests synthesize frames.
//
// Layout (little-endian):
//   header      : zero(u16), width(u16), height(u16), frameCount(u16)
//   frameHeader : x(u16), y(u16), w(u16), h(u16),
//                 format(u32, low byte used), unknown(u32), zero(u32), offset(u32)
//                 frame data  : format 0 = 2 skipped bytes then w*h raw indices (the
//                 shell's MNBTTN.SHP ships this way);
//                 format 1 = w*h raw bytes;
//                 format 2/3 = bit 1 set: per row: rowLen(u16, incl. the 2
//                 length bytes) then rowLen-2 bytes; a 0 byte is followed by
//                 a transparent run count (format 2/3 differ only in a flag
//                 bit the game does not read).
class ShpImage {
    string data;
    int length;
    int width;
    int height;
    int frameCount;
    List<ShpFrame> frames;

    static ShpImage Parse(string data, int length) {
        ShpImage s = new ShpImage();
        s.data = data;
        s.length = length;
        s.frames = new List<ShpFrame>();

        BinaryReader r = BinaryReader.FromBuffer(data, length);
        r.Skip(2);                         // zero
        s.width = r.ReadU16();
        s.height = r.ReadU16();
        s.frameCount = r.ReadU16();

        for (int i = 0; i < s.frameCount; i = i + 1) {
            ShpFrame f = new ShpFrame();
            f.x = r.ReadU16();
            f.y = r.ReadU16();
            f.width = r.ReadU16();
            f.height = r.ReadU16();
            f.format = (int)(r.ReadU32() & 0xFF);
            r.Skip(4);                     // unknown
            r.Skip(4);                     // zero
            f.offset = (int)r.ReadU32();
            s.frames.Add(f);
        }
        return s;
    }

    int Width() { return this.width; }
    int Height() { return this.height; }
    int FrameCount() { return this.frames.Count; }

    ShpFrame FrameAt(int index) {
        if (index < 0 || index >= this.frames.Count) { return null; }
        return this.frames[index];
    }

    /// <summary>The frame's on-disk format byte, -1 when the frame is out of
    /// range. Type 1 = raw, 2 = length-prefixed raw rows, 3 = length-prefixed
    /// rows with transparent-run compression; diagnostics and the decoder
    /// both need to tell 2 and 3 apart.</summary>
    int FormatAt(int index) {
        ShpFrame f = this.FrameAt(index);
        if (f == null) { return 0 - 1; }
        return f.Format();
    }

    // Decode a frame to a width*height buffer of palette indices (0 = transparent).
    byte[] DecodeFrame(int index) {
        ShpFrame f = this.FrameAt(index);
        if (f == null) { return new byte[1]; }
        // A frame carries its own sub-rect inside the file's canvas and the
        // two regularly disagree, so this returns the frame's own buffer at
        // the frame's size; DecodeFrameCanvas composes it onto the canvas
        // for callers that read a Width() x Height() span.
        int w = f.Width();
        int h = f.Height();
        byte[] buf = new byte[w * h + 1];
        if (f.IsEmpty()) { return buf; }

        BinaryReader r = BinaryReader.FromBuffer(this.data, this.length);
        r.Seek(f.Offset());

        // Bit 1 of the format byte selects RLE-zero compression, the encoding
        // virtually every RA2 sprite frame ships with (format 2 and 3 both
        // carry it). Each row is prefixed with its on-disk byte length, the
        // two length bytes included; inside a row a 0 byte starts a
        // transparent run whose count follows, any other byte is a pixel.
        // The run count is clamped to the row so a stream that overshoots
        // cannot walk the cursor past the row's own end.
        if ((f.Format() & 0x02) != 0) {
            for (int y = 0; y < h; y = y + 1) {
                int rowLen = r.ReadU16();
                if (rowLen < 2) { break; }
                int rowEnd = r.Position() - 2 + rowLen;
                if (rowEnd > this.length) { rowEnd = this.length; }
                int x = 0;
                while (r.Position() < rowEnd && x < w) {
                    int b = r.ReadU8();
                    if (b == 0) {
                        if (r.Position() >= rowEnd) { break; }
                        int count = r.ReadU8();
                        if (count > w - x) { count = w - x; }
                        x = x + count;     // buffer starts zeroed = transparent
                    } else {
                        buf[y * w + x] = (byte)b;
                        x = x + 1;
                    }
                }
                r.Seek(rowEnd);
            }
            return buf;
        }

        if (f.Format() == 0) {
            r.Skip(2);                 // frame lead bytes, not pixel data
        }
        int total = w * h;
        for (int i = 0; i < total; i = i + 1) {
            buf[i] = (byte)r.ReadU8();
        }
        return buf;
    }

    /// <summary>Decodes a frame and composes it onto the file's canvas, so a
    /// frame that ships a sub-rect lands where the file places it and the
    /// returned indices always span Width() x Height().</summary>
    byte[] DecodeFrameCanvas(int index) {
        ShpFrame f = this.FrameAt(index);
        if (f == null) { return new byte[1]; }
        byte[] buf = this.DecodeFrame(index);
        if (f.Width() == this.width && f.Height() == this.height
            && f.X() == 0 && f.Y() == 0) {
            return buf;
        }
        return this.PlaceFrame(buf, f, f.Width(), f.Height());
    }

    /// <summary>Blits a frame-sized decode onto the file-canvas-sized
    /// buffer at the frame's offset.</summary>
    byte[] PlaceFrame(byte[] buf, ShpFrame f, int fw, int fh) {
        byte[] canvas = new byte[this.width * this.height + 1];
        for (int y = 0; y < fh; y = y + 1) {
            int dy = f.Y() + y;
            if (dy < 0 || dy >= this.height) { continue; }
            for (int x = 0; x < fw; x = x + 1) {
                int dx = f.X() + x;
                if (dx < 0 || dx >= this.width) { continue; }
                canvas[dy * this.width + dx] = buf[y * fw + x];
            }
        }
        return canvas;
    }
}
