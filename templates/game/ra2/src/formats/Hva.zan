using System;
using System.Collections.Generic;

namespace Ra2.Formats;

// Westwood HVA -- the per-limb skeletal animation track that ships beside a
// VXL model (<MODEL>.hva). Each file holds one matrix list per named section
// (the VXL limb's name, e.g. "TURRET", "BARREL"), one 3x4 matrix per frame.
// The renderer composes a limb's geometry through its section's matrix for
// the current frame, which is what makes a tank's turret swing and its
// barrel elevate instead of the whole hull turning.
//
// Ported from the reference engine's data/HvaFile.ts + data/hva/Section.ts.
//
// Layout:
//   signature  : 16 bytes, NUL padded ("HVASection" is typical)
//   numFrames  : i32
//   numSections: i32
//   names      : numSections * 16 bytes, NUL padded
//   frames     : numFrames * numSections * (12 * f32)
// Each matrix is 3 rows of 4 floats, read row-major, then the fourth row is
// appended as (0,0,0,1) and the whole thing transposed -- matching the
// reference's readMatrix, which keeps the same column-major convention the
// VXL renderer expects.
class HvaSection {
    string name;
    // Flat frame-major storage: frame f's 16 matrix entries start at f * 16.
    List<double> mats;

    static HvaSection Create(string name, int frames) {
        HvaSection s = new HvaSection();
        s.name = name;
        s.mats = new List<double>();
        for (int i = 0; i < frames * 16; i = i + 1) { s.mats.Add(0.0); }
        s.mats[15] = 1.0;
        return s;
    }

    string Name() { return this.name; }

    /// <summary>The 16 entries of one frame's matrix, or null when the frame
    /// is out of range.</summary>
    List<double> Matrix(int frame) {
        if (frame < 0 || (frame + 1) * 16 > this.mats.Count) { return null; }
        List<double> m = new List<double>();
        for (int i = 0; i < 16; i = i + 1) {
            m.Add(this.mats[frame * 16 + i]);
        }
        return m;
    }

    int FrameCount() { return this.mats.Count / 16; }
}

class HvaFile {
    List<HvaSection> sections;

    static HvaFile Parse(string data, int length) {
        HvaFile h = new HvaFile();
        h.sections = new List<HvaSection>();
        BinaryReader r = BinaryReader.FromBuffer(data, length);
        if (length < 24) { return h; }
        r.Skip(16);                              // signature, unused
        int numFrames = r.ReadI32();
        int numSections = r.ReadI32();
        if (numFrames <= 0 || numSections <= 0) { return h; }
        // A malformed header must not allocate unbounded memory.
        if (numFrames > 4096 || numSections > 256) { return h; }

        List<string> names = new List<string>();
        for (int i = 0; i < numSections; i = i + 1) {
            names.Add(HvaFile.ReadName(r));
        }
        for (int i = 0; i < numSections; i = i + 1) {
            h.sections.Add(HvaSection.Create(names[i], numFrames));
        }

        // Frames are stored section-fastest: frame 0's sections in order,
        // then frame 1's, and so on.
        for (int f = 0; f < numFrames; f = f + 1) {
            for (int s = 0; s < numSections; s = s + 1) {
                HvaFile.ReadMatrix(r, h.sections[s], f);
            }
        }
        return h;
    }

    /// <summary>Reads one NUL-terminated (or 16-byte-run-out) name.</summary>
    static string ReadName(BinaryReader r) {
        string s = "";
        for (int i = 0; i < 16; i = i + 1) {
            int c = r.ReadU8();
            if (c <= 0) {
                // Consume the padding so the cursor lands on the next field.
                for (int j = i + 1; j < 16; j = j + 1) { r.Skip(1); }
                return s;
            }
            s = s + HvaFile.CharOf(c);
        }
        return s;
    }

    /// <summary>A one-character string holding a byte value. Appending the
    /// int directly would append its decimal digits instead.</summary>
    static string CharOf(int v) {
        byte[] one = new byte[1];
        one[0] = (byte)(v & 0xFF);
        return one.ToStr(0, 1);
    }

    /// <summary>3 rows of 4 floats, then a (0,0,0,1) bottom row, transposed
    /// into the section's flat buffer at frame `f`.</summary>
    static void ReadMatrix(BinaryReader r, HvaSection sec, int f) {
        double[] raw = new double[16];
        raw[15] = 1.0;
        for (int i = 0; i < 12; i = i + 1) {
            raw[i] = HvaFile.ReadF32(r);
        }
        // Transpose: out[col*4+row] = raw[row*4+col].
        int at = f * 16;
        for (int row = 0; row < 4; row = row + 1) {
            for (int col = 0; col < 4; col = col + 1) {
                sec.mats[at + col * 4 + row] = raw[row * 4 + col];
            }
        }
    }

    /// <summary>Little-endian f32 from four bytes. BinaryReader has no float
    /// accessor, and this is the only float field the format needs.</summary>
    static double ReadF32(BinaryReader r) {
        int b0 = r.ReadU8();
        int b1 = r.ReadU8();
        int b2 = r.ReadU8();
        int b3 = r.ReadU8();
        int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        return HvaFile.BitsToDouble(bits);
    }

    static double BitsToDouble(int bits) {
        // Decompose IEEE-754 binary32 into sign / exponent / mantissa.
        int sign = (bits >> 31) & 1;
        int exp = (bits >> 23) & 0xFF;
        int man = bits & 0x7FFFFF;
        double s = sign == 1 ? -1.0 : 1.0;
        if (exp == 0) {
            // Subnormal (or zero): no implicit leading 1.
            return s * HvaFile.Pow2(-126) * ((double)man / 8388608.0);
        }
        if (exp == 255) {
            // Inf / NaN: the format never stores these, but do not divide by
            // zero if a corrupt frame does.
            return man == 0 ? s * 1e308 : 0.0;
        }
        double frac = 1.0 + (double)man / 8388608.0;
        return s * frac * HvaFile.Pow2(exp - 127);
    }

    /// <summary>2^n for integer n, by repeated multiply -- the stdlib has no
    /// pow for the fractional case this format does not need.</summary>
    static double Pow2(int n) {
        double v = 1.0;
        if (n >= 0) {
            for (int i = 0; i < n; i = i + 1) { v = v * 2.0; }
        } else {
            for (int i = 0; i < 0 - n; i = i + 1) { v = v / 2.0; }
        }
        return v;
    }

    int SectionCount() { return this.sections.Count; }

    /// <summary>The section with this name (case-folded), or null. VXL limbs
    /// and HVA sections are matched by name -- "TURRET" to "TURRET".</summary>
    HvaSection Named(string name) {
        for (int i = 0; i < this.sections.Count; i = i + 1) {
            if (HvaFile.Same(this.sections[i].name, name)) {
                return this.sections[i];
            }
        }
        return null;
    }

    HvaSection At(int i) {
        if (i < 0 || i >= this.sections.Count) { return null; }
        return this.sections[i];
    }

    /// <summary>Case-insensitive equality, ASCII only -- the format's names
    /// are ASCII and may differ in case between the VXL and the HVA.</summary>
    static bool Same(string a, string b) {
        if (a == null || b == null) { return false; }
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            if ((a[i] & 0xDF) != (b[i] & 0xDF)) { return false; }
        }
        return true;
    }
}
