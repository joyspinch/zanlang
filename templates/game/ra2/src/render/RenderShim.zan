using System;
using System.Collections.Generic;
using Gui;
using Ra2.Game;


namespace Ra2.Render;

/// <summary>Compatibility draw surface for the RA2 template: the same
/// `SetColor / FillRect / DrawRect / DrawTexture` vocabulary the screens and
/// the HUD were written against, now backed by a Gui Canvas.</summary>
///
/// RA2 used to draw through the SDL kit's renderer. That shell is gone, so
/// this type re-expresses the old call set on Gui.Canvas -- a colour state
/// plus rect/blit primitives -- so the layout code (a few thousand lines of
/// design-space arithmetic) ports unchanged. Coordinates are the game's
/// logical 1280x720 stage; CDraw maps them onto whatever window exists.
///
/// A "texture" here is a canvas image key (the "mem:" key Ra2Ui registers
/// from decoded SHP/PCX art), plus the width/height carried alongside so
/// DrawTexture can scale without a lookup.
class R2Tex {
    string key;
    int w;
    int h;

    static R2Tex Create(string key, int w, int h) {
        R2Tex t = new R2Tex();
        t.key = key;
        t.w = w;
        t.h = h;
        return t;
    }

    string Key() { return this.key; }
    int W() { return this.w; }
    int H() { return this.h; }
    bool Ok() { return this.key != null && this.key.Length > 0; }
}

/// <summary>The renderer stand-in: a current colour and rect/blit drawing.
/// Constructed once per frame from the transient Canvas the host hands the
/// Render callback.</summary>
class R2Canvas {
    Canvas c;
    int cr;
    int cg;
    int cb;
    int ca;

    static R2Canvas Create(Canvas c) {
        R2Canvas r = new R2Canvas();
        r.c = c;
        r.cr = 255;
        r.cg = 255;
        r.cb = 255;
        r.ca = 255;
        return r;
    }

    void SetColor(int r, int g, int b, int a) {
        this.cr = r;
        this.cg = g;
        this.cb = b;
        this.ca = a;
    }

    /// <summary>Current colour, alpha folded in as a plain 0xAARRGGBB.
    /// The software raster honours alpha, so a translucent overlay drawn
    /// over chrome dims it the way the SDL blend did.</summary>
    int Cur() {
        return this.ca * 16777216 + this.cr * 65536 + this.cg * 256 + this.cb;
    }

    /// <summary>The underlying canvas. Needed by the few call sites that use
    /// a Canvas primitive this shim does not wrap (text, rounded panels).</summary>
    Canvas Cv() { return this.c; }

    void FillRect(int x, int y, int w, int h) {
        if (w <= 0 || h <= 0) { return; }
        if (this.ca >= 255) {
            CDraw.FillRect(this.c, x, y, w, h, this.Cur());
        } else {
            // CDraw.FillRect maps the rect; translucent fills go straight to
            // the canvas so the alpha survives.
            this.Cv().FillRect(CDraw.MapX(x + CDraw.originX),
                            CDraw.MapY(y + CDraw.originY),
                            CDraw.MapW(w), CDraw.MapW(h), this.Cur());
        }
    }

    void DrawRect(int x, int y, int w, int h) {
        this.Cv().DrawRect(CDraw.MapX(x + CDraw.originX),
                        CDraw.MapY(y + CDraw.originY),
                        CDraw.MapW(w), CDraw.MapW(h), this.Cur(), 1);
    }

    /// <summary>Scales a registered canvas image into (x,y,w,h). A key the
    /// canvas's FIFO image store has evicted re-registers from its retained
    /// bytes first -- without that, fixed UI art silently stopped drawing
    /// once newer registrations pushed it out of the 64-entry store.</summary>
    void DrawTexture(R2Tex t, int x, int y, int w, int h) {
        if (t == null || !t.Ok()) { return; }
        if (Canvas.ImageWidth(t.Key()) <= 0) {
            t = Ra2Ui.Rebind(t);
            if (t == null) { return; }
        }
        this.Cv().BlitImage(t.Key(), CDraw.MapX(x + CDraw.originX),
                            CDraw.MapY(y + CDraw.originY), CDraw.MapW(w),
                            CDraw.MapW(h), 0, 0, 0, 0);
    }

    /// <summary>The stage size the renderer was created at -- the game's
    /// logical resolution, which the self-test's screenshot path uses.</summary>
    int OutW() { return CDraw.stageW; }
    int OutH() { return CDraw.stageH; }
}

/// <summary>Anchored text drawing: the old kit's Text helper, on Canvas.
/// scale 1/2/3 maps to font pixel sizes 12/20/30.</summary>
class R2Text {
    static int Px(int scale) {
        if (scale <= 1) { return 12; }
        if (scale == 2) { return 20; }
        return 30;
    }

    static void Draw(R2Canvas r, string s, int x, int y, int scale,
                     int cr, int cg, int cb, int ca) {
        r.Cv().DrawText(CDraw.MapX(x + CDraw.originX),
                     CDraw.MapY(y + CDraw.originY), s,
                     ca * 16777216 + cr * 65536 + cg * 256 + cb, R2Text.Px(scale));
    }

    static void DrawCentered(R2Canvas r, string s, int cx, int y, int scale,
                             int cr, int cg, int cb, int ca) {
        int w = Canvas.MeasureText(s, R2Text.Px(scale));
        R2Text.Draw(r, s, cx - w / 2, y, scale, cr, cg, cb, ca);
    }

    static void DrawShadow(R2Canvas r, string s, int x, int y, int scale,
                           int cr, int cg, int cb, int ca) {
        R2Text.Draw(r, s, x + 2, y + 2, scale, 0, 0, 0, 190);
        R2Text.Draw(r, s, x, y, scale, cr, cg, cb, ca);
    }

    static void DrawCenteredShadow(R2Canvas r, string s, int cx, int y,
                                   int scale, int cr, int cg, int cb, int ca) {
        int w = Canvas.MeasureText(s, R2Text.Px(scale));
        R2Text.DrawShadow(r, s, cx - w / 2, y, scale, cr, cg, cb, ca);
    }

    static int Width(R2Canvas r, string s, int scale) {
        return Canvas.MeasureText(s, R2Text.Px(scale));
    }
}

/// <summary>Panel drawing: the old kit's Draw helper (rounded slabs and
/// outlines), on Canvas.</summary>
class R2Panel {
    static void RoundRectFill(R2Canvas r, int x, int y, int w, int h, int rad,
                              int cr, int cg, int cb, int ca) {
        if (w <= 0 || h <= 0) { return; }
        r.Cv().FillRoundRect(CDraw.MapX(x + CDraw.originX),
                          CDraw.MapY(y + CDraw.originY),
                          CDraw.MapW(w), CDraw.MapW(h), CDraw.MapW(rad),
                          ca * 16777216 + cr * 65536 + cg * 256 + cb);
    }

    /// <summary>Rounded outline. The old kit spelled it
    /// (x,y,w,h,rad,thickness,r,g,b,a); kept in that order for the call
    /// sites.</summary>
    static void RoundRectStroke(R2Canvas r, int x, int y, int w, int h,
                                int rad, int th, int cr, int cg, int cb,
                                int ca) {
        if (w <= 0 || h <= 0) { return; }
        r.Cv().DrawRoundRect(CDraw.MapX(x + CDraw.originX),
                          CDraw.MapY(y + CDraw.originY),
                          CDraw.MapW(w), CDraw.MapW(h), CDraw.MapW(rad),
                          ca * 16777216 + cr * 65536 + cg * 256 + cb, th);
    }

    static bool PointIn(int px, int py, int x, int y, int w, int h) {
        return px >= x && px < x + w && py >= y && py < y + h;
    }

    /// <summary>Fill the frame with a dark chrome field: the stand-in
    /// backdrop used when the install carries no menu art. When a path is
    /// given and decodes, it is drawn instead.</summary>
    static void Backdrop(R2Canvas r, string bgPath, int w, int h) {
        if (bgPath != null && bgPath.Length > 0) {
            r.Cv().BlitImage(bgPath, CDraw.MapX(CDraw.originX),
                             CDraw.MapY(CDraw.originY), CDraw.MapW(w),
                             CDraw.MapW(h), 0, 0, 0, 0);
            return;
        }
        r.SetColor(18, 20, 26, 255);
        r.FillRect(0, 0, w, h);
        r.SetColor(28, 32, 42, 255);
        r.FillRect(0, 0, w, 4);
        r.FillRect(0, h - 4, w, 4);
    }
}
