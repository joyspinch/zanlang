using System;
using System.Collections.Generic;
using Gui;
using Ra2.Assets;

namespace Ra2.Render;

/// <summary>Direct-draw helpers over the Gui canvas: the small vocabulary
/// the game used to get from its renderer (fill, outline, blit, text), now
/// expressed on Gui.Canvas instead.</summary>
///
/// The game draws at its own logical resolution (1280x720); CDraw's stage
/// viewport scales that to whatever the window is, so every call here goes
/// through CDraw.MapX/MapY/MapW like the other Gui templates do. Colours are
/// 0xAARRGGBB.
class R2Draw {
    static int Argbe(int r, int g, int b) {
        return 255 * 16777216 + r * 65536 + g * 256 + b;
    }

    /// <summary>Opaque colour from a 0xRRGGBB literal.</summary>
    static int Rgb(int v) {
        return 255 * 16777216 + (v & 0xFF0000) + (v & 0x00FF00) + (v & 0xFF);
    }

    static void Fill(Canvas c, int x, int y, int w, int h, int r, int g, int b) {
        CDraw.FillRect(c, x, y, w, h, R2Draw.Argbe(r, g, b));
    }

    static void Rect(Canvas c, int x, int y, int w, int h, int r, int g, int b) {
        c.DrawRect(CDraw.MapX(x), CDraw.MapY(y), CDraw.MapW(w), CDraw.MapW(h),
                   R2Draw.Argbe(r, g, b), 1);
    }

    /// <summary>An RGBA texture registered as a canvas image, drawn 1:1 at
    /// (x,y). The key is the one Ra2Ui.RegisterRgba handed back.</summary>
    static void Blit(Canvas c, string img, int x, int y, int w, int h) {
        if (img == null || img.Length == 0) { return; }
        c.BlitImage(img, CDraw.MapX(x), CDraw.MapY(y), CDraw.MapW(w),
                    CDraw.MapW(h), 0, 0, 0, 0);
    }

    static void Text(Canvas c, string s, int x, int y, int r, int g, int b,
                     int fontSize) {
        c.DrawText(CDraw.MapX(x), CDraw.MapY(y), s,
                   R2Draw.Argbe(r, g, b), fontSize);
    }

    static void TextIn(Canvas c, string s, int x, int y, int w, int h,
                       int r, int g, int b, int fontSize) {
        c.DrawTextCentered(CDraw.MapX(x), CDraw.MapY(y), CDraw.MapW(w),
                           CDraw.MapW(h), s, R2Draw.Argbe(r, g, b), fontSize);
    }

    static int TextW(string s, int fontSize) {
        return Canvas.MeasureText(s, fontSize);
    }

    static int TextH(int fontSize) { return Canvas.FontHeight(fontSize); }
}
