using System;
using System.Collections.Generic;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

namespace Ra2.Render;

/// <summary>The retail right-hand sidebar shell, drawn from the install's own
/// SIDEC01/SIDEC02 art: the credits strip, the top strip, the radar bezel,
/// the side1 cap, the repeating side2 band, the side3 footer and the addon
/// strip, plus the buttons (diplomacy, options, repair, sell, page up/down),
/// the category tabs and the progress clock that rides the cameo card. Every
/// piece decodes under the SIDEBAR.PAL that ships inside the same side mix,
/// and the Soviet shell loads from SIDEC02.MIX so each house wears its own
/// chrome (Yuri ships no shell of its own and wears the Soviet one, like the
/// retail game). A piece that comes back empty caches as a null texture, and
/// the shell reports not-ok when the side mixes are absent entirely, so an
/// install without them falls back to the drawn sidebar.</summary>
class SidebarShell {
    Vfs vfs;
    string sideMix;         // "SIDEC02.MIX" for the Soviet set, else SIDEC01
    Palette pal;            // the side's own SIDEBAR.PAL, loaded on first use
    List<string> pieceKeys; // "NAME.SHP#frame" -> cached texture
    List<Texture> pieceTex;
    List<string> countKeys; // "NAME.SHP" -> cached frame count
    List<int> counts;
    bool ok;

    static SidebarShell Load(Vfs vfs, bool soviet) {
        SidebarShell s = new SidebarShell();
        s.vfs = vfs;
        s.sideMix = soviet ? "SIDEC02.MIX" : "SIDEC01.MIX";
        s.pieceKeys = new List<string>();
        s.pieceTex = new List<Texture>();
        s.countKeys = new List<string>();
        s.counts = new List<int>();
        // The shell stands or falls with its background pieces; without the
        // side mix this install has no original sidebar to draw.
        s.ok = s.Piece("SIDE1.SHP", 0) != null
            && s.Piece("CREDITS.SHP", 0) != null;
        return s;
    }

    bool Ok() { return this.ok; }

    int W(string name) {
        Texture t = this.Piece(name, 0);
        return t == null ? 0 : t.Width();
    }

    int H(string name) {
        Texture t = this.Piece(name, 0);
        return t == null ? 0 : t.Height();
    }

    /// <summary>How many frames a piece carries (the progress clock's spin,
    /// the buttons' pressed states), cached so the mix is parsed once. The
    /// name may come with or without its .SHP tail.</summary>
    int FrameCount(string name) {
        for (int i = 0; i < this.countKeys.Count; i = i + 1) {
            if (this.countKeys[i] == name) { return this.counts[i]; }
        }
        string baseName = name;
        if (baseName.Length >= 4
            && baseName.Substring(baseName.Length - 4) == ".SHP") {
            baseName = baseName.Substring(0, baseName.Length - 4);
        }
        int n = 0;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.Raw(baseName + ".SHP", len);
        if (len[0] > 0) {
            n = ShpImage.Parse(raw, len[0]).FrameCount();
        }
        this.countKeys.Add(name);
        this.counts.Add(n);
        return n;
    }

    /// <summary>One frame of one piece, decoded under the side's SIDEBAR.PAL.
    /// Missing pieces cache as null the same way the object art does.</summary>
    Texture Piece(string name, int frame) {
        string key = name + "#" + Convert.ToString(frame);
        for (int i = 0; i < this.pieceKeys.Count; i = i + 1) {
            if (this.pieceKeys[i] == key) { return this.pieceTex[i]; }
        }
        Texture tex = null;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.Raw(name, len);
        if (len[0] > 0) {
            if (this.pal == null) { this.pal = this.SidePalette(); }
            if (this.pal != null) {
                ShpImage shp = ShpImage.Parse(raw, len[0]);
                if (frame < shp.FrameCount()) {
                    tex = Texture.FromIndexedShp(
                        shp.DecodeFrameCanvas(frame),
                        shp.Width(), shp.Height(), this.pal);
                }
            }
        }
        this.pieceKeys.Add(key);
        this.pieceTex.Add(tex);
        return tex;
    }

    /// <summary>Reads a piece from this side's own mix, falling back to the
    /// plain first-hit lookup (a loose override, or the other side's set on
    /// an install that only ships one).</summary>
    byte[] Raw(string name, List<int> len) {
        byte[] raw = this.vfs.ReadFrom(this.sideMix, name, len);
        if (raw != null && len[0] > 0) { return raw; }
        return this.vfs.Read(name, len);
    }

    Palette SidePalette() {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.Raw("SIDEBAR.PAL", len);
        if (len[0] <= 0) { return null; }
        return Palette.Parse(raw, len[0]);
    }

    /// <summary>Diagnostics: one decoded piece as a P6 PPM so a suspect
    /// plate can be inspected without a running renderer.</summary>
    void DumpPiece(Texture t, string path) {
        if (t == null) { return; }
        int w = t.Width();
        int h = t.Height();
        byte[] px = t.Pixels();
        string hdr = "P6\n" + Convert.ToString(w) + " "
            + Convert.ToString(h) + "\n255\n";
        byte[] ppm = new byte[hdr.Length + w * h * 3];
        for (int i = 0; i < hdr.Length; i = i + 1) {
            ppm[i] = (byte)hdr[i];
        }
        int o = hdr.Length;
        for (int p = 0; p < w * h; p = p + 1) {
            ppm[o + p * 3] = px[p * 4];
            ppm[o + p * 3 + 1] = px[p * 4 + 1];
            ppm[o + p * 3 + 2] = px[p * 4 + 2];
        }
        File.WriteAllBytes(path, ppm);
    }
}
