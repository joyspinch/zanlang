using System;
using System.Collections.Generic;
using System.IO;
using Ra2.Formats;

namespace Ra2.Assets;

/// <summary>Mounts an install's archives and serves the parsed assets on top.</summary>
///
/// Rules, art and the string table are read once at start-up; palettes and
/// shapes are parsed on first use and kept, since the same few palettes back
/// every tile and unit drawn in a frame.
class AssetDb {
    Vfs vfs;
    IniDocument rules;
    IniDocument art;
    CsfTable strings;
    List<string> palNames;
    List<Palette> palCache;
    List<string> shpNames;
    List<ShpImage> shpCache;

    /// The archives making up a Red Alert 2 install, highest priority first.
    /// Expansion archives are listed too and skipped when absent, so this works
    /// for a base-game install as well as one with Yuri's Revenge.
    static List<string> ArchiveOrder() {
        List<string> l = new List<string>();
        l.Add("expandmd03.mix");
        l.Add("expandmd02.mix");
        l.Add("expandmd01.mix");
        l.Add("expandmd99.mix");
        l.Add("ra2md.mix");
        l.Add("ra2.mix");
        l.Add("langmd.mix");
        l.Add("language.mix");
        l.Add("multi.mix");
        l.Add("multimd.mix");
        l.Add("maps01.mix");
        l.Add("maps02.mix");
        l.Add("mapsmd03.mix");
        l.Add("theme.mix");
        l.Add("thememd.mix");
        return l;
    }

    /// Archives nested inside ra2.mix (and its expansion counterpart) that hold
    /// the assets this demo draws: rules and art in local, unit and structure
    /// shapes in conquer and generic, terrain in the iso* and theatre archives.
    static List<string> NestedOrder() {
        List<string> l = new List<string>();
        // Base game first, Yuri's Revenge overrides after: later mounts
        // lose the lookup race, and the shipped install is a YR one. The
        // MD generic archives (LOCALMD/CONQMD/CACHEMD) and the YR theaters
        // only enter the VFS through this list -- before they were added,
        // everything they carry hashed as "absent".
        l.Add("LOCAL.MIX");
        l.Add("LOCALMD.MIX");
        l.Add("CONQUER.MIX");
        l.Add("CONQUERMD.MIX");
        l.Add("CONQMD.MIX");
        l.Add("GENERIC.MIX");
        l.Add("ISOTEMP.MIX");
        l.Add("TEMPERAT.MIX");
        l.Add("ISOSNOW.MIX");
        l.Add("SNOW.MIX");
        l.Add("ISOURB.MIX");
        l.Add("URBAN.MIX");
        l.Add("ISONURB.MIX");
        l.Add("NEWURBAN.MIX");
        l.Add("ISODES.MIX");
        l.Add("DESERT.MIX");
        l.Add("ISOLUN.MIX");
        l.Add("LUNAR.MIX");
        l.Add("SIDEC01.MIX");
        l.Add("SIDEC02.MIX");
        // The sidebar's unit portraits (<ART>ICON.SHP) live in the cameo
        // archives: base-game portraits in CAMEO.MIX inside language.mix,
        // Yuri's Revenge additions in CAMEOMD.MIX inside langmd.mix. Before
        // these were mounted, every cameo name hashed as "absent" and the
        // sidebar fell back to field art.
        // The shell screens and their dialog chrome (MNSCRNL/MPASCRN/BKGD
        // families) ship in the neutral archives, and the shared terrain
        // objects live in the iso-generic pair; all five nested.
        l.Add("NEUTRAL.MIX");
        l.Add("NTRLMD.MIX");
        l.Add("ISOGEN.MIX");
        l.Add("ISOGENMD.MIX");
        l.Add("GENERMD.MIX");
        l.Add("CAMEO.MIX");
        l.Add("CAMEOMD.MIX");
        l.Add("CACHE.MIX");
        l.Add("CACHEMD.MIX");
        return l;
    }

    /// <summary>Mounts every archive found under <paramref name="dataDir"/>.
    /// Loose files in that directory win over archived ones, matching how the
    /// game lets you drop a replacement next to the executable.</summary>
    static Vfs MountInstall(string dataDir) {
        Vfs vfs = Vfs.Create();
        vfs.MountDirectory(dataDir);
        List<string> nested = AssetDb.NestedOrder();
        List<string> order = AssetDb.ArchiveOrder();
        for (int i = 0; i < order.Count; i = i + 1) {
            vfs.MountArchiveFile(dataDir, order[i], nested);
        }
        return vfs;
    }

    static AssetDb Load(Vfs vfs) {
        AssetDb db = new AssetDb();
        db.vfs = vfs;
        db.palNames = new List<string>();
        db.palCache = new List<Palette>();
        db.shpNames = new List<string>();
        db.shpCache = new List<ShpImage>();
        db.rules = db.LoadIni("RULES.INI");
        db.rules = AssetDb.LayerIni(db.rules, db.LoadIni("RULESMD.INI"));
        db.art = db.LoadIni("ART.INI");
        db.art = AssetDb.LayerIni(db.art, db.LoadIni("ARTMD.INI"));
        db.strings = db.LoadCsf("RA2.CSF");
        CsfTable mdStrings = db.LoadCsf("RA2MD.CSF");
        if (mdStrings != null) { db.strings = mdStrings; }
        return db;
    }

    /// <summary>Layers an expansion INI over its base: the expansion's keys
    /// override, everything else keeps the base value -- the same last-wins
    /// rule the Westwood engine applies.</summary>
    static IniDocument LayerIni(IniDocument baseDoc, IniDocument over) {
        if (over == null || over.Count() == 0) { return baseDoc; }
        if (baseDoc == null || baseDoc.Count() == 0) { return over; }
        for (int s = 0; s < over.Count(); s = s + 1) {
            Ra2.Formats.IniSection src = over.SectionAt(s);
            Ra2.Formats.IniSection dst = baseDoc.Require(src.Name());
            for (int e = 0; e < src.Count(); e = e + 1) {
                Ra2.Formats.IniEntry entry = src.EntryAt(e);
                dst.Set(entry.Key(), entry.Value());
            }
        }
        return baseDoc;
    }

    Vfs Files() { return this.vfs; }
    IniDocument Rules() { return this.rules; }
    IniDocument Art() { return this.art; }
    CsfTable Strings() { return this.strings; }

    /// <summary>Parses a shipped INI out of the vfs. The text does not always
    /// begin at byte 0: this install's loose ARTMD.INI opens with a ~940-byte
    /// UTF-16 comment block whose interior NULs end a naive byte-to-string
    /// conversion three characters in, so the whole of Yuri's Revenge's art
    /// (the Guardian GI's portrait, the shipyard's, dozens more) parsed as an
    /// empty document and every one of its overrides was silently dropped.
    /// The original reader is line-based and simply ignores anything that is
    /// not a section or a key, so start the text at the first line-opening
    /// '[' -- identical for a clean file, a fix for this one.</summary>
    IniDocument LoadIni(string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] == 0) { return IniDocument.Create(); }
        int start = AssetDb.IniTextStart(raw, len[0]);
        return IniParser.Parse(raw.ToStr(start, len[0] - start));
    }

    /// <summary>Index of the first '[' that opens a line, or 0. Bytes before
    /// it are a non-text prefix (see LoadIni).</summary>
    static int IniTextStart(byte[] raw, int len) {
        for (int i = 0; i < len; i = i + 1) {
            if (raw[i] != 91) { continue; }         // '['
            if (i == 0) { return 0; }
            int prev = raw[i - 1];
            if (prev == 10 || prev == 13) { return i; }
        }
        return 0;
    }

    CsfTable LoadCsf(string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] == 0) { return null; }
        return CsfTable.Parse(raw, len[0]);
    }

    // Palette and ShpImage keep the buffer they were parsed from rather than
    // copying it; the buffer is ARC-managed, so it stays alive exactly as long
    // as the parsed object holds it.

    /// <summary>A palette by file name, e.g. "isotem.pal". Null when absent.</summary>
    Palette PaletteNamed(string name) {
        int i = this.IndexOfName(this.palNames, name);
        if (i >= 0) { return this.palCache[i]; }
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        Palette p = null;
        if (len[0] > 0) { p = Palette.Parse(raw, len[0]); }
        this.palNames.Add(name);
        this.palCache.Add(p);
        return p;
    }

    /// <summary>A map by file name, e.g. "MP02T2.MAP". Null when absent.</summary>
    MapFile MapNamed(string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] == 0) { return null; }
        // The parsed document copies what it needs, so the ~200 KB of map text
        // is released as soon as this returns.
        return MapFile.Parse(raw);
    }

    /// <summary>The multiplayer maps present in the install. Retail ships a
    /// catalog INI beside the map archives -- missions.pkt in multi.mix, its
    /// Yuri's Revenge counterpart in multimd.mix -- whose [MultiMaps] section
    /// lists the official maps by key, each key's section naming the file
    /// with File=. This is the enumeration the original engine uses; probing
    /// the MPnnTk scheme stays only as a fallback for trimmed installs.</summary>
    List<string> SkirmishMaps() {
        List<string> found = new List<string>();
        List<string> order = AssetDb.ArchiveOrder();
        for (int i = 0; i < order.Count; i = i + 1) {
            string stem = order[i];
            int dot = stem.Length - 4;
            if (dot > 0) {
                AssetDb.AddPktMaps(this.vfs, found,
                    stem.Substring(0, dot) + ".PKT");
            }
        }
        AssetDb.AddPktMaps(this.vfs, found, "MISSIONS.PKT");
        AssetDb.AddPktMaps(this.vfs, found, "MISSIONMD.PKT");
        if (found.Count > 0) { return found; }
        int i = 1;
        while (i <= 40) {
            string num = Convert.ToString(i);
            if (i < 10) { num = "0" + num; }
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T1.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T2.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T3.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T4.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T5.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T6.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T7.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T8.MAP");
            AssetDb.ProbeMap(this.vfs, found, "MP" + num + "T9.MAP");
            i = i + 1;
        }
        return found;
    }

    /// <summary>Reads one catalog: every value under [MultiMaps] is a map
    /// stem whose section (when present) names the file with File=; the
    /// stem itself plus ".map" otherwise. Catalogs repeat entries across
    /// archives, so duplicates collapse.</summary>
    static void AddPktMaps(Vfs vfs, List<string> found, string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read(name, len);
        if (len[0] == 0) { return; }
        int start = AssetDb.IniTextStart(raw, len[0]);
        IniDocument pkt = IniParser.Parse(raw.ToStr(start, len[0] - start));
        Ra2.Formats.IniSection list = pkt.Section("MultiMaps");
        if (list == null) { return; }
        for (int i = 0; i < list.Count(); i = i + 1) {
            string key = list.EntryAt(i).Value();
            if (key == null || key.Length == 0) { continue; }
            Ra2.Formats.IniSection entry = pkt.Section(key);
            string file = entry == null ? "" : entry.Get("File");
            if (file.Length == 0) { file = key + ".map"; }
            file = file.ToUpper();
            if (file.IndexOf(".MAP") < 0) { file = file + ".MAP"; }
            bool seen = false;
            for (int k = 0; k < found.Count; k = k + 1) {
                if (found[k] == file) { seen = true; break; }
            }
            if (!seen && vfs.Contains(file)) { found.Add(file); }
        }
    }

    static void ProbeMap(Vfs vfs, List<string> found, string name) {
        if (vfs.Contains(name)) { found.Add(name); }
    }

    /// <summary>A shape by file name, e.g. "gi.shp". Null when absent.</summary>
    ShpImage ShapeNamed(string name) {
        int i = this.IndexOfName(this.shpNames, name);
        if (i >= 0) { return this.shpCache[i]; }
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        ShpImage s = null;
        if (len[0] > 0) { s = ShpImage.Parse(raw, len[0]); }
        this.shpNames.Add(name);
        this.shpCache.Add(s);
        return s;
    }

    int IndexOfName(List<string> names, string name) {
        for (int i = 0; i < names.Count; i = i + 1) {
            if (names[i] == name) { return i; }
        }
        return -1;
    }

    void Close() {
        this.vfs.Close();
    }
}
