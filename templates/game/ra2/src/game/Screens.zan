using System;
using System.Collections.Generic;
using Gui;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Render;
using Ra2.Game;

namespace Ra2.Ui;

/// <summary>The game's own shell art, loaded from the player's install.</summary>
///
/// The shell screens are composed from SHP sprites over palettes, exactly as
/// the reference decodes them (ui_slots.rs): the 800x600 base is
/// MNSCRNL.SHP + shell.pal, the right chrome is SDTP/SDWRNANM (over
/// shell.pal), SDBTNBKGD (shell2.pal), SDBTM and LWSCRNL (shell.pal), and
/// the menu buttons are SDBTNANM.SHP + sdbtnanm.pal -- frame 2 at rest,
/// frame 4 pressed, hover changes no frame. TITLE.PCX is only the startup
/// splash; the menu never draws it. DBAK6440.PCX stays as the fallback
/// dialog backdrop for screens the reference composes differently.
class ShellArt {
    R2Tex title;
    R2Tex load;
    R2Tex[] btns;    // menu button plates, indexed by state
    R2Tex dialog;
    // Reference shell chrome (decoded at native size; geometry is the
    // layout's business).
    R2Tex shellBg;       // mnscrnl.shp + shell.pal, 800x600 canvas
    R2Tex shellBg632;    // same SHP cropped to the art area (632x570)
    R2Tex panelTop;      // sdtp.shp + shell.pal
    R2Tex warnAnim;      // sdwrnanm.shp + shell.pal
    R2Tex panelTile;     // sdbtnbkgd.shp + shell2.pal
    R2Tex panelBottom;   // sdbtm.shp + shell.pal
    R2Tex lowerStrip;    // lwscrnl.shp + shell.pal
    R2Tex modalBg;       // pudlgbgn.shp + dialogn.pal (exit confirm)
    R2Tex msgBtns;       // mnbttn.shp + mainbttn.pal (up / pressed)
    // The sidebar menu slots: SDBTNANM.SHP's 17 frames over SDBTNANM.PAL,
    // the button plate the reference's MenuSlotAnimationRunner indexes by
    // state (`MenuSlotAnimationRunner.ts:68-98`). Distinct from msgBtns --
    // MNBTTN is the in-dialog button, this is the menu column.
    R2Tex[] slotFrames;  // sdbtnanm.shp + sdbtnanm.pal, frames 0..16
    R2Tex[] sdTp;        // sdtp.shp + shell.pal, frame 0 closed / 1 open
    R2Tex[] sdWrnTmp;    // sdwrntmp.shp + shell.pal, the slide overlay
    R2Tex[] mpBtn;       // sdmpbtn.shp + shell.pal, the MP slot
    R2Tex[] wrnAnim;     // sdwrnanm.shp + shell.pal, the right-panel loop
    R2Tex fsBkgDlg;      // fsbkgdlg.shp + fsscrn.pal (campaign page base)
    R2Tex fsAllied;      // fsalg.shp + fsscrn.pal
    R2Tex fsTutorial;    // fsbclg.shp + fsscrn.pal
    R2Tex fsSoviet;      // fsslg.shp + fsscrn.pal
    bool loaded;

    static ShellArt Load(Vfs vfs) {
        ShellArt a = new ShellArt();
        a.loaded = false;
        a.title = ShellArt.LoadPcx(vfs, "TITLE.PCX", "ra2:title");
        a.load = ShellArt.LoadPcx(vfs, "LOAD.PCX", "ra2:load");
        a.dialog = ShellArt.LoadPcx(vfs, "DBAK6440.PCX", "ra2:dialog");
        a.btns = ShellArt.LoadButtons(vfs);
        a.shellBg = ShellArt.LoadShpFull(vfs, "MNSCRNL.SHP", "shell.pal",
                                         "ra2:shellbg");
        a.shellBg632 = ShellArt.LoadShpArea(vfs, "MNSCRNL.SHP", "shell.pal",
                                            "ra2:shellbg632", 0, 0, 632, 570);
        a.panelTop = ShellArt.LoadShpFrame(vfs, "SDTP.SHP", "shell.pal",
                                           0, "ra2:sdtp");
        a.warnAnim = ShellArt.LoadShpFrame(vfs, "SDWRNANM.SHP", "shell.pal",
                                           0, "ra2:sdwrnanm");
        // The multi-frame shell sheets the reference's animation runners walk.
        a.slotFrames = ShellArt.LoadFrames(vfs, "SDBTNANM.SHP", "SDBTNANM.PAL",
                                           "ra2:slot", 17);
        a.sdTp = ShellArt.LoadFrames(vfs, "SDTP.SHP", "shell.pal",
                                     "ra2:sdtpf", 2);
        a.sdWrnTmp = ShellArt.LoadFrames(vfs, "SDWRNTMP.SHP", "shell.pal",
                                         "ra2:sdwrntmp", 6);
        a.mpBtn = ShellArt.LoadFrames(vfs, "SDMPBTN.SHP", "shell.pal",
                                      "ra2:sdmpbtn", 7);
        a.wrnAnim = ShellArt.LoadFrames(vfs, "SDWRNANM.SHP", "shell.pal",
                                        "ra2:wrnf", 1);
        a.panelTile = ShellArt.LoadShpFrame(vfs, "SDBTNBKGD.SHP", "shell2.pal",
                                            0, "ra2:sdbtnbkgd");
        a.panelBottom = ShellArt.LoadShpFrame(vfs, "SDBTM.SHP", "shell.pal",
                                              0, "ra2:sdbtm");
        a.lowerStrip = ShellArt.LoadShpFrame(vfs, "LWSCRNL.SHP", "shell.pal",
                                             0, "ra2:lwscrnl");
        a.modalBg = ShellArt.LoadShpFrame(vfs, "PUDLGBGN.SHP", "dialogn.pal",
                                          0, "ra2:pudlgbgn");
        a.msgBtns = ShellArt.LoadShpFrame(vfs, "MNBTTN.SHP", "mainbttn.pal",
                                          0, "ra2:msgbtn");
        a.fsBkgDlg = ShellArt.LoadShpFull(vfs, "FSBKGDLG.SHP", "fsscrn.pal",
                                          "ra2:fsbkgdlg");
        a.fsAllied = ShellArt.LoadShpFull(vfs, "FSALG.SHP", "fsscrn.pal",
                                          "ra2:fsalg");
        a.fsTutorial = ShellArt.LoadShpFull(vfs, "FSBCLG.SHP", "fsscrn.pal",
                                            "ra2:fsbclg");
        a.fsSoviet = ShellArt.LoadShpFull(vfs, "FSSLG.SHP", "fsscrn.pal",
                                          "ra2:fsslg");
        if (a.shellBg != null || a.panelTop != null) { a.loaded = true; }
        if (a.title != null || a.load != null || a.dialog != null
         || a.btns != null) {
            a.loaded = true;
        }
        return a;
    }

    /// <summary>One SHP frame decoded onto its file's canvas and registered
    /// under a stable key: the path the reference's panel slots take (a
    /// frame that ships a sub-rect lands where the file places it). Null
    /// when the install does not carry the pair.</summary>
    static R2Tex LoadShpFrame(Vfs vfs, string shpName, string palName,
                              int frame, string key) {
        if (!vfs.Contains(shpName) || !vfs.Contains(palName)) { return null; }
        List<int> plen = new List<int>();
        plen.Add(0);
        byte[] praw = vfs.Read(palName, plen);
        if (plen[0] < 768) { return null; }
        Palette pal = Palette.Parse(praw, plen[0]);

        List<int> slen = new List<int>();
        slen.Add(0);
        byte[] sraw = vfs.Read(shpName, slen);
        if (slen[0] == 0) { return null; }
        ShpImage shp = ShpImage.Parse(sraw, slen[0]);
        if (frame < 0 || frame >= shp.FrameCount()) { return null; }
        byte[] idx = shp.DecodeFrameCanvas(frame);
        Texture tex = Texture.FromIndexedShp(idx, shp.Width(), shp.Height(),
                                             pal);
        string img = Ra2Ui.RegisterKept(key, tex);
        tex.Close();
        if (img.Length == 0) { return null; }
        return R2Tex.Create(img, shp.Width(), shp.Height());
    }

    /// <summary>Frame 0 as a whole-canvas image -- for SHPs whose pixels
    /// span the file (mnscrnl, the fs* dialog family).</summary>
    static R2Tex LoadShpFull(Vfs vfs, string shpName, string palName,
                             string key) {
        return ShellArt.LoadShpFrame(vfs, shpName, palName, 0, key);
    }

    /// <summary>Frame 0 cropped to a canvas sub-rect and registered as its
    /// own image: mnscrnl's art area is (0,0,632,570) -- drawing the whole
    /// 800x600 canvas scaled would smear the right-column border into the
    /// film area.</summary>
    static R2Tex LoadShpArea(Vfs vfs, string shpName, string palName,
                             string key, int x, int y, int w, int h) {
        if (!vfs.Contains(shpName) || !vfs.Contains(palName)) { return null; }
        List<int> plen = new List<int>();
        plen.Add(0);
        byte[] praw = vfs.Read(palName, plen);
        if (plen[0] < 768) { return null; }
        Palette pal = Palette.Parse(praw, plen[0]);

        List<int> slen = new List<int>();
        slen.Add(0);
        byte[] sraw = vfs.Read(shpName, slen);
        if (slen[0] == 0) { return null; }
        ShpImage shp = ShpImage.Parse(sraw, slen[0]);
        if (shp.FrameCount() == 0) { return null; }
        byte[] idx = shp.DecodeFrameCanvas(0);
        Texture full = Texture.FromIndexedShp(idx, shp.Width(), shp.Height(),
                                              pal);
        Texture crop = Texture.Create(w, h);
        for (int yy = 0; yy < h; yy = yy + 1) {
            int sy = y + yy;
            if (sy < 0 || sy >= full.Height()) { continue; }
            for (int xx = 0; xx < w; xx = xx + 1) {
                int sx = x + xx;
                if (sx < 0 || sx >= full.Width()) { continue; }
                int argb = full.PixelAt(sx, sy);
                crop.SetPixel(yy * w + xx, (argb >> 16) & 0xFF,
                              (argb >> 8) & 0xFF, argb & 0xFF,
                              (argb >> 24) & 0xFF);
            }
        }
        full.Close();
        string img = Ra2Ui.RegisterKept(key, crop);
        crop.Close();
        if (img.Length == 0) { return null; }
        return R2Tex.Create(img, w, h);
    }

    /// <summary>Decodes a PCX from the archives into a registered canvas
    /// image, or null when the install does not carry it.</summary>
    static R2Tex LoadPcx(Vfs vfs, string name, string key) {
        Texture rgba = ShellArt.DecodePcx(vfs, name);
        if (rgba == null) { return null; }
        int w = rgba.Width();
        int h = rgba.Height();
        string img = Ra2Ui.RegisterKept(key, rgba);
        rgba.Close();
        if (img.Length == 0) { return null; }
        return R2Tex.Create(img, w, h);
    }

    /// <summary>Decodes an indexed PCX into an RGBA texture, or null.</summary>
    static Texture DecodePcx(Vfs vfs, string name) {
        if (!vfs.Contains(name)) { return null; }
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read(name, len);
        if (len[0] == 0) { return null; }
        PcxImage img = PcxImage.Parse(raw, len[0]);
        if (!img.IsValid() || !img.HasPalette()) { return null; }
        Texture rgba = Texture.FromPcx(img);
        img.Close();
        return rgba;
    }

    /// <summary>Encodes an RGBA Texture as a binary PPM (P6) and registers
    /// it under <paramref name="key"/>. Alpha is baked in: pixels with a=0
    /// are filled with the key colour the caller supplies (used for the
    /// magenta transparency key), others keep their RGB; the PPM path keeps
    /// every pixel fully opaque, so the blend state rides the pixel colours
    /// alone. Returns the "" on encode failure -- callers fall back to drawn
    /// panels.</summary>

    /// <summary>Decodes up to <paramref name="want"/> frames of an SHP onto
    /// each frame's own sub-rect (not the file canvas), registering each
    /// under a stable key. This is the path the reference's animation runners
    /// take: they index a sheet by number and place the frame at the slot
    /// origin, so a frame that ships a smaller sub-rect must not be padded out
    /// to the canvas. <paramref name="want"/> 0 means "all frames". Returns
    /// null when the install lacks the pair.</summary>
    static R2Tex[] LoadFrames(Vfs vfs, string shpName, string palName,
                              string key, int want) {
        if (!vfs.Contains(shpName) || !vfs.Contains(palName)) { return null; }
        List<int> plen = new List<int>();
        plen.Add(0);
        byte[] praw = vfs.Read(palName, plen);
        if (plen[0] < 768) { return null; }
        Palette pal = Palette.Parse(praw, plen[0]);

        List<int> slen = new List<int>();
        slen.Add(0);
        byte[] sraw = vfs.Read(shpName, slen);
        if (slen[0] == 0) { return null; }
        ShpImage shp = ShpImage.Parse(sraw, slen[0]);
        int n = shp.FrameCount();
        if (n <= 0) { return null; }
        if (want > 0 && want < n) { n = want; }

        R2Tex[] outTex = new R2Tex[n];
        for (int i = 0; i < n; i = i + 1) {
            ShpFrame f = shp.FrameAt(i);
            if (f == null || f.IsEmpty()) { continue; }
            byte[] idx = shp.DecodeFrame(i);
            Texture tex = Texture.FromIndexed(idx, f.Width(), f.Height(), pal);
            string img = Ra2Ui.RegisterKept(key + Convert.ToString(i), tex);
            if (img.Length > 0) {
                outTex[i] = R2Tex.Create(img, f.Width(), f.Height());
            }
            tex.Close();
        }
        return outTex;
    }

    /// <summary>MNBTTN.SHP's three 126x25 frames over MAINBTTN.PAL -- the
    /// exact plates the original menu drew its buttons from. Frame order is
    /// the state order the game cycles through: rest, hover, pressed.</summary>
    static R2Tex[] LoadButtons(Vfs vfs) {
        if (!vfs.Contains("MNBTTN.SHP") || !vfs.Contains("MAINBTTN.PAL")) {
            return null;
        }
        List<int> plen = new List<int>();
        plen.Add(0);
        byte[] praw = vfs.Read("MAINBTTN.PAL", plen);
        if (plen[0] < 768) { return null; }
        Palette pal = Palette.Parse(praw, plen[0]);

        List<int> slen = new List<int>();
        slen.Add(0);
        byte[] sraw = vfs.Read("MNBTTN.SHP", slen);
        if (slen[0] == 0) { return null; }
        ShpImage shp = ShpImage.Parse(sraw, slen[0]);
        if (shp.FrameCount() < 3) { return null; }

        R2Tex[] outTex = new R2Tex[3];
        for (int i = 0; i < 3; i = i + 1) {
            ShpFrame f = shp.FrameAt(i);
            if (f == null || f.IsEmpty()) { continue; }
            byte[] idx = shp.DecodeFrame(i);
            Texture tex = Texture.FromIndexed(idx, f.Width(), f.Height(), pal);
            string img = Ra2Ui.RegisterKept("ra2:btn" + Convert.ToString(i), tex);
            outTex[i] = R2Tex.Create(img, f.Width(), f.Height());
            tex.Close();
        }
        return outTex;
    }

    R2Tex Title() { return this.title; }
    R2Tex Load() { return this.load; }
    R2Tex Dialog() { return this.dialog; }
    R2Tex ShellBg() { return this.shellBg; }
    R2Tex ShellBg632() { return this.shellBg632; }
    R2Tex PanelTop() { return this.panelTop; }
    R2Tex WarnAnim() { return this.warnAnim; }
    R2Tex PanelTile() { return this.panelTile; }
    R2Tex PanelBottom() { return this.panelBottom; }
    R2Tex LowerStrip() { return this.lowerStrip; }
    R2Tex ModalBg() { return this.modalBg; }
    R2Tex MsgBtns() { return this.msgBtns; }
    R2Tex FsBkgDlg() { return this.fsBkgDlg; }
    R2Tex FsAllied() { return this.fsAllied; }
    R2Tex FsTutorial() { return this.fsTutorial; }
    R2Tex FsSoviet() { return this.fsSoviet; }
    bool HasTitle() { return this.title != null && this.title.Ok(); }
    bool HasLoad() { return this.load != null && this.load.Ok(); }
    bool HasDialog() { return this.dialog != null && this.dialog.Ok(); }
    bool HasShellBg() { return this.shellBg != null && this.shellBg.Ok(); }
    bool HasShellBg632() { return this.shellBg632 != null && this.shellBg632.Ok(); }
    bool HasPanelTop() { return this.panelTop != null && this.panelTop.Ok(); }
    bool HasWarnAnim() { return this.warnAnim != null && this.warnAnim.Ok(); }
    bool HasPanelTile() { return this.panelTile != null && this.panelTile.Ok(); }
    bool HasPanelBottom() { return this.panelBottom != null && this.panelBottom.Ok(); }
    bool HasLowerStrip() { return this.lowerStrip != null && this.lowerStrip.Ok(); }
    bool HasModalBg() { return this.modalBg != null && this.modalBg.Ok(); }
    bool HasMsgBtns() { return this.msgBtns != null && this.msgBtns.Ok(); }
    bool HasFsBkgDlg() { return this.fsBkgDlg != null && this.fsBkgDlg.Ok(); }
    bool HasFsAllied() { return this.fsAllied != null && this.fsAllied.Ok(); }
    bool HasFsTutorial() { return this.fsTutorial != null && this.fsTutorial.Ok(); }
    bool HasFsSoviet() { return this.fsSoviet != null && this.fsSoviet.Ok(); }
    bool Loaded() { return this.loaded; }

    /// <summary>The button plate for a state (0 rest, 1 hover, 2 pressed),
    /// or null when the install did not carry the plates. This is the dialog
    /// button (MNBTTN); the menu column uses SlotFrame().</summary>
    R2Tex Btn(int state) {
        if (this.btns == null || state < 0 || state > 2) { return null; }
        return this.btns[state];
    }
    bool HasBtns() { return this.btns != null && this.btns[0] != null
                        && this.btns[0].Ok(); }

    /// <summary>The sidebar menu slot plate for one of the reference's 17
    /// animation frames. The runner's map (`MenuSlotAnimationRunner.ts:68-98`)
    /// is: collapsed+hidden 16, collapsed+other 10, open+hidden 0, unlit 1,
    /// normal 2, active 4, and the slide sequences 5..10 (in) / 11..16 (out).
    /// Null when this install lacks SDBTNANM.</summary>
    R2Tex SlotFrame(int frame) {
        if (this.slotFrames == null) { return null; }
        if (frame < 0 || frame >= this.slotFrames.Length) { return null; }
        return this.slotFrames[frame];
    }
    bool HasSlotFrames() { return this.slotFrames != null
                               && this.slotFrames.Length >= 17
                               && this.slotFrames[2] != null; }

    /// <summary>SDTP's closed (0) / open (1) right-panel plate.</summary>
    R2Tex PanelTopState(int state) {
        if (this.sdTp == null) { return null; }
        if (state < 0 || state >= this.sdTp.Length) { return null; }
        return this.sdTp[state];
    }

    /// <summary>The right-panel slide overlay (SDWRNTMP), 6 frames.</summary>
    R2Tex PanelSlideFrame(int frame) {
        if (this.sdWrnTmp == null) { return null; }
        if (frame < 0 || frame >= this.sdWrnTmp.Length) { return null; }
        return this.sdWrnTmp[frame];
    }
    bool HasPanelSlide() { return this.sdWrnTmp != null; }

    /// <summary>The MP slot plate (SDMPBTN), 7 frames; the runner's rest
    /// frames are 6 collapsed / 0 open (`MenuMpSlotAnimRunner.ts:7`).</summary>
    R2Tex MpBtnFrame(int frame) {
        if (this.mpBtn == null) { return null; }
        if (frame < 0 || frame >= this.mpBtn.Length) { return null; }
        return this.mpBtn[frame];
    }
    bool HasMpBtn() { return this.mpBtn != null; }

    /// <summary>The right-panel's looping animation sheet (SDWRNANM), 91
    /// frames; the reference loops it with loopCount -1 over shell2.pal
    /// (`SidebarPreview.tsx:52,76-83`).</summary>
    R2Tex WarnLoopFrame(int frame) {
        if (this.wrnAnim == null) { return null; }
        if (frame < 0 || frame >= this.wrnAnim.Length) { return null; }
        return this.wrnAnim[frame];
    }
    bool HasWarnLoop() { return this.wrnAnim != null; }
    int WarnLoopCount() {
        if (this.wrnAnim == null) { return 0; }
        return this.wrnAnim.Length;
    }

    /// <summary>Registered canvas images live in the runtime's shared
    /// registry; dropping the references is all the teardown needed.</summary>
    void Close() {
        this.title = null;
        this.load = null;
        this.dialog = null;
        this.btns = null;
        this.shellBg = null;
        this.shellBg632 = null;
        this.panelTop = null;
        this.warnAnim = null;
        this.panelTile = null;
        this.panelBottom = null;
        this.lowerStrip = null;
        this.modalBg = null;
        this.msgBtns = null;
        this.slotFrames = null;
        this.sdTp = null;
        this.sdWrnTmp = null;
        this.mpBtn = null;
        this.wrnAnim = null;
        this.fsBkgDlg = null;
        this.fsAllied = null;
        this.fsTutorial = null;
        this.fsSoviet = null;
    }
}

/// <summary>Draws the shell screens: main menu and skirmish setup.</summary>
///
/// The screens read a Shell and call its transitions; they hold no state of
/// their own beyond hit-test rectangles, so the flow stays testable without a
/// window. Every label comes from the install's CSF table when one is
/// mounted -- the exact strings the original menu showed (遭遇战, 選項,
/// 退出遊戲) -- falling back to the transcribed text without one.
/// <summary>Canvas image registration for decoded RA2 art: an RGBA
/// Texture becomes a 32-bit uncompressed TGA buffer registered under a
/// "mem:" key. TGA carries real per-pixel alpha, so SHP frame 0 pixels
/// (decoded to a=0) stay transparent and the semi-transparent dim used by
/// disabled buttons (a=110) survives the round trip -- the P6 PPM this
/// replaced had no alpha channel and forced a magenta bake that showed
/// through the chrome.</summary>
class Ra2Ui {
    static int registered;
    // Memoized registrations: key -> R2Tex. The TGA encode is the expensive
    // part, so the same key (a stable name for a piece of art) is encoded and
    // registered once; every later frame reuses the registered image.
    static List<string> memoKeys;
    static List<R2Tex> memoVals;
    // Retained source bytes of every kept registration. The canvas's image
    // store holds only 64 decoded images and FIFO-evicts the oldest key, so
    // a piece of fixed UI registered on frame 1 can be gone by frame 70 --
    // with the source bytes kept, a draw that finds its key evicted simply
    // re-registers them. The bytes stay valid even after the caller closed
    // its Texture.
    static List<string> keepKeys;
    static List<byte[]> keepBytes;
    static List<int> keepW;
    static List<int> keepH;
    // Per mutable surface, the previous frame's full key, evicted when the
    // surface re-registers. Without this the terrain composite pushed a new
    // key into the store every frame and the FIFO walked fixed UI art out
    // from under the sidebar seconds into a battle.
    static List<string> mutBase;
    static List<string> mutPrev;

    /// <summary>Registers an RGBA Texture under key, returning the key, or
    /// "" when the texture is empty. Keys are uniquified with a counter so
    /// re-decoded art never collides with a live registration.</summary>
    static string RegisterRgba(string key, Texture t) {
        int w = t.Width();
        int h = t.Height();
        if (w <= 0 || h <= 0 || w > 65535 || h > 65535) { return ""; }
        // 18-byte TGA header: no id, no colour map, uncompressed 32-bit
        // true colour, top-down rows (descriptor bit 5), 8 alpha bits.
        byte[] buf = new byte[18 + w * h * 4];
        buf[2] = 2;
        buf[12] = (byte)(w & 255);
        buf[13] = (byte)((w >> 8) & 255);
        buf[14] = (byte)(h & 255);
        buf[15] = (byte)((h >> 8) & 255);
        buf[16] = 32;
        buf[17] = 40;                       // 0x28: top-down | alpha bits
        byte[] px = t.Pixels();
        int at = 18;
        for (int i = 0; i < w * h; i = i + 1) {
            int o = i * 4;
            buf[at] = px[o + 2];            // TGA stores BGRA
            buf[at + 1] = px[o + 1];
            buf[at + 2] = px[o];
            buf[at + 3] = px[o + 3];
            at = at + 4;
        }
        registered = registered + 1;
        string full = "mem:" + key + "#" + Convert.ToString(registered);
        Ra2Ui.lastBuf = buf;
        if (Canvas.ImageLoadMem(full, buf, buf.Length) == 0) { return ""; }
        return full;
    }

    /// <summary>Registers like RegisterRgba and keeps the encoded bytes, so
    /// art that outlives its Texture (the callers decode, register, then
    /// Close) can be re-registered if the store evicts it. Every fixed UI
    /// image goes through here.</summary>
    static string RegisterKept(string key, Texture t) {
        string full = Ra2Ui.RegisterRgba(key, t);
        if (full.Length == 0) { return full; }
        if (Ra2Ui.keepKeys == null) {
            Ra2Ui.keepKeys = new List<string>();
            Ra2Ui.keepBytes = new List<byte[]>();
            Ra2Ui.keepW = new List<int>();
            Ra2Ui.keepH = new List<int>();
        }
        Ra2Ui.keepKeys.Add(full);
        Ra2Ui.keepBytes.Add(t == null ? null : Ra2Ui.LastBuf());
        Ra2Ui.keepW.Add(t.Width());
        Ra2Ui.keepH.Add(t.Height());
        return full;
    }

    /// <summary>The bytes RegisterRgba last encoded. RegisterKept reads it
    /// right after the call; nothing else may.</summary>
    static byte[] lastBuf;
    static byte[] LastBuf() {
        return Ra2Ui.lastBuf;
    }

    /// <summary>A live handle for t: t itself while the canvas store still
    /// holds its image, otherwise a re-registration of the retained bytes
    /// under a fresh key. Null when the art was mutable (whose bytes are
    /// only kept by the surface's own re-register path).</summary>
    static R2Tex Rebind(R2Tex t) {
        if (t == null || !t.Ok()) { return null; }
        if (Canvas.ImageWidth(t.Key()) > 0) { return t; }
        if (Ra2Ui.keepKeys == null) { return null; }
        for (int i = 0; i < Ra2Ui.keepKeys.Count; i = i + 1) {
            if (Ra2Ui.keepKeys[i] != t.Key()) { continue; }
            byte[] buf = Ra2Ui.keepBytes[i];
            if (buf == null) { return null; }
            Ra2Ui.registered = Ra2Ui.registered + 1;
            string full = Ra2Ui.keepKeys[i] + "+"
                + Convert.ToString(Ra2Ui.registered);
            if (Canvas.ImageLoadMem(full, buf, buf.Length) == 0) {
                return null;
            }
            Ra2Ui.keepKeys[i] = full;
            return R2Tex.Create(full, Ra2Ui.keepW[i], Ra2Ui.keepH[i]);
        }
        return null;
    }

    /// <summary>Registers a Texture once under a stable key and returns the
    /// R2Tex handle. Repeat calls with the same key return the cached handle
    /// instead of re-encoding -- the per-frame cameo/icon draws depend on
    /// this to stay cheap. A cached handle whose canvas image was evicted
    /// re-registers from the texture at hand and takes its slot.</summary>
    static R2Tex TexOf(string key, Texture t) {
        if (t == null) { return null; }
        if (Ra2Ui.memoKeys == null) {
            Ra2Ui.memoKeys = new List<string>();
            Ra2Ui.memoVals = new List<R2Tex>();
        }
        for (int i = 0; i < Ra2Ui.memoKeys.Count; i = i + 1) {
            if (Ra2Ui.memoKeys[i] != key) { continue; }
            R2Tex v = Ra2Ui.memoVals[i];
            if (Canvas.ImageWidth(v.Key()) > 0) { return v; }
            // Evicted by the canvas's FIFO image store: register the caller's
            // pixels afresh and take the memo slot.
            int w = t.Width();
            int h = t.Height();
            string img = Ra2Ui.RegisterKept(key, t);
            if (img.Length == 0) { return null; }
            v = R2Tex.Create(img, w, h);
            Ra2Ui.memoVals[i] = v;
            return v;
        }
        int w0 = t.Width();
        int h0 = t.Height();
        string img0 = Ra2Ui.RegisterKept(key, t);
        if (img0.Length == 0) { return null; }
        R2Tex rt = R2Tex.Create(img0, w0, h0);
        Ra2Ui.memoKeys.Add(key);
        Ra2Ui.memoVals.Add(rt);
        return rt;
    }

    /// <summary>Clears the memo, e.g. when a game tears its art down.</summary>
    static void ResetMemo() {
        Ra2Ui.memoKeys = null;
        Ra2Ui.memoVals = null;
        Ra2Ui.keepKeys = null;
        Ra2Ui.keepBytes = null;
        Ra2Ui.keepW = null;
        Ra2Ui.keepH = null;
        Ra2Ui.mutBase = null;
        Ra2Ui.mutPrev = null;
    }

    // Mutable surfaces (the terrain composite, the map preview): re-registered
    // under the same key with a fresh counter each frame. The previous
    // registration stays until the canvas evicts it, which is what the old
    // texture Update did on the GPU side.
    static int mutCounter;

    /// <summary>Registers a CPU Texture as a canvas image with a fresh key
    /// each call -- for pixels that change between frames (the terrain
    /// composite). The surface's previous image is evicted first, so the
    /// surface owns exactly one slot in the canvas's FIFO image store at
    /// any time and its churn cannot walk fixed UI art out of the 64-entry
    /// cache. Returns the R2Tex handle.</summary>
    static R2Tex RegisterMutable(string key, Texture t) {
        if (t == null) { return null; }
        int w = t.Width();
        int h = t.Height();
        if (w <= 0 || h <= 0) { return null; }
        if (Ra2Ui.mutBase == null) {
            Ra2Ui.mutBase = new List<string>();
            Ra2Ui.mutPrev = new List<string>();
        }
        for (int i = 0; i < Ra2Ui.mutBase.Count; i = i + 1) {
            if (Ra2Ui.mutBase[i] != key) { continue; }
            Canvas.EvictImage(Ra2Ui.mutPrev[i]);
            string img = Ra2Ui.RegisterRgba(key, t);
            if (img.Length == 0) { return null; }
            Ra2Ui.mutPrev[i] = img;
            return R2Tex.Create(img, w, h);
        }
        string img0 = Ra2Ui.RegisterRgba(key, t);
        if (img0.Length == 0) { return null; }
        Ra2Ui.mutBase.Add(key);
        Ra2Ui.mutPrev.Add(img0);
        return R2Tex.Create(img0, w, h);
    }
}

class Strings {
    CsfTable table;

    static Strings Load(Vfs vfs) {
        Strings s = new Strings();
        s.table = null;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read("RA2MD.CSF", len);
        if (len[0] == 0) {
            raw = vfs.Read("RA2.CSF", len);
        }
        if (len[0] > 0) { s.table = CsfTable.Parse(raw, len[0]); }
        return s;
    }

    /// <summary>The CSF text for <paramref name="label"/>, or the fallback
    /// when the table is missing or the label absent.</summary>
    string Or(string label, string fallback) {
        if (this.table == null) { return fallback; }
        string v = this.table.Lookup(label);
        if (v == null || v.Length == 0) { return fallback; }
        return v;
    }

    bool Loaded() { return this.table != null; }

    void Close() { this.table = null; }
}

/// <summary>Shell layout constants and per-frame geometry, ported from the
/// reference's ui_layout.rs -- an 800x600 base that maps onto the view the
/// same way the renderer's fit camera does (short axis fits, long axis
/// extends, then the shell anchors top-left with the canvas black).</summary>
class ShellLayout {
    static int BaseW() { return 800; }
    static int BaseH() { return 600; }
    static int PanelW() { return 168; }      // right chrome column width
    static int PanelTopH() { return 199; }   // sdtp (measured 168x199)
    static int WarnX() { return 38; }        // sdwrnanm inside sdtp
    static int WarnY() { return 48; }
    static int TileH() { return 42; }        // sdbtnbkgd strip (measured 168x42)
    // The menu plate is SDBTNANM.SHP, measured 156x42, drawn at x=12 inside
    // the 168-wide column (reference `MainMenu.ts:348,356`: sprite and text
    // box both at x:12). 12+156 = 168, so the plate is inset 12 left and flush
    // right -- the reference's "146 wide" is the HTML text box, not the art.
    static int CellW() { return 156; }       // owner-draw button cell
    static int CellH() { return 42; }
    static int CellX() { return 12; }        // plate/text inset in the column
    static int SlotX() { return 632; }       // 800 - 168, the column origin
    static int SlotTopY() { return PanelTopH(); }   // slots start under sdtp
    static int LowerH() { return 32; }       // lwscrnl strip (measured 632x32)
    static int MovieH() { return 570; }      // mnscrnl art area height
    // sdtp is 199 tall; the column has 600-199 = 401 px of slots, which is
    // floor(401/42) = 9 tiles at pitch 42, leaving 401-378 = 23 px for the
    // SDBTM cap. SDBTM is 168x65 on disk and the reference clips it to the
    // leftover (`MainMenu.ts:318-320`) -- the clip height is derived, not the
    // 23 constant, so a different install still lands correctly.
    static int SlotCount() {
        return (ShellLayout.BaseH() - ShellLayout.SlotTopY()) / ShellLayout.TileH();
    }
    static int CapY() {
        return ShellLayout.SlotTopY()
             + ShellLayout.SlotCount() * ShellLayout.TileH();
    }
    static int CapH() {
        return ShellLayout.BaseH() - ShellLayout.CapY();
    }
    // SidebarTitle (reference `SidebarPreview.tsx:62-69`): x 25, width 118,
    // height 18 open / 32 closed, vertically centred in that box.
    static int TitleX() { return 25; }
    static int TitleY() { return 3; }
    static int TitleW() { return 118; }
    static int TooltipW() { return 455; }
    static int TooltipH() { return 20; }

    // Text colours (ui_text.rs MENU_TEXT_*).
    static void TextEnabled(List<int> rgb) {
        Screens.Ra2AppLikeSet(rgb, 255, 214, 0);
    }
    static void TextDisabled(List<int> rgb) {
        Screens.Ra2AppLikeSet(rgb, 128, 128, 128);
    }

    /// <summary>Maps a view point into 800x600 shell space. The 4:3 base is
    /// fitted by height the way the stage viewport does; on a 1280x720 view
    /// the numbers are exact.</summary>
    static void ToBase(int viewW, int viewH, int px, int py,
                       List<int> outXY) {
        int bh = viewH;
        int bw = bh * 4 / 3;
        if (bw > viewW) { bw = viewW; bh = bw * 3 / 4; }
        int ox = (viewW - bw) / 2;
        int oy = (viewH - bh) / 2;
        outXY[0] = ox + px * bw / ShellLayout.BaseW();
        outXY[1] = oy + py * bh / ShellLayout.BaseH();
    }

    /// <summary>Maps a view point back into 800x600 shell coordinates (the
    /// inverse of ToBase). Returns false when the point falls outside the
    /// fitted base.</summary>
    static bool FromBase(int viewW, int viewH, int px, int py,
                         List<int> outXY) {
        int bh = viewH;
        int bw = bh * 4 / 3;
        if (bw > viewW) { bw = viewW; bh = bw * 3 / 4; }
        int ox = (viewW - bw) / 2;
        int oy = (viewH - bh) / 2;
        if (px < ox || py < oy || px >= ox + bw || py >= oy + bh) {
            outXY[0] = 0 - 1;
            outXY[1] = 0 - 1;
            return false;
        }
        outXY[0] = (px - ox) * ShellLayout.BaseW() / bw;
        outXY[1] = (py - oy) * ShellLayout.BaseH() / bh;
        return true;
    }

    /// <summary>Where the shell base sits in the view, and its scale:
    /// writes [x, y, w, h] of the fitted 800x600 rect.</summary>
    static void BaseRect(int viewW, int viewH, List<int> outRect) {
        int bh = viewH;
        int bw = bh * 4 / 3;
        if (bw > viewW) { bw = viewW; bh = bw * 3 / 4; }
        outRect[0] = (viewW - bw) / 2;
        outRect[1] = (viewH - bh) / 2;
        outRect[2] = bw;
        outRect[3] = bh;
    }

    /// <summary>An owner-draw button cell: the 156x42 plate inset 12 px into
    /// the 168-wide right column, at the tile row the slot grid lands on.</summary>
    static void ButtonCell(int rowY, List<int> outRect) {
        outRect[0] = ShellLayout.SlotX() + ShellLayout.CellX();
        outRect[1] = rowY;
        outRect[2] = ShellLayout.CellW();
        outRect[3] = ShellLayout.CellH();
    }

    /// <summary>The caption rect inside a button cell. The reference centres
    /// the label in the HTML box (`MenuButton.tsx:42-59`: line-height = box
    /// height, text-align centre), so the caption is the plate rect itself
    /// with a small press nudge -- the plate art carries the bevel, the text
    /// rides on top of it.</summary>
    static void CaptionRect(int cellX, int cellY, int cellW, int cellH,
                            bool pressed, List<int> outRect) {
        int dx = pressed ? 1 : 0;
        int dy = pressed ? 2 : 0;
        outRect[0] = cellX + dx;
        outRect[1] = cellY + dy;
        outRect[2] = cellW;
        outRect[3] = cellH;
    }
}

/// <summary>One sidebar menu slot's animation state, ported from the
/// reference's MenuSlotAnimationRunner: the slot has a button state
/// (hidden/unlit/normal/active), a collapse state, and an optional slide
/// animation that walks frames 0..5 while sliding in and 0..5 while sliding
/// out. getCurrentFrame() picks the SDBTNANM frame to draw.
///
/// Frame map (`MenuSlotAnimationRunner.ts:68-98`):
///   sliding in  -> base 10 (or 5 when hidden) minus the animation frame
///   sliding out -> base  5 (or 0 when hidden) plus  the animation frame
///   at rest     -> collapsed ? (hidden ? 16 : 10) : (0/1/2/4 by state)
/// </summary>
class MenuSlot {
    static int StateHidden() { return 0; }
    static int StateUnlit() { return 1; }
    static int StateNormal() { return 2; }
    static int StateActive() { return 3; }

    // Slide direction 0 none, 1 in, 2 out.
    static int SlideNone() { return 0; }
    static int SlideIn() { return 1; }
    static int SlideOut() { return 2; }

    // The reference's animation runs 6 logical frames (loopEnd = 5) at the
    // UI animation speed; the window between sound cues is ~50 ms, so a slot
    // takes 6 * 50 = 300 ms to slide.
    static int SlideFrames() { return 6; }
    static int SlideStepMs() { return 50; }

    int index;          // slot index, also the per-slot delay in frames
    int state;
    int slide;          // SlideNone / SlideIn / SlideOut
    int slideFrame;     // 0..SlideFrames()
    int slideAccMs;     // ms accumulator inside the current frame
    bool collapsed;

    static MenuSlot Create(int index) {
        MenuSlot s = new MenuSlot();
        s.index = index;
        s.state = MenuSlot.StateHidden();
        s.slide = MenuSlot.SlideNone();
        s.slideFrame = 0;
        s.slideAccMs = 0;
        s.collapsed = true;
        return s;
    }

    int State() { return this.state; }
    void SetState(int s) { this.state = s; }
    bool Collapsed() { return this.collapsed; }
    bool Sliding() { return this.slide != MenuSlot.SlideNone(); }

    void SlideInNow() {
        this.slide = MenuSlot.SlideIn();
        this.slideFrame = 0;
        this.slideAccMs = 0;
        // The reference staggers slots by index (`delayFrames` ctor arg), so
        // the column unfurls top-down rather than snapping at once.
        this.slideAccMs = 0 - this.index * MenuSlot.SlideStepMs();
    }

    void SlideOutNow() {
        this.slide = MenuSlot.SlideOut();
        this.slideFrame = 0;
        this.slideAccMs = 0 - this.index * MenuSlot.SlideStepMs();
    }

    /// <summary>Advances the slide by <paramref name="dtMs"/>; a negative
    /// accumulator is the start delay, so frames only advance once it turns
    /// positive.</summary>
    void Tick(int dtMs) {
        if (this.slide == MenuSlot.SlideNone()) { return; }
        this.slideAccMs = this.slideAccMs + dtMs;
        while (this.slideAccMs >= MenuSlot.SlideStepMs()
            && this.slide != MenuSlot.SlideNone()) {
            this.slideAccMs = this.slideAccMs - MenuSlot.SlideStepMs();
            this.slideFrame = this.slideFrame + 1;
            if (this.slideFrame >= MenuSlot.SlideFrames()) {
                this.collapsed = this.slide == MenuSlot.SlideOut();
                this.slide = MenuSlot.SlideNone();
                this.slideFrame = 0;
            }
        }
    }

    /// <summary>The SDBTNANM frame this slot draws this instant.</summary>
    int CurrentFrame() {
        if (this.slide != MenuSlot.SlideNone()) {
            int dir = this.slide == MenuSlot.SlideIn() ? 0 - 1 : 1;
            int baseFrame = this.state != MenuSlot.StateHidden() ? 5 : 11;
            if (dir == 0 - 1) { baseFrame = baseFrame + 5; }
            int f = baseFrame + dir * this.slideFrame;
            if (f < 0) { f = 0; }
            if (f > 16) { f = 16; }
            return f;
        }
        if (this.collapsed) {
            return this.state == MenuSlot.StateHidden() ? 16 : 10;
        }
        if (this.state == MenuSlot.StateHidden()) { return 0; }
        if (this.state == MenuSlot.StateUnlit()) { return 1; }
        if (this.state == MenuSlot.StateNormal()) { return 2; }
        if (this.state == MenuSlot.StateActive()) { return 4; }
        return 2;
    }
}

class Screens {
    /// <summary>Main menu: the MNSCRNL base, SDTP + SDWRNANM right chrome,
    /// SDBTNBKGD tiles, the SDBTM cap and the LWSCRNL strip, then the
    /// reference's sidebar entry list (`HomeScreen.ts:47-161`) as SDBTNANM
    /// plates with gold captions, the right-column title and the hovered
    /// entry's tooltip on the lower strip. Returns the action clicked:
    /// 1 skirmish, 2 options, 4 fullscreen, 0 none.</summary>
    static int DrawMainMenu(R2Canvas r, ShellArt art, Strings ui,
                            int viewW, int viewH,
                            int mouseX, int mouseY, bool clicked) {
        List<int> rect = new List<int>();
        rect.Add(0); rect.Add(0); rect.Add(0); rect.Add(0);
        List<int> rgb = new List<int>();
        rgb.Add(0); rgb.Add(0); rgb.Add(0);
        int action = 0;

        if (art != null && art.HasShellBg()) {
            // The fitted 800x600 base on the stage; everything below
            // scales into it from shell coordinates.
            ShellLayout.BaseRect(viewW, viewH, rect);
            int bx = rect[0];
            int by = rect[1];
            int bw = rect[2];
            int bh = rect[3];

            // The base: mnscrnl's art area 632x570 at (0,0) over the black
            // canvas remainder (the right column and the strip area stay
            // under the chrome pieces).
            r.SetColor(0, 0, 0, 255);
            r.FillRect(bx, by, bw, bh);
            if (art.HasShellBg632()) {
                Screens.BlitShell(r, art.ShellBg632(), bx, by, 632, 570,
                                  bw, bh);
            } else {
                Screens.BlitShell(r, art.ShellBg(), bx, by, 800, 600,
                                  bw, bh);
            }

            // ---- the right column chrome --------------------------------
            int panelX = 800 - 168;                       // 632
            Screens.BlitShell(r, art.PanelTop(), bx + panelX * bw / 800, by,
                              168, 199, bw, bh);
            if (art.HasWarnAnim()) {
                Screens.BlitShell(r, art.WarnAnim(),
                                  bx + (panelX + 38) * bw / 800,
                                  by + 48 * bh / 600,
                                  art.WarnAnim().W(), art.WarnAnim().H(),
                                  bw, bh);
            }
            if (art.HasPanelTile()) {
                for (int i = 0; i < 9; i = i + 1) {
                    Screens.BlitShell(r, art.PanelTile(),
                                      bx + panelX * bw / 800,
                                      by + (199 + i * 42) * bh / 600,
                                      168, 42, bw, bh);
                }
            }
            // Bottom cap: 199 + 9*42 = 577, so it spans 577..600.
            if (art.HasPanelBottom()) {
                Screens.BlitShell(r, art.PanelBottom(),
                                  bx + panelX * bw / 800,
                                  by + 577 * bh / 600, 168, 23, bw, bh);
            }
            // The lower strip: (0,568) 632x32 -- the film area's bottom.
            if (art.HasLowerStrip()) {
                Screens.BlitShell(r, art.LowerStrip(), bx, by + 568 * bh / 600,
                                  632, 32, bw, bh);
            }

            // ---- the sidebar entries ------------------------------------
            // The reference builds this list per screen and hands it to the
            // sidebar (`HomeScreen.ts:47-161` -> `MainMenu.setButtons`). The
            // order, labels and bottom-pinning below are that list verbatim:
            // Skirmish, Load Game, Live Interaction, Replays, LAN Multiplayer,
            // Mods, Info & Credits, Options, Test Tools, and Fullscreen
            // bottom-pinned (`isBottom`, `HomeScreen.ts:152`).
            //
            // Entries whose subsystem this port has not built yet keep their
            // slot and label -- the original's rows are all present -- but
            // draw Unlit so they read as unavailable rather than silently
            // doing nothing (`MenuButtonState.Unlit`, the same state the
            // reference gives a disabled entry, `MainMenu.ts:436-438`).
            string[] labels = new string[10];
            bool[] enabled = new bool[10];
            bool[] bottom = new bool[10];
            int[] ids = new int[10];
            // Note the first entry: the reference hardcodes the English
            // literal `'Skirmish'` (`HomeScreen.ts:49`) rather than
            // looking up a CSF key, so this port does the same. Passing
            // "GUI:Skirmish" through `ui.Or` would pick up whatever the
            // CSF holds for that key and silently diverge -- the diff
            // tool (tools/ra2_diff.py) flags exactly that.
            labels[0] = "Skirmish";
            labels[1] = "Load Game";
            labels[2] = "Live Interaction";
            labels[3] = "Replays";
            labels[4] = "LAN Multiplayer";
            labels[5] = ui.Or("GUI:Mods", "模组");
            labels[6] = ui.Or("TS:InfoAndCredits", "信息与制作群");
            labels[7] = ui.Or("GUI:Options", "选项");
            labels[8] = "Test Tools";
            labels[9] = ui.Or("GUI:Fullscreen", "全屏");
            enabled[0] = true;    // Skirmish -> the setup screen
            enabled[1] = false;   // save/load not built
            enabled[2] = false;   // live interaction is a web-only mode
            enabled[3] = false;   // replay browser not built
            enabled[4] = false;   // LAN transport not built
            enabled[5] = false;   // mod manager not built
            enabled[6] = false;   // credits viewer not built
            enabled[7] = true;    // Options
            enabled[8] = false;   // test tools are a dev-shell entry
            enabled[9] = true;    // Fullscreen
            ids[0] = 1; ids[1] = 0; ids[2] = 0; ids[3] = 0; ids[4] = 0;
            ids[5] = 0; ids[6] = 0; ids[7] = 2; ids[8] = 0; ids[9] = 4;
            bottom[9] = true;

            // The reference's tooltips (`HomeScreen.ts:50,66,78,86,98,110,
            // 120,131,142,151`), shown on the lower strip on hover. The
            // ones without a CSF key are English literals in the
            // reference; they are carried verbatim rather than
            // translated, so the two implementations stay comparable.
            string[] tips = new string[10];
            tips[0] = "Play a single-player skirmish against the AI";
            tips[1] = "Continue a saved skirmish match";
            tips[2] = "Enter live interaction mode, where viewer events such"
                + " as joins, likes, and gifts drive both sides to send"
                + " units into battle";
            tips[3] = "View and play back game replays";
            tips[4] = "Exchange SDP manually to establish a LAN P2P data"
                + " channel";
            tips[5] = ui.Or("STT:Mods", "Manage and play modified content");
            tips[6] = ui.Or("STT:InfoAndCredits",
                            "Information about the game and its credits");
            tips[7] = ui.Or("STT:MainButtonOptions", "Game settings");
            tips[8] = "Access low-level file system and testing tools";
            tips[9] = ui.Or("STT:Fullscreen", "Toggle full screen mode");

            int slotCount = ShellLayout.SlotCount();
            int bottomRow = slotCount - 1;
            // The reference's slot assignment (`MainMenu.updateButtons` /
            // `setSlots`, `MainMenu.ts:106-161`): the normal entries fill
            // slots 0,1,2,... and the single `isBottom` entry takes the LAST
            // slot. The entries are NOT positioned by their index in the
            // caller's array -- the bottom entry is pulled out first, so it
            // never shares a row with the entry that would otherwise reach
            // that slot.
            int normalSlots = 0;
            for (int i = 0; i < 10; i = i + 1) {
                if (!bottom[i]) { normalSlots = normalSlots + 1; }
            }
            // Slots the normal entries may use: everything above the bottom
            // row. When there are more entries than that, the tail is dropped
            // rather than overlapping (the reference's slots simply stay
            // Hidden).
            int normalRoom = slotCount - 1;
            if (normalRoom < 0) { normalRoom = 0; }
            int hoveredSlot = 0 - 1;
            int clickSlot = 0 - 1;
            int placed = 0;
            for (int i = 0; i < 10; i = i + 1) {
                int slot = 0 - 1;
                if (bottom[i]) {
                    slot = bottomRow;
                } else if (placed < normalRoom) {
                    slot = placed;
                    placed = placed + 1;
                }
                if (slot < 0 || slot >= slotCount) { continue; }
                int rowY = ShellLayout.SlotTopY() + slot * ShellLayout.TileH();
                ShellLayout.ButtonCell(rowY, rect);
                int cellX = bx + rect[0] * bw / 800;
                int cellY = by + rect[1] * bh / 600;
                int cellW = rect[2] * bw / 800;
                int cellH = rect[3] * bh / 600;
                List<int> mp = new List<int>();
                mp.Add(0); mp.Add(0);
                bool inside = ShellLayout.FromBase(viewW, viewH, mouseX,
                                                   mouseY, mp);
                bool hov = inside && enabled[i]
                    && R2Panel.PointIn(mp[0], mp[1], rect[0], rect[1],
                                       rect[2], rect[3]);
                if (hov) { hoveredSlot = i; }
                if (hov && clicked) { clickSlot = i; }

                // The plate is the slot's state frame from the SDBTNANM
                // sheet; hover picks Normal (2), press Active (4), disabled
                // Unlit (1) -- `MenuSlotAnimationRunner.ts:85-93`.
                // The plate is the slot's state frame from the SDBTNANM
                // sheet: Unlit (1) for a disabled entry, Normal (2) for a
                // live one, Active (4) while the mouse is held down
                // (`MenuSlotAnimationRunner.ts:85-93`). The reference's
                // mousedown->mouseup hold lives in the shell state
                // (`MainMenu.ts:358-365`), so a click past the press flag
                // still reads as Active for this frame.
                int state = !enabled[i] ? 1 : (hov && clicked ? 4 : 2);
                R2Tex plate = art.SlotFrame(state);
                if (plate != null) {
                    Screens.BlitShell(r, plate, cellX, cellY, cellW, cellH,
                                      bw, bh);
                } else {
                    Screens.DrawSdbtnanm(r, art, cellX, cellY, cellW, cellH,
                                         hov && clicked, !enabled[i]);
                }
                ShellLayout.CaptionRect(rect[0], rect[1], rect[2], rect[3],
                                        false, rect);
                int capX = bx + rect[0] * bw / 800;
                int capY = by + rect[1] * bh / 600;
                int capW = rect[2] * bw / 800;
                int capH = rect[3] * bh / 600;
                if (enabled[i]) {
                    ShellLayout.TextEnabled(rgb);
                } else {
                    ShellLayout.TextDisabled(rgb);
                }
                // The label is centred in the plate, vertically too
                // (`MenuButton.tsx:58` line-height = box height).
                R2Text.DrawCentered(r, labels[i], capX + capW / 2,
                                    capY + (capH - 12) / 2, 2,
                                    rgb[0], rgb[1], rgb[2], 255);
            }
            if (clickSlot >= 0) { action = ids[clickSlot]; }

            // Right-column title: the reference centres it in a 118-wide box
            // at x 25 y 3 inside the sdtp plate (`SidebarPreview.tsx:62-69`).
            int titleX = bx + (panelX + ShellLayout.TitleX()) * bw / 800;
            int titleY = by + ShellLayout.TitleY() * bh / 600;
            int titleW = ShellLayout.TitleW() * bw / 800;
            int titleH = 18 * bh / 600;
            ShellLayout.TextEnabled(rgb);
            R2Text.DrawCentered(r, ui.Or("GUI:MainMenu", "主選單"),
                                titleX + titleW / 2,
                                titleY + (titleH - 12) / 2, 2,
                                rgb[0], rgb[1], rgb[2], 255);

            // The lower strip carries the hovered entry's tooltip, falling
            // back to the idle hint (`MenuTooltip.tsx:18-23`: the strip reads
            // the hovered element's data-r-tooltip).
            // The lower strip carries the hovered entry's tooltip, falling
            // back to the idle hint (`MenuTooltip.tsx:18-23`: the strip reads
            // the hovered element's data-r-tooltip). The idle text is the
            // reference's own menu hint; the CSF usually has no STT:MainHint,
            // so the literal is what shows when nothing is hovered.
            string tip = ui.Or("STT:MainHint", "主選單");
            if (hoveredSlot >= 0) { tip = tips[hoveredSlot]; }
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, tip, bx + 10 * bw / 800,
                        by + (600 - 21) * bh / 600, 1,
                        rgb[0], rgb[1], rgb[2], 255);
            return action;
        }

        // No shell art in the install: keep the drawn stand-in so the menu
        // still opens (the exe itself falls back when the sprites are gone).
        R2Panel.Backdrop(r, null, viewW, viewH);
        string skirmishLabel = ui.Or("GUI:Skirmish", "遭遇战");
        string singleLabel = ui.Or("GUI:SinglePlayer", "单人游戏");
        string optionsLabel = ui.Or("GUI:Options", "选项");
        string exitLabel = ui.Or("GUI:ExitGame", "退出游戏");
        int s = 1;
        int bw2 = 126 * s;
        int bh2 = 25 * s;
        int pitch = 36 * s;
        int bx2 = 20;
        int by2 = 160;
        bool hovS = Screens.MenuButton(r, art, mouseX, mouseY, bx2, by2,
                                       bw2, bh2, skirmishLabel, true, false,
                                       clicked);
        if (hovS && clicked) { action = 1; }
        bool hovSingle = Screens.MenuButton(r, art, mouseX, mouseY, bx2,
                                            by2 + pitch, bw2, bh2,
                                            singleLabel, true, false,
                                            clicked);
        if (hovSingle && clicked) { action = 1; }
        bool hovOptions = Screens.MenuButton(r, art, mouseX, mouseY, bx2,
                                             by2 + pitch * 2, bw2, bh2,
                                             optionsLabel, true, false,
                                             clicked);
        if (hovOptions && clicked) { action = 2; }
        bool hovQuit = Screens.MenuButton(r, art, mouseX, mouseY, bx2,
                                          by2 + pitch * 3, bw2, bh2,
                                          exitLabel, true, false, clicked);
        if (hovQuit && clicked) { action = 3; }
        R2Text.Draw(r, "Esc 退出  F11 全屏", bx2, 480, 2,
                  150, 158, 172, 255);
        return action;
    }

    /// <summary>Draws a shell-space rect of an image: (x,y,w,h) in 800x600
    /// coordinates, scaled into the fitted base rect (bx,by,bw,bh). This is
    /// the reference's blit at native size plus the view camera's fit.</summary>
    static void BlitShell(R2Canvas r, R2Tex tex, int bx, int by, int w,
                          int h, int bw, int bh) {
        if (tex == null || !tex.Ok()) { return; }
        r.DrawTexture(tex, bx, by, w * bw / 800, h * bh / 600);
    }

    /// <summary>One SDBTNANM owner-draw button: frame 2 at rest, frame 4
    /// pressed (hover changes no frame -- retail), the plate stretched to
    /// the cell, dimmed 110 when disabled. Falls back to a drawn slab when
    /// the install did not carry the sprite.</summary>
    static void DrawSdbtnanm(R2Canvas r, ShellArt art, int x, int y, int w,
                             int h, bool pressed, bool disabled) {
        // The reference keeps the plate at art size inside the cell; the
        // cell is the plate's exact 156x42, so the draw is 1:1 in shell
        // space and the caller's scale maps it.
        R2Tex plate = null;
        if (art != null && art.HasBtns()) {
            plate = art.Btn(pressed ? 2 : 0);
        }
        if (plate != null && plate.Ok()) {
            r.DrawTexture(plate, x, y, w, h);
        } else {
            int bodyR = 40;
            int bodyG = 44;
            int bodyB = 52;
            if (pressed) { bodyR = 56; bodyG = 62; bodyB = 74; }
            R2Panel.RoundRectFill(r, x, y, w, h, 4, bodyR, bodyG, bodyB, 255);
            r.SetColor(178, 24, 24, 255);
            r.FillRect(x + 2, y + 2, w - 4, 3);
            r.SetColor(20, 22, 28, 255);
            r.FillRect(x + 2, y + h - 5, w - 4, 3);
        }
        if (disabled) {
            r.SetColor(0, 0, 0, 110);
            r.FillRect(x, y, w, h);
        }
    }

    /// <summary>One main-menu entry in the original's own art: the MNBTTN
    /// plate -- red at rest, orange under the cursor, yellow on the click
    /// frame -- with the gold CSF label over it. Entries the shell cannot
    /// honour yet draw the same plate dimmed, as the shipped menu drew all
    /// seven of its rows. Without the plates it falls back to a drawn slab.
    /// Returns true when hovered.</summary>
    static bool MenuButton(R2Canvas r, ShellArt art, int mx, int my,
                           int x, int y, int w, int h, string label,
                           bool enabled, bool disabled, bool clicked) {
        bool hov = enabled && R2Panel.PointIn(mx, my, x, y, w, h);
        int state = 0;
        if (hov) { state = clicked ? 2 : 1; }
        R2Tex plate = art != null ? art.Btn(state) : null;
        if (plate != null) {
            r.DrawTexture(plate, x, y, w, h);
            if (disabled) {
                r.SetColor(8, 8, 10, 150);
                r.FillRect(x, y, w, h);
            }
        } else {
            // No plates in this install: a drawn stand-in slab.
            int bodyR = 40;
            int bodyG = 44;
            int bodyB = 52;
            if (hov) { bodyR = 56; bodyG = 62; bodyB = 74; }
            R2Panel.RoundRectFill(r, x - 2, y - 2, w + 4, h + 4, 6, 10, 12, 16,
                               255);
            R2Panel.RoundRectFill(r, x, y, w, h, 4, bodyR, bodyG, bodyB, 255);
            r.SetColor(178, 24, 24, 255);
            r.FillRect(x + 2, y + 2, w - 4, 5);
            r.SetColor(20, 22, 28, 255);
            r.FillRect(x + 2, y + h - 6, w - 4, 4);
            if (disabled) {
                r.SetColor(8, 8, 10, 150);
                r.FillRect(x, y, w, h);
            }
        }
        int lr = 236;
        int lg = 208;
        int lb = 120;
        if (disabled) { lr = 120; lg = 122; lb = 130; }
        R2Text.DrawCenteredShadow(r, label, x + w / 2, y + h / 2 - 9, 2,
                                lr, lg, lb, 255);
        return hov;
    }

    /// <summary>The skirmish lobby, composed like the reference's
    /// compose_skirmish_lobby_page: the mnscrnl base, the right column
    /// chrome (no WARNING animation, no lower strip), the map preview in
    /// the right panel with the red frame, and the three snapped buttons
    /// 开始游戏 / 选图 / 上一页. The left half keeps the lobby's player rows
    /// and options over the film area (the reference's dialog controls are
    /// a follow-up; they sit on the same base so the page reads as one
    /// shell screen). Returns 0 none, 1 start, 2 back.</summary>
    static int DrawSkirmish(R2Canvas r, ShellArt art, Shell shell,
                            List<string> maps, R2Tex preview,
                            Strings ui, int viewW, int viewH, int mouseX,
                            int mouseY, bool clicked) {
        int action = 0;
        if (art != null && art.HasShellBg()) {
            List<int> rect = new List<int>();
            rect.Add(0); rect.Add(0); rect.Add(0); rect.Add(0);
            List<int> rgb = new List<int>();
            rgb.Add(0); rgb.Add(0); rgb.Add(0);
            ShellLayout.BaseRect(viewW, viewH, rect);
            int bx = rect[0];
            int by = rect[1];
            int bw = rect[2];
            int bh = rect[3];
            r.SetColor(0, 0, 0, 255);
            r.FillRect(bx, by, bw, bh);
            if (art.HasShellBg632()) {
                Screens.BlitShell(r, art.ShellBg632(), bx, by, 632, 570,
                                  bw, bh);
            } else {
                Screens.BlitShell(r, art.ShellBg(), bx, by, 800, 600,
                                  bw, bh);
            }
            // Right column without the WARNING window and the lower strip;
            // the map preview covers the sdtp window instead.
            int panelX = 800 - 168;
            if (art.HasPanelTop()) {
                Screens.BlitShell(r, art.PanelTop(), bx + panelX * bw / 800,
                                  by, 168, 199, bw, bh);
            }
            if (art.HasPanelTile()) {
                for (int i = 0; i < 9; i = i + 1) {
                    Screens.BlitShell(r, art.PanelTile(),
                                      bx + panelX * bw / 800,
                                      by + (199 + i * 42) * bh / 600,
                                      168, 42, bw, bh);
                }
            }
            if (art.HasPanelBottom()) {
                Screens.BlitShell(r, art.PanelBottom(),
                                  bx + panelX * bw / 800,
                                  by + 577 * bh / 600, 168, 23, bw, bh);
            }

            List<int> mp = new List<int>();
            mp.Add(0); mp.Add(0);
            bool inside = ShellLayout.FromBase(viewW, viewH, mouseX, mouseY,
                                               mp);

            // Title (遭遇战) and the map-name caption under the preview.
            int titleX = bx + (panelX + 3) * bw / 800;
            int titleY = by + 9 * bh / 600;
            int titleW = 163 * bw / 800;
            ShellLayout.TextEnabled(rgb);
            R2Text.DrawCentered(r, ui.Or("GUI:SkirmishGame", "遭遇战"),
                                titleX + titleW / 2, titleY, 2,
                                rgb[0], rgb[1], rgb[2], 255);

            // The preview rect: skirmish_right_anchor(dlu(324,23,96,69)) =
            // (328,37,144,113) on the 800x600 base. Filled dark with the
            // reference's red frame, then the built preview stretched in.
            int pvX = bx + 328 * bw / 800;
            int pvY = by + 37 * bh / 600;
            int pvW = 144 * bw / 800;
            int pvH = 113 * bh / 600;
            r.SetColor(8, 10, 16, 255);
            r.FillRect(pvX, pvY, pvW, pvH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(pvX, pvY, pvW, pvH);
            if (preview != null) {
                r.DrawTexture(preview, pvX + 2, pvY + 2, pvW - 4, pvH - 4);
            }
            // 作战 caption + map name below the preview.
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, ui.Or("GUI:Battle", "作战"),
                        bx + 328 * bw / 800, by + 168 * bh / 600, 1,
                        rgb[0], rgb[1], rgb[2], 255);
            R2Text.Draw(r, maps[shell.MapIndex()], bx + 328 * bw / 800,
                        by + 188 * bh / 600, 1, rgb[0], rgb[1], rgb[2], 255);

            // The four owner-draw buttons, snapped to the tile grid.
            // Row order and labels are the reference's
            // `SkirmishScreen.refreshSidebarButtons` (`SkirmishScreen.ts:210-240`):
            // StartGame, ChooseMap, BotUpload, and Back bottom-pinned.
            // The upload row was missing from an earlier pass; the diff
            // tool (tools/ra2_diff.py) named it as a count mismatch.
            string[] labels = new string[4];
            labels[0] = ui.Or("GUI:StartGame", "开始游戏");
            labels[1] = ui.Or("GUI:ChooseMap", "选图");
            labels[2] = ui.Or("GUI:BotUpload", "上传 AI 脚本");
            labels[3] = ui.Or("GUI:Back", "上一页");
            string[] tips = new string[4];
            tips[0] = ui.Or("STT:SkirmishButtonStartGame", "开始游戏");
            tips[1] = ui.Or("STT:SkirmishButtonChooseMap", "选择地图");
            tips[2] = ui.Or("STT:SkirmishButtonUploadBot", "上传自定义 AI 脚本包");
            tips[3] = ui.Or("STT:SkirmishButtonBack", "返回主菜单");
            int[] rowY = new int[4];
            // The three normal rows sit on tiles 1..3 (y=241, 283, 325);
            // Back is pinned to the last tile above the bottom cap, which
            // is the reference's `isBottom` slot (`MainMenu.ts:137-146`).
            rowY[0] = 199 + 42;
            rowY[1] = 199 + 84;
            rowY[2] = 199 + 126;
            rowY[3] = 577 - 42;
            int[] ids = new int[4];
            ids[0] = 1; ids[1] = 3; ids[2] = 0; ids[3] = 2;
            for (int i = 0; i < 4; i = i + 1) {
                ShellLayout.ButtonCell(rowY[i], rect);
                int cellX = bx + rect[0] * bw / 800;
                int cellY = by + rect[1] * bh / 600;
                int cellW = rect[2] * bw / 800;
                int cellH = rect[3] * bh / 600;
                bool hov = inside
                    && R2Panel.PointIn(mp[0], mp[1], rect[0], rect[1],
                                       rect[2], rect[3]);
                bool pressed = hov && clicked;
                if (pressed) { action = ids[i]; }
                int state = hov && clicked ? 4 : 2;
                R2Tex btnPlate = art != null ? art.SlotFrame(state) : null;
                if (btnPlate != null) {
                    Screens.BlitShell(r, btnPlate, cellX, cellY, cellW, cellH,
                                      bw, bh);
                } else {
                    Screens.DrawSdbtnanm(r, art, cellX, cellY, cellW, cellH,
                                         pressed, false);
                }
                ShellLayout.CaptionRect(rect[0], rect[1], rect[2], rect[3],
                                        pressed, rect);
                int capX = bx + rect[0] * bw / 800;
                int capY = by + rect[1] * bh / 600;
                int capW = rect[2] * bw / 800;
                int capH = rect[3] * bh / 600;
                ShellLayout.TextEnabled(rgb);
                R2Text.DrawCentered(r, labels[i], capX + capW / 2,
                                    capY + (capH - 12) / 2, 2,
                                    rgb[0], rgb[1], rgb[2], 255);
            }

            // The lobby's left half keeps the original's row/options
            // dialogue over the film area, in the 640x400 dialog space the
            // reference's skirmish dialog occupies. Everything below this
            // line is that dialog, reused from the earlier draft.
            Screens.LobbyLeftDialog(r, art, shell, maps, preview, ui,
                                    bx, by, bw, bh, mouseX, mouseY,
                                    clicked, inside, mp, bx, by, bw, bh);
            return action;
        }

        // No shell art: the drawn dialog stand-in, unchanged.
        R2Panel.Backdrop(r, null, viewW, viewH);
        int ah2 = viewH * 3 / 4;
        int aw2 = ah2 * 4 / 3;
        if (aw2 > viewW) { aw2 = viewW; ah2 = aw2 * 3 / 4; }
        int dx2 = (viewW - aw2) / 2;
        int dy2 = (viewH - ah2) / 2;
        int dh2 = ah2 * 400 / 480;
        if (art != null && art.HasDialog()) {
            r.DrawTexture(art.Dialog(), dx2, dy2 + (ah2 - dh2) / 2, aw2, dh2);
        } else {
            R2Panel.RoundRectFill(r, dx2, dy2 + (ah2 - dh2) / 2, aw2, dh2, 8,
                               24, 28, 38, 255);
        }
        dy2 = dy2 + (ah2 - dh2) / 2;
        ah2 = dh2;
        int act2 = Screens.LobbyDialogScaled(r, art, shell, maps, preview, ui,
                                             dx2, dy2, aw2, viewW, mouseX,
                                             mouseY, clicked);
        return act2;
    }

    /// <summary>The map picker, the screen 选图 pushes (`MapSelScreen.ts`).
    /// Its sidebar is the reference's own list: 使用地图 / 导入地图 /
    /// 取消 (`MapSelScreen.ts:211-252`), with 取消 bottom-pinned. The body is
    /// a game-mode list, the map list with its sort dropdown, and the search
    /// box (`MapSel.tsx:65-95`); the title is GUI:ChooseMap.</summary>
    static int DrawMapSelect(R2Canvas r, ShellArt art, Shell shell,
                             List<string> maps, R2Tex preview, Strings ui,
                             int viewW, int viewH, int mouseX, int mouseY,
                             bool clicked) {
        List<int> rgb = new List<int>();
        rgb.Add(0); rgb.Add(0); rgb.Add(0);
        List<int> rect = new List<int>();
        rect.Add(0); rect.Add(0); rect.Add(0); rect.Add(0);
        // The mode list the reference offers, cooperative filtered out
        // (`MapSelScreen.ts:182-184`).
        int modeCount = Shell.ModeCount() - 1;
        // The maps this mode can play. The install has no per-map game-mode
        // table yet, so every map is listed under 遭遇战 and the other modes
        // show an empty list -- the reference's filter, with the data it has.
        int mapCount = shell.MapCount();
        int act = 0;

        // A filter + sort over the map list, mirroring `MapSel.tsx:33-64`.
        // The visible order is a List<int> of map indices so the caller's
        // order is never mutated.
        List<int> order = new List<int>();
        string needle = shell.PickSearch();
        for (int i = 0; i < mapCount; i = i + 1) {
            if (shell.PickMode() != 0) { break; }
            string title = maps[i];
            if (needle == "" || Screens.ContainsIgnoreCase(title, needle)) {
                order.Add(i);
            }
        }
        Screens.SortMapOrder(order, maps, shell.PickSort());

        if (art != null && art.HasShellBg()) {
            ShellLayout.BaseRect(viewW, viewH, rect);
            int bx = rect[0];
            int by = rect[1];
            int bw = rect[2];
            int bh = rect[3];
            r.SetColor(0, 0, 0, 255);
            r.FillRect(bx, by, bw, bh);
            if (art.HasShellBg632()) {
                Screens.BlitShell(r, art.ShellBg632(), bx, by, 632, 570,
                                  bw, bh);
            } else {
                Screens.BlitShell(r, art.ShellBg(), bx, by, 800, 600,
                                  bw, bh);
            }
            int panelX = 800 - 168;
            if (art.HasPanelTop()) {
                Screens.BlitShell(r, art.PanelTop(), bx + panelX * bw / 800,
                                  by, 168, 199, bw, bh);
            }
            if (art.HasPanelTile()) {
                for (int i = 0; i < 9; i = i + 1) {
                    Screens.BlitShell(r, art.PanelTile(),
                                      bx + panelX * bw / 800,
                                      by + (199 + i * 42) * bh / 600,
                                      168, 42, bw, bh);
                }
            }
            if (art.HasPanelBottom()) {
                Screens.BlitShell(r, art.PanelBottom(),
                                  bx + panelX * bw / 800,
                                  by + 577 * bh / 600, 168, 23, bw, bh);
            }

            List<int> mp = new List<int>();
            mp.Add(0); mp.Add(0);
            bool inside = ShellLayout.FromBase(viewW, viewH, mouseX, mouseY,
                                               mp);

            // Title: 选择战役, centred in the SDTP panel the way the setup
            // screen centres 遭遇战.
            int titleX = bx + (panelX + 3) * bw / 800;
            int titleY = by + 9 * bh / 600;
            int titleW = 163 * bw / 800;
            ShellLayout.TextEnabled(rgb);
            R2Text.DrawCentered(r, ui.Or("GUI:ChooseMap", "选择战役"),
                                titleX + titleW / 2, titleY, 2,
                                rgb[0], rgb[1], rgb[2], 255);

            // ---- the body, in the reference's three columns ---------------
            // The form fills the film area: the mode list on the left, the
            // map list in the middle, the search box under it.
            int bodyX = bx + 24 * bw / 800;
            int bodyY = by + 30 * bh / 600;
            int modeW = 130 * bw / 800;
            int listW = 300 * bw / 800;
            int rowH = 20 * bh / 600;
            int listX = bodyX + modeW + 16 * bw / 800;
            int listH = 300 * bh / 600;

            // Game-mode list.
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, ui.Or("GUI:GameType", "游戏类型"), bodyX, bodyY, 1,
                        rgb[0], rgb[1], rgb[2], 255);
            for (int i = 0; i < modeCount; i = i + 1) {
                int iy = bodyY + rowH + i * rowH;
                bool sel = i == shell.PickMode();
                bool hov = inside && R2Panel.PointIn(
                    mp[0], mp[1], 24, 30 + (i + 1) * 20, modeW * 800 / bw,
                    20);
                if (sel) {
                    r.SetColor(48, 28, 8, 255);
                    r.FillRect(bodyX, iy, modeW, rowH);
                } else if (hov) {
                    r.SetColor(30, 20, 12, 255);
                    r.FillRect(bodyX, iy, modeW, rowH);
                }
                ShellLayout.TextEnabled(rgb);
                R2Text.Draw(r, Shell.ModeLabel(i), bodyX + 4, iy + 2, 1,
                            rgb[0], rgb[1], rgb[2], 255);
                if (hov && clicked) {
                    shell.SetPickMode(i);
                    act = 0;
                }
            }

            // Map list + its 排序 dropdown. The sort control is a Select in
            // the reference (`MapSel.tsx:71-78`), so it cycles its five
            // options.
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, ui.Or("GUI:GameMap", "游戏地图"), listX, bodyY, 1,
                        rgb[0], rgb[1], rgb[2], 255);
            int sortX = listX + listW - 110 * bw / 800;
            int sortW = 110 * bw / 800;
            bool sortHov = inside && R2Panel.PointIn(
                mp[0], mp[1], 24 + 130 + 16 + 300 - 110, 30, 110, 14);
            r.SetColor(12, 12, 18, 255);
            r.FillRect(sortX, bodyY - 2, sortW, rowH);
            r.SetColor(sortHov ? 210 : 180, 24, 24, 255);
            r.DrawRect(sortX, bodyY - 2, sortW, rowH);
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, Screens.SortLabel(shell.PickSort()), sortX + 4,
                        bodyY, 1, rgb[0], rgb[1], rgb[2], 255);
            if (sortHov && clicked) {
                shell.SetPickSort((shell.PickSort() + 1) % 5);
            }

            // The rows themselves.
            int listTop = bodyY + rowH;
            r.SetColor(8, 8, 12, 255);
            r.FillRect(listX, listTop, listW, listH);
            r.SetColor(120, 20, 20, 255);
            r.DrawRect(listX, listTop, listW, listH);
            int visible = listH / rowH;
            int scroll = shell.PickScroll();
            int shown = 0;
            for (int k = 0; k < order.Count; k = k + 1) {
                if (k < scroll) { continue; }
                if (shown >= visible) { break; }
                int idx = order[k];
                int iy = listTop + shown * rowH;
                bool sel = idx == shell.PickMap();
                bool hov = inside && R2Panel.PointIn(
                    mp[0], mp[1], 24 + 130 + 16, 30 + 20 + k * 20,
                    listW * 800 / bw, 20);
                if (sel) {
                    r.SetColor(48, 28, 8, 255);
                    r.FillRect(listX, iy, listW, rowH);
                } else if (hov) {
                    r.SetColor(30, 20, 12, 255);
                    r.FillRect(listX, iy, listW, rowH);
                }
                ShellLayout.TextEnabled(rgb);
                R2Text.Draw(r, maps[idx], listX + 4, iy + 2, 1,
                            rgb[0], rgb[1], rgb[2], 255);
                if (hov && clicked) {
                    shell.SetPickMap(idx, mapCount);
                    act = 0;
                }
                shown = shown + 1;
            }
            if (order.Count == 0) {
                ShellLayout.TextDisabled(rgb);
                R2Text.Draw(r, "（没有符合条件的地图）", listX + 4,
                            listTop + 4, 1, rgb[0], rgb[1], rgb[2], 255);
            }

            // Scrollbar, only when the list overflows.
            if (order.Count > visible && visible > 0) {
                int sbX = listX + listW + 3 * bw / 800;
                int sbW = 8 * bw / 800;
                r.SetColor(24, 12, 12, 255);
                r.FillRect(sbX, listTop, sbW, listH);
                int thumbH = listH * visible / order.Count;
                if (thumbH < 8) { thumbH = 8; }
                int travel = listH - thumbH;
                int maxScroll = order.Count - visible;
                if (maxScroll < 1) { maxScroll = 1; }
                int thumbY = listTop + scroll * travel / maxScroll;
                r.SetColor(200, 40, 40, 255);
                r.FillRect(sbX, thumbY, sbW, thumbH);
            }

            // The search box (`MapSel.tsx:90-95`).
            int srchY = listTop + listH + 8 * bh / 600;
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, ui.Or("GUI:Search", "搜索"), listX, srchY, 1,
                        rgb[0], rgb[1], rgb[2], 255);
            int boxX = listX + 50 * bw / 800;
            int boxW = listW - 50 * bw / 800;
            r.SetColor(8, 8, 12, 255);
            r.FillRect(boxX, srchY - 2, boxW, rowH);
            r.SetColor(140, 24, 24, 255);
            r.DrawRect(boxX, srchY - 2, boxW, rowH);
            string shownSearch = shell.PickSearch();
            if (shownSearch == "") { shownSearch = "…"; }
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, shownSearch, boxX + 4, srchY, 1, rgb[0], rgb[1],
                        rgb[2], 255);

            // The preview sits in the sidebar's SDTP window the way the
            // setup screen's does, so the picker shows what is selected.
            int pvX = bx + 328 * bw / 800;
            int pvY = by + 37 * bh / 600;
            int pvW = 144 * bw / 800;
            int pvH = 113 * bh / 600;
            r.SetColor(8, 10, 16, 255);
            r.FillRect(pvX, pvY, pvW, pvH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(pvX, pvY, pvW, pvH);
            if (preview != null) {
                r.DrawTexture(preview, pvX + 2, pvY + 2, pvW - 4, pvH - 4);
            }
            ShellLayout.TextEnabled(rgb);
            if (shell.PickMap() >= 0 && shell.PickMap() < mapCount) {
                R2Text.Draw(r, maps[shell.PickMap()], bx + 328 * bw / 800,
                            by + 188 * bh / 600, 1, rgb[0], rgb[1], rgb[2],
                            255);
            }

            // The sidebar: 使用地图, 导入地图, 取消 (bottom).
            string[] labels = new string[3];
            labels[0] = ui.Or("GUI:UseMap", "使用地图");
            labels[1] = ui.Or("TS:ImportMap", "导入地图");
            labels[2] = ui.Or("GUI:Cancel", "取消");
            int[] ids = new int[3];
            ids[0] = 1; ids[1] = 2; ids[2] = 3;
            int[] rowIndex = new int[3];
            rowIndex[0] = 0;
            rowIndex[1] = 1;
            rowIndex[2] = ShellLayout.SlotCount() - 1;   // 取消 pinned bottom
            for (int i = 0; i < 3; i = i + 1) {
                ShellLayout.ButtonCell(ShellLayout.SlotTopY()
                                       + rowIndex[i] * ShellLayout.TileH(),
                                       rect);
                int cellX = bx + rect[0] * bw / 800;
                int cellY = by + rect[1] * bh / 600;
                int cellW = rect[2] * bw / 800;
                int cellH = rect[3] * bh / 600;
                bool hov = inside && R2Panel.PointIn(
                    mp[0], mp[1], rect[0], rect[1], rect[2], rect[3]);
                // 导入地图 imports from the local filesystem, which this
                // build has no picker for; it draws Unlit the way the
                // reference draws a disabled entry.
                bool usable = i != 1;
                int state = !usable ? 1 : (hov && clicked ? 4 : 2);
                R2Tex plate = art != null ? art.SlotFrame(state) : null;
                if (plate != null) {
                    Screens.BlitShell(r, plate, cellX, cellY, cellW, cellH,
                                      bw, bh);
                } else {
                    Screens.DrawSdbtnanm(r, art, cellX, cellY, cellW, cellH,
                                         hov && clicked, !usable);
                }
                ShellLayout.CaptionRect(rect[0], rect[1], rect[2], rect[3],
                                        hov && clicked, rect);
                int capX = bx + rect[0] * bw / 800;
                int capY = by + rect[1] * bh / 600;
                int capW = rect[2] * bw / 800;
                int capH = rect[3] * bh / 600;
                if (usable) { ShellLayout.TextEnabled(rgb); }
                else { ShellLayout.TextDisabled(rgb); }
                R2Text.DrawCentered(r, labels[i], capX + capW / 2,
                                    capY + (capH - 12) / 2, 2,
                                    rgb[0], rgb[1], rgb[2], 255);
                if (hov && clicked && usable) { act = ids[i]; }
            }

            // The strip carries the selected mode's own description, the
            // reference's gameMode.description tooltip
            // (`MapSel.tsx:68`).
            string tip = Shell.ModeDescription(shell.PickMode());
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, tip, bx + 10 * bw / 800, by + (600 - 21) * bh / 600,
                        1, rgb[0], rgb[1], rgb[2], 255);
            return act;
        }

        // No shell art: the same screen on the drawn backdrop.
        R2Panel.Backdrop(r, null, viewW, viewH);
        R2Text.DrawCentered(r, ui.Or("GUI:ChooseMap", "选择战役"),
                            viewW / 2, 24, 2, 255, 214, 0, 255);
        return 0;
    }

    /// <summary>Case-insensitive substring test for the map search box
    /// (`MapSel.tsx:62` lowercases both sides).</summary>
    static bool ContainsIgnoreCase(string hay, string needle) {
        if (needle == "") { return true; }
        string h = Screens.Lower(hay);
        string n = Screens.Lower(needle);
        if (n.Length > h.Length) { return false; }
        for (int i = 0; i + n.Length <= h.Length; i = i + 1) {
            bool same = true;
            for (int k = 0; k < n.Length; k = k + 1) {
                if (h[i + k] != n[k]) { same = false; break; }
            }
            if (same) { return true; }
        }
        return false;
    }

    static string Lower(string s) {
        string low = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            low = low + (char)c;
        }
        return low;
    }

    static string SortLabel(int s) {
        if (s == 1) { return "名称 ↓"; }
        if (s == 2) { return "名称 ↑"; }
        if (s == 3) { return "人数 ↓"; }
        if (s == 4) { return "人数 ↑"; }
        return "不排序";
    }

    /// <summary>Applies the picker's sort to the visible order, in place
    /// (`MapSel.tsx:33-48`). Insertion sort: the lists are small and this
    /// keeps the original order stable for equal keys.</summary>
    static void SortMapOrder(List<int> order, List<string> maps, int sort) {
        if (sort == 0) { return; }
        for (int i = 1; i < order.Count; i = i + 1) {
            int cur = order[i];
            int j = i - 1;
            while (j >= 0 && Screens.MapBefore(order[j], cur, maps, sort)) {
                order[j + 1] = order[j];
                j = j - 1;
            }
            order[j + 1] = cur;
        }
    }

    /// <summary>True when a should sort after b.</summary>
    static bool MapBefore(int a, int b, List<string> maps, int sort) {
        int cmp = 0;
        if (sort == 1 || sort == 2) {
            cmp = Screens.CompareName(maps[a], maps[b]);
            if (sort == 2) { cmp = 0 - cmp; }
        }
        // The install has no per-map max-slot table yet, so the two
        // player-count orders fall back to the map order -- the reference
        // sorts on maxSlots, which this port cannot read until the map
        // header is parsed for it.
        if (cmp > 0) { return true; }
        return false;
    }

    /// <summary>Case-insensitive name compare, the reference's
    /// localeCompare on the lowercased titles.</summary>
    static int CompareName(string a, string b) {
        string la = Screens.Lower(a);
        string lb = Screens.Lower(b);
        int n = la.Length < lb.Length ? la.Length : lb.Length;
        for (int i = 0; i < n; i = i + 1) {
            int ca = la[i] & 255;
            int cb = lb[i] & 255;
            if (ca != cb) { return ca < cb ? 0 - 1 : 1; }
        }
        if (la.Length == lb.Length) { return 0; }
        return la.Length < lb.Length ? 0 - 1 : 1;
    }

    /// <summary>The lobby's left half -- player rows, options and the map
    /// row -- drawn in shell space over the film area. Hit tests run in
    /// shell coordinates (mp). The geometry follows the reference's
    /// skirmish dialog: rows start at DLU y=11, flags at x=143, country
    /// faces at x=180, colour faces at x=264, AI faces at x=35, the
    /// checkboxes down the left edge, the three trackbars at x=214.</summary>
    static void LobbyLeftDialog(R2Canvas r, ShellArt art, Shell shell,
                                List<string> maps, R2Tex preview,
                                Strings ui, int dx, int dy, int dScaleX,
                                int dScaleY, int mouseX, int mouseY,
                                bool clicked, bool inside, List<int> mp,
                                int bx, int by, int bw, int bh) {
        List<int> rgb = new List<int>();
        rgb.Add(0); rgb.Add(0); rgb.Add(0);
        List<int> rect = new List<int>();
        rect.Add(0); rect.Add(0); rect.Add(0); rect.Add(0);
        // DLU math: x*6/4, y*13/8 rounded -- the reference's dlu_rect.
        // Player rows: local + 7 AI rows, y DLU 11 + 16*i.
        for (int i = 0; i < 8; i = i + 1) {
            int dluY = 11 + i * 16;
            int py = dy + Screens.DluY(dluY) * bh / 600;
            // AI faces (rows 1..7) at DLU x=35 w=100; the local player's
            // name sits at the same x (DLU 35..135).
            int faceX = dx + Screens.DluX(35) * bw / 800;
            int faceW = Screens.DluX(100) * bw / 800;
            int faceH = Screens.DluY(10) * bh / 600;
            bool player = i == 0;
            bool open = player || shell.EnemyOpen(i - 1);
            if (!open) {
                r.SetColor(16, 16, 20, 180);
                r.FillRect(faceX, py, faceW, faceH);
                r.SetColor(180, 24, 24, 255);
                r.DrawRect(faceX, py, faceW, faceH);
                bool hov = inside && R2Panel.PointIn(mp[0], mp[1],
                    Screens.DluX(35), Screens.DluY(dluY), faceW * 800 / bw,
                    faceH * 600 / bh);
                if (hov) {
                    R2Text.DrawCentered(r, "+", faceX + faceW / 2, py, 1,
                                      255, 214, 0, 255);
                    if (clicked) { shell.ToggleEnemyOpen(i - 1); }
                }
                continue;
            }
            r.SetColor(8, 8, 12, 255);
            r.FillRect(faceX, py, faceW, faceH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(faceX, py, faceW, faceH);
            r.SetColor(16, 16, 20, 255);
            r.FillRect(faceX + 2, py + 2, faceW - 4, faceH - 4);
            string name = player
                ? ui.Or("GUI:Commander", "指挥官")
                : Difficulty.NameOf(shell.EnemyDifficulty(i - 1));
            if (player) {
                ShellLayout.TextEnabled(rgb);
            } else {
                ShellLayout.TextDisabled(rgb);
            }
            R2Text.Draw(r, name, faceX + 4, py + 2, 1, rgb[0], rgb[1],
                        rgb[2], 255);
            if (player && clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(35), Screens.DluY(dluY),
                    faceW * 800 / bw, faceH * 600 / bh)) {
                shell.SetCountryListOpen(!shell.CountryListOpen());
            }
            if (!player && clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(35), Screens.DluY(dluY),
                    faceW * 800 / bw, faceH * 600 / bh)) {
                // The AI row's difficulty opens a list, the way the
                // reference's AI slots each own a Select
                // (`LobbyForm.tsx:247-256`); one list is ever down, which the
                // shell tracks in openList.
                if (shell.OpenList() == Shell.ListEnemyDiff()
                 && shell.OpenSlot() == i - 1) {
                    shell.CloseList();
                } else {
                    shell.SetOpenList(Shell.ListEnemyDiff(), i - 1);
                }
            }

            // Country face (row 0 and any open AI row), DLU x=180 w=78.
            int cX = dx + Screens.DluX(180) * bw / 800;
            int cW = Screens.DluX(78) * bw / 800;
            r.SetColor(8, 8, 12, 255);
            r.FillRect(cX, py, cW, faceH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(cX, py, cW, faceH);
            r.SetColor(16, 16, 20, 255);
            r.FillRect(cX + 2, py + 2, cW - 4, faceH - 4);
            string country = player
                ? Shell.FlatName(shell.FlatIndex()) : "随机(???)";
            if (!player) {
                country = shell.EnemyCountryName(i - 1);
            }
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, country, cX + 4, py + 2, 1, rgb[0], rgb[1],
                        rgb[2], 255);
            if (clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(180), Screens.DluY(dluY),
                    cW * 800 / bw, faceH * 600 / bh)) {
                // The player's list and an AI row's list are the same flat
                // list; only the target differs, which openSlot carries.
                if (player) {
                    shell.SetCountryListOpen(!shell.CountryListOpen());
                } else if (shell.OpenList() == Shell.ListEnemyCountry()
                        && shell.OpenSlot() == i - 1) {
                    shell.CloseList();
                } else {
                    shell.SetOpenList(Shell.ListEnemyCountry(), i - 1);
                }
            }

            // Colour face, DLU x=264 w=35: the player's cycles the eight;
            // AI rows carry their own colour, 随机 by default and settable
            // per row (`LobbyForm.tsx:247-256` gives every AI a ColorSelect).
            int kX = dx + Screens.DluX(264) * bw / 800;
            int kW = Screens.DluX(35) * bw / 800;
            int cr2 = 196;
            int cg2 = 32;
            int cb2 = 32;
            if (player) {
                List<int> rgbp = new List<int>();
                Shell.ColorRgb(shell.ColorIndex(), rgbp);
                cr2 = rgbp[0]; cg2 = rgbp[1]; cb2 = rgbp[2];
            } else {
                // A row that has not been given a colour keeps the hostile
                // default swatch; once the player picks one, the row wears
                // the real house colour -- including the same colour the
                // player picked, which the original allows.
                int aiCol = shell.EnemyColor(i - 1);
                if (aiCol >= 0) {
                    List<int> rgbp = new List<int>();
                    Shell.ColorRgb(aiCol, rgbp);
                    cr2 = rgbp[0]; cg2 = rgbp[1]; cb2 = rgbp[2];
                } else {
                    List<int> dot = new List<int>();
                    Screens.EnemySwatch(i, dot);
                    cr2 = dot[0]; cg2 = dot[1]; cb2 = dot[2];
                }
            }
            r.SetColor(8, 8, 12, 255);
            r.FillRect(kX, py, kW, faceH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(kX, py, kW, faceH);
            r.SetColor(cr2, cg2, cb2, 255);
            r.FillRect(kX + 2, py + 2, kW - 4, faceH - 4);
            if (clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(264), Screens.DluY(dluY),
                    kW * 800 / bw, faceH * 600 / bh)) {
                if (player) {
                    shell.SetColor((shell.ColorIndex() + 1) % 8);
                } else {
                    // Cycle 随机 -> colour 0..7 -> back to 随机.
                    int next = shell.EnemyColor(i - 1) + 1;
                    if (next > 7) { next = 0 - 1; }
                    shell.SetEnemyColor(i - 1, next);
                }
            }

            // Start-position face, DLU x=322 w=42 -- the column the earlier
            // revision dropped entirely. The original shows the map's start
            // waypoint number, with 1 being the first free spot; the player
            // can pin one, the AI takes what is left.
            int spX = dx + Screens.DluX(322) * bw / 800;
            int spW = Screens.DluX(42) * bw / 800;
            r.SetColor(8, 8, 12, 255);
            r.FillRect(spX, py, spW, faceH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(spX, py, spW, faceH);
            string spTxt = Convert.ToString(i + 1);
            if (player && shell.StartPosIndex() == 0) { spTxt = "随机"; }
            ShellLayout.TextEnabled(rgb);
            R2Text.DrawCentered(r, spTxt, spX + spW / 2, py + 2, 1,
                                rgb[0], rgb[1], rgb[2], 255);
            if (player && clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(322), Screens.DluY(dluY),
                    spW * 800 / bw, faceH * 600 / bh)) {
                shell.SetStartPos((shell.StartPosIndex() + 1) % 9);
            }

            // Team face, DLU x=372 w=28: 无 or A..D, the four the reference
            // caps at (`PregameController.ts:357`).
            int tmX = dx + Screens.DluX(372) * bw / 800;
            int tmW = Screens.DluX(28) * bw / 800;
            r.SetColor(8, 8, 12, 255);
            r.FillRect(tmX, py, tmW, faceH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(tmX, py, tmW, faceH);
            int tmVal = player ? shell.TeamIndex() : shell.EnemyTeam(i - 1);
            ShellLayout.TextEnabled(rgb);
            R2Text.DrawCentered(r, Team.NameOf(tmVal), tmX + tmW / 2, py + 2,
                                1, rgb[0], rgb[1], rgb[2], 255);
            if (clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(372), Screens.DluY(dluY),
                    tmW * 800 / bw, faceH * 600 / bh)) {
                // 无 -> A -> B -> C -> D -> 无.
                int next = tmVal + 1;
                if (next >= Team.Max()) { next = Team.None(); }
                if (player) { shell.SetTeam(next); }
                else { shell.SetEnemyTeam(i - 1, next); }
            }
        }

        // The option checkboxes. The reference's lobby form shows these down
        // the left column and the build-off-ally one in the right column
        // (`LobbyForm.tsx:148-217`); the labels are its CSF keys. All of them
        // draw and all of them toggle -- the earlier revision declared five
        // labels but looped `i < 5 && i < 4`, so 联军建筑 was dead.
        string[] checkLabels = new string[8];
        checkLabels[0] = ui.Or("GUI:ShortGame", "快速游戏");
        checkLabels[1] = ui.Or("GUI:MCVRepacks", "基地重新部署");
        checkLabels[2] = ui.Or("GUI:CratesAppear", "升级工具箱");
        checkLabels[3] = ui.Or("GUI:Superweapons", "超级武器");
        checkLabels[4] = ui.Or("GUI:DestroyableBridges", "可摧毁桥梁");
        checkLabels[5] = ui.Or("GUI:MultiEngineer", "多人工程师");
        checkLabels[6] = ui.Or("GUI:NoDogEngiKills", "警犬不杀工程师");
        checkLabels[7] = ui.Or("GUI:BuildOffAlly", "联军建筑");
        bool[] checkVals = new bool[8];
        checkVals[0] = shell.ShortGame();
        checkVals[1] = shell.McvRedeploy();
        checkVals[2] = shell.Crates();
        checkVals[3] = shell.Superweapons();
        checkVals[4] = shell.DestroyableBridges();
        checkVals[5] = shell.MultiEngineer();
        checkVals[6] = shell.NoDogEngiKills();
        checkVals[7] = shell.BuildOffAlly();
        for (int i = 0; i < 8; i = i + 1) {
            // Seven down the left edge (DLU x=35, y 145 + 17*i); 联军建筑
            // sits in the right column under the three sliders, the way the
            // reference places BuildOffAlly (`LobbyForm.tsx:212-217`).
            int dluY = 145 + i * 17;
            int dluX = 35;
            if (i == 7) { dluY = 196; dluX = 320; }
            int cbX = dx + Screens.DluX(dluX) * bw / 800;
            int cbY = dy + Screens.DluY(dluY) * bh / 600;
            int cbS = Screens.DluX(18) * bw / 800;
            r.SetColor(90, 20, 20, 255);
            r.FillRect(cbX, cbY, cbS, cbS);
            r.SetColor(200, 40, 40, 255);
            r.DrawRect(cbX, cbY, cbS, cbS);
            r.SetColor(12, 12, 16, 255);
            r.FillRect(cbX + 2, cbY + 2, cbS - 4, cbS - 4);
            if (checkVals[i]) {
                r.SetColor(255, 160, 32, 255);
                r.FillRect(cbX + 4, cbY + 4, cbS - 8, cbS - 8);
            }
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, checkLabels[i], cbX + cbS + 6, cbY, 1,
                        rgb[0], rgb[1], rgb[2], 255);
            if (clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(dluX), Screens.DluY(dluY),
                    110, 14)) {
                if (i == 0) { shell.ToggleShortGame(); }
                if (i == 1) { shell.ToggleMcvRedeploy(); }
                if (i == 2) { shell.ToggleCrates(); }
                if (i == 3) { shell.ToggleSuperweapons(); }
                if (i == 4) { shell.ToggleDestroyableBridges(); }
                if (i == 5) { shell.ToggleMultiEngineer(); }
                if (i == 6) { shell.ToggleNoDogEngiKills(); }
                if (i == 7) { shell.ToggleBuildOffAlly(); }
            }
        }

        // The three trackbars with their labels, DLU (146,y) label +
        // (214,y) 85x13 track: speed, credits, units.
        int[] trackY = new int[3];
        trackY[0] = 145;
        trackY[1] = 162;
        trackY[2] = 179;
        string[] trackLabels = new string[3];
        trackLabels[0] = ui.Or("GUI:GameSpeed", "游戏速度");
        trackLabels[1] = ui.Or("GUI:Credits", "资金");
        trackLabels[2] = ui.Or("GUI:UnitCount", "部队数");
        for (int i = 0; i < 3; i = i + 1) {
            int lbX = dx + Screens.DluX(146) * bw / 800;
            int lbY = dy + Screens.DluY(trackY[i]) * bh / 600;
            ShellLayout.TextEnabled(rgb);
            R2Text.Draw(r, trackLabels[i], lbX, lbY, 1,
                        rgb[0], rgb[1], rgb[2], 255);
            int trX = dx + Screens.DluX(214) * bw / 800;
            int trY = lbY;
            int trW = Screens.DluX(85) * bw / 800;
            int trH = Screens.DluY(13) * bh / 600;
            r.SetColor(64, 16, 16, 255);
            r.FillRect(trX, trY, trW, trH);
            r.SetColor(12, 12, 16, 255);
            r.FillRect(trX + 2, trY + 2, trW - 4, trH - 4);
            // The three sliders. Speed has seven stops (0..6), units 0..10,
            // and money the original's own span -- the reference clamps it to
            // 500..100000 (`Shell.AdjustCredits`), so the thumb maps that
            // range rather than a 0..100 grid, which used to leave both ends
            // of the track unreachable.
            int pos = 0;
            int max = 1;
            if (i == 0) { pos = shell.GameSpeed(); max = 6; }
            if (i == 1) {
                pos = (shell.StartCredits() - 500) * 100 / 99500;
                max = 100;
            }
            if (i == 2) { pos = shell.UnitCount(); max = 10; }
            int thumbW = Screens.DluX(12) * bw / 800;
            int travel = trW - 4 - thumbW;
            if (travel < 1) { travel = 1; }
            int thumbX = trX + 2 + pos * travel / max;
            r.SetColor(220, 40, 40, 255);
            r.FillRect(thumbX, trY - 1, thumbW, trH + 2);
            string val = Convert.ToString(i == 1
                ? shell.StartCredits() : pos);
            R2Text.Draw(r, val, trX + trW + 6, trY, 1, rgb[0], rgb[1],
                        rgb[2], 255);
            if (clicked && inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(214), Screens.DluY(trackY[i]),
                    85, 13)) {
                int half = (mp[0] - Screens.DluX(214)) * max / 85;
                if (i == 0) { shell.SetSpeed(half); }
                if (i == 1) {
                    shell.AdjustCredits(500 + half * 99500 / 100
                                        - shell.StartCredits());
                }
                if (i == 2) { shell.AdjustUnits(half - shell.UnitCount()); }
            }
        }

        // The country dropdown, over the rows: right under the face that
        // opened it -- the player's own row, or an AI row. The reference
        // gives every slot a CountrySelect, so the same list serves both
        // (`LobbyForm.tsx:247-256`).
        bool countryListOpen = shell.CountryListOpen()
            || shell.OpenList() == Shell.ListEnemyCountry();
        int countryListRow = 0;
        if (shell.OpenList() == Shell.ListEnemyCountry()) {
            countryListRow = shell.OpenSlot() + 1;
        }
        if (countryListOpen) {
            int clDluY = 11 + countryListRow * 16;
            int listX = dx + Screens.DluX(180) * bw / 800;
            int listY = dy + Screens.DluY(clDluY + 10) * bh / 600;
            int listW = Screens.DluX(78) * bw / 800;
            // 随机 plus the ten real countries, so an AI row can go back to
            // random after a concrete pick.
            int rows = Shell.FlatCount() + 1;
            int listH = rows * Screens.DluY(15) * bh / 600;
            r.SetColor(12, 12, 18, 255);
            r.FillRect(listX, listY, listW, listH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(listX, listY, listW, listH);
            bool took = false;
            int cur = shell.OpenList() == Shell.ListEnemyCountry()
                ? shell.EnemyCountry(shell.OpenSlot()) : shell.FlatIndex();
            for (int i = 0; i < rows; i = i + 1) {
                int idx = i;
                int rowH = Screens.DluY(15) * bh / 600;
                int iy = listY + i * rowH;
                string nm = Shell.FlatName(idx);
                bool hov = inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(180),
                    Screens.DluY(clDluY + 10) + i * 15, 78, 15);
                if (idx == cur) {
                    r.SetColor(48, 28, 8, 255);
                    r.FillRect(listX, iy, listW, rowH);
                } else if (hov) {
                    r.SetColor(30, 20, 12, 255);
                    r.FillRect(listX, iy, listW, rowH);
                }
                ShellLayout.TextEnabled(rgb);
                R2Text.Draw(r, nm, listX + 4, iy, 1, rgb[0], rgb[1],
                            rgb[2], 255);
                if (hov && clicked) {
                    if (shell.OpenList() == Shell.ListEnemyCountry()) {
                        shell.SetEnemyCountry(shell.OpenSlot(), idx);
                        shell.CloseList();
                    } else {
                        shell.SetFlatCountry(idx);
                        shell.SetCountryListOpen(false);
                    }
                    took = true;
                }
            }
            if (clicked && !took) { }   // click inside the list stays open
        }
        if (clicked && inside && !R2Panel.PointIn(mp[0], mp[1],
                Screens.DluX(180), Screens.DluY(21), 78,
                15 * (Shell.FlatCount() + 1)) && countryListOpen
            && !R2Panel.PointIn(mp[0], mp[1], Screens.DluX(180),
                                Screens.DluY(11 + countryListRow * 16),
                                78, 10)) {
            shell.CloseList();
        }

        // An AI row's difficulty list, hung under the row's name face. All
        // five of the reference's skill names are offered
        // (`PregameController.ts:312-323`).
        if (shell.OpenList() == Shell.ListEnemyDiff()) {
            int slot = shell.OpenSlot();
            int row = slot + 1;
            int dluY = 11 + row * 16;
            int listX = dx + Screens.DluX(35) * bw / 800;
            int listY = dy + Screens.DluY(dluY + 10) * bh / 600;
            int listW = Screens.DluX(100) * bw / 800;
            int rowH = Screens.DluY(15) * bh / 600;
            int listH = Difficulty.Count() * rowH;
            r.SetColor(12, 12, 18, 255);
            r.FillRect(listX, listY, listW, listH);
            r.SetColor(180, 24, 24, 255);
            r.DrawRect(listX, listY, listW, listH);
            bool tookDiff = false;
            for (int k = 0; k < Difficulty.Count(); k = k + 1) {
                int iy = listY + k * rowH;
                bool hov = inside && R2Panel.PointIn(
                    mp[0], mp[1], Screens.DluX(35), Screens.DluY(dluY + 10)
                    + k * 15, 100, 15);
                if (k == shell.EnemyDifficulty(slot)) {
                    r.SetColor(48, 28, 8, 255);
                    r.FillRect(listX, iy, listW, rowH);
                } else if (hov) {
                    r.SetColor(30, 20, 12, 255);
                    r.FillRect(listX, iy, listW, rowH);
                }
                ShellLayout.TextEnabled(rgb);
                R2Text.Draw(r, Difficulty.NameOf(k), listX + 4, iy, 1,
                            rgb[0], rgb[1], rgb[2], 255);
                if (hov && clicked) {
                    shell.SetEnemyDifficulty(slot, k);
                    shell.CloseList();
                    tookDiff = true;
                }
            }
            if (clicked && inside && !tookDiff
             && !R2Panel.PointIn(mp[0], mp[1], Screens.DluX(35),
                                 Screens.DluY(dluY + 10), 100,
                                 15 * Difficulty.Count())
             && !R2Panel.PointIn(mp[0], mp[1], Screens.DluX(35),
                                 Screens.DluY(dluY), 100, 10)) {
                shell.CloseList();
            }
        }
    }

    /// <summary>DLU to shell pixels: x * 6/4 rounded (mul_div_round).</summary>
    static int DluX(int v) {
        return (v * 6 + 2) / 4;
    }

    /// <summary>DLU to shell pixels: y * 13/8 rounded.</summary>
    static int DluY(int v) {
        return (v * 13 + 4) / 8;
    }

    /// <summary>The dialog-space lobby body used when the install carries
    /// no shell art (the DBAK6440 stand-in). The old 640x400 layout, kept
    /// so the setup screen still works without the sprites.</summary>
    static int LobbyDialogScaled(R2Canvas r, ShellArt art, Shell shell,
                                 List<string> maps, R2Tex preview,
                                 Strings ui, int dx, int dy, int aw,
                                 int viewW, int mouseX, int mouseY,
                                 bool clicked) {
        int used = 0;
        int slotX = dx + 20 * aw / 640;
        int slotW = 360 * aw / 640;
        int slotH = 24 * aw / 640;
        int dropX = slotX + 174 * aw / 640;
        int dropY = dy + 84 * aw / 640;
        int dropW = 140 * aw / 640;
        int dropH = (Shell.FlatCount() * 24 + 8) * aw / 640;

        for (int i = 0; i < 8; i = i + 1) {
            int ry = dy + (52 + i * 28) * aw / 640;
            bool player = i == 0;
            if (!player && !shell.EnemyOpen(i - 1)) {
                R2Panel.RoundRectFill(r, slotX, ry, slotW, slotH, 4,
                                   26, 30, 40, 140);
                R2Text.DrawCentered(r, "关闭(点击加入)", slotX + slotW / 2,
                                  ry + slotH / 2 - 7, 1, 96, 100, 112, 200);
                if (clicked && R2Panel.PointIn(mouseX, mouseY, slotX, ry,
                                            slotW, slotH)) {
                    shell.ToggleEnemyOpen(i - 1);
                    used = 1;
                }
                continue;
            }

            R2Panel.RoundRectFill(r, slotX, ry, slotW, slotH, 4, 30, 34, 46, 220);
            bool hovRow = R2Panel.PointIn(mouseX, mouseY, slotX, ry, slotW,
                                       slotH);
            if (hovRow) {
                R2Panel.RoundRectStroke(r, slotX, ry, slotW, slotH, 4, 2,
120, 128, 142, 200);
            }

            string spotText = "随";
            if (player) {
                if (shell.StartPosIndex() > 0) {
                    spotText = Convert.ToString(shell.StartPosIndex());
                }
            } else {
                spotText = Convert.ToString(shell.StartPosIndex() % 4 + i);
            }
            R2Panel.RoundRectFill(r, slotX + 4 * aw / 640, ry + 3 * aw / 640, 26 * aw / 640,
                               slotH - 6 * aw / 640, 4, 40, 44, 58, 255);
            R2Text.DrawCentered(r, spotText, slotX + 17 * aw / 640,
                              ry + slotH / 2 - 7, 1, 236, 208, 120, 255);

            string name = player ? "指挥官"
                : Difficulty.NameOf(shell.EnemyDifficulty(i - 1));
            R2Panel.RoundRectFill(r, slotX + 34 * aw / 640, ry + 3 * aw / 640, 106 * aw / 640,
                               slotH - 6 * aw / 640, 4, 40, 44, 58, 255);
            R2Text.DrawCentered(r, name, slotX + 87 * aw / 640, ry + slotH / 2 - 7,
                              1, 224, 228, 238, 255);
            bool hovName = R2Panel.PointIn(mouseX, mouseY, slotX + 34 * aw / 640,
                                        ry + 3 * aw / 640, 106 * aw / 640, slotH - 6 * aw / 640);
            if (hovName && !player && clicked) {
                shell.CycleEnemyDifficulty(i - 1);
                used = 1;
            }

            string country = player
                ? Shell.FlatName(shell.FlatIndex()) : "随机(???)";
            R2Panel.RoundRectFill(r, slotX + 146 * aw / 640, ry + 3 * aw / 640, 110 * aw / 640,
                               slotH - 6 * aw / 640, 4, 40, 44, 58, 255);
            R2Text.DrawCentered(r, country, slotX + 201 * aw / 640, ry + slotH / 2 - 7,
                              1, 224, 228, 238, 255);
            if (player) {
                bool hovC = R2Panel.PointIn(mouseX, mouseY, slotX + 146 * aw / 640,
                                         ry + 3 * aw / 640, 110 * aw / 640, slotH - 6 * aw / 640);
                if (hovC && clicked) {
                    shell.SetCountryListOpen(!shell.CountryListOpen());
                    used = 1;
                }
            } else {
                bool hovC = R2Panel.PointIn(mouseX, mouseY, slotX + 146 * aw / 640,
                                         ry + 3 * aw / 640, 110 * aw / 640, slotH - 6 * aw / 640);
                if (hovC && clicked) {
                    shell.ToggleEnemyOpen(i - 1);
                    used = 1;
                }
            }

            int cr = 196;
            int cg = 32;
            int cb = 32;
            if (player) {
                List<int> rgb = new List<int>();
                Shell.ColorRgb(shell.ColorIndex(), rgb);
                cr = rgb[0];
                cg = rgb[1];
                cb = rgb[2];
            } else {
                List<int> dot = new List<int>();
                Screens.EnemySwatch(i, dot);
                cr = dot[0];
                cg = dot[1];
                cb = dot[2];
            }
            int swX = slotX + 262 * aw / 640;
            int swW = slotW - 266 * aw / 640;
            R2Panel.RoundRectFill(r, swX, ry + 3 * aw / 640, swW, slotH - 6 * aw / 640, 4,
                               cr, cg, cb, 255);
            R2Panel.RoundRectStroke(r, swX, ry + 3 * aw / 640, swW, slotH - 6 * aw / 640, 4, 2,
16, 18, 24, 255);
            if (player) {
                bool hovSw = R2Panel.PointIn(mouseX, mouseY, swX, ry + 3 * aw / 640,
                                          swW, slotH - 6 * aw / 640);
                if (hovSw && clicked) {
                    shell.SetColor((shell.ColorIndex() + 1) % 8);
                    used = 1;
                }
                bool hovSpot = R2Panel.PointIn(mouseX, mouseY, slotX + 4 * aw / 640,
                                            ry + 3 * aw / 640, 26 * aw / 640, slotH - 6 * aw / 640);
                if (hovSpot && clicked) {
                    shell.SetStartPos((shell.StartPosIndex() + 1) % 5);
                    used = 1;
                }
            }
        }

        int pvX = slotX;
        int pvY = dy + 278 * aw / 640;
        int pvW = slotW;
        int pvH = 116 * aw / 640;
        R2Panel.RoundRectFill(r, pvX, pvY, pvW, pvH, 6, 26, 30, 40, 220);
        R2Text.Draw(r, ui.Or("GUI:Map", "地图") + ":", pvX + 10 * aw / 640,
                  pvY + 5 * aw / 640, 1, 236, 208, 120, 255);
        R2Text.Draw(r, maps[shell.MapIndex()], pvX + 48 * aw / 640, pvY + 5 * aw / 640, 1,
                  224, 228, 238, 255);
        bool hovPrev = R2Panel.PointIn(mouseX, mouseY, pvX + 8 * aw / 640,
                                    pvY + 22 * aw / 640, pvW - 16 * aw / 640, pvH - 30 * aw / 640);
        if (preview != null) {
            r.DrawTexture(preview, pvX + 8 * aw / 640, pvY + 22 * aw / 640, pvW - 16 * aw / 640,
                          pvH - 30 * aw / 640);
        } else {
            R2Text.DrawCentered(r, "载入中…", pvX + pvW / 2, pvY + pvH / 2, 2,
                              120, 128, 142, 255);
        }

        int colX = dx + 396 * aw / 640;
        int colW = 224 * aw / 640;

        R2Panel.RoundRectFill(r, colX, dy + 56 * aw / 640, colW, 136 * aw / 640, 6,
                           26, 30, 40, 220);
        int spd = Screens.Stepper(r, mouseX, mouseY, colX + 12 * aw / 640,
                                  dy + 64 * aw / 640, ui.Or("GUI:GameSpeed", "游戏速度"),
                                  Convert.ToString(shell.GameSpeed()));
        int crd = Screens.Stepper(r, mouseX, mouseY, colX + 12 * aw / 640,
                                  dy + 104 * aw / 640, ui.Or("GUI:Credits", "资金"),
                                  Convert.ToString(shell.StartCredits()));
        int unt = Screens.Stepper(r, mouseX, mouseY, colX + 12 * aw / 640,
                                  dy + 144 * aw / 640, ui.Or("GUI:UnitCount", "部队数"),
                                  Convert.ToString(shell.UnitCount()));
        if (clicked) {
            if (spd < 0) { shell.AdjustSpeed(0 - 1); used = 1; }
            if (spd > 0) { shell.AdjustSpeed(1); used = 1; }
            if (crd < 0) { shell.AdjustCredits(0 - 500); used = 1; }
            if (crd > 0) { shell.AdjustCredits(500); used = 1; }
            if (unt < 0) { shell.AdjustUnits(0 - 1); used = 1; }
            if (unt > 0) { shell.AdjustUnits(1); used = 1; }
        }

        R2Panel.RoundRectFill(r, colX, dy + 200 * aw / 640, colW, 96 * aw / 640, 6,
                           26, 30, 40, 220);
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 206 * aw / 640,
                             "快速游戏", shell.ShortGame())) { used = 1; }
        if (clicked && R2Panel.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 206 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleShortGame(); used = 1;
        }
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 228 * aw / 640,
                             "基地重新部署", shell.McvRedeploy())) { used = 1; }
        if (clicked && R2Panel.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 228 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleMcvRedeploy(); used = 1;
        }
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 250 * aw / 640,
                             "升级工具箱", shell.Crates())) { used = 1; }
        if (clicked && R2Panel.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 250 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleCrates(); used = 1;
        }
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 272 * aw / 640,
                             ui.Or("GUI:Superweapons", "超级武器"),
                             shell.Superweapons())) { used = 1; }
        if (clicked && R2Panel.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 272 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleSuperweapons(); used = 1;
        }

        int action = 0;
        bool hovGo = Screens.MenuButton(r, art, mouseX, mouseY, colX,
                                        dy + 304 * aw / 640, colW,
                                        42 * aw / 640,
                                        ui.Or("GUI:StartGame", "开始游戏"),
                                        true, false, clicked);
        bool hovBack = Screens.MenuButton(r, art, mouseX, mouseY, colX,
                                          dy + 352 * aw / 640, colW,
                                          36 * aw / 640,
                                          ui.Or("GUI:Back", "上一页"),
                                          true, false, clicked);
        if (clicked) {
            if (hovGo) { action = 1; used = 1; }
            if (hovBack) { action = 2; used = 1; }
        }

        if (shell.CountryListOpen()) {
            R2Panel.RoundRectFill(r, dropX, dropY, dropW, dropH, 4,
                               34, 38, 50, 250);
            R2Panel.RoundRectStroke(r, dropX, dropY, dropW, dropH, 4, 2,
236, 208, 120, 255);
            bool took = false;
            for (int i = 0; i < Shell.FlatCount(); i = i + 1) {
                int idx = i + 1;
                int iy = dropY + (4 + i * 24) * aw / 640;
                string nm = Shell.FlatName(idx);
                bool hov = R2Panel.PointIn(mouseX, mouseY, dropX + 4 * aw / 640, iy,
                                        dropW - 8 * aw / 640, 22 * aw / 640);
                if (idx == shell.FlatIndex()) {
                    R2Panel.RoundRectFill(r, dropX + 4 * aw / 640, iy, dropW - 8 * aw / 640,
                                       22 * aw / 640, 3, 224, 176, 66, 235);
                } else if (hov) {
                    R2Panel.RoundRectFill(r, dropX + 4 * aw / 640, iy, dropW - 8 * aw / 640,
                                       22 * aw / 640, 3, 62, 70, 88, 220);
                }
                int tr = idx == shell.FlatIndex() ? 32 : 224;
                R2Text.DrawCentered(r, nm, dropX + dropW / 2, iy + 3 * aw / 640, 2,
                                  tr, tr, tr, 255);
                if (hov && clicked) {
                    shell.SetFlatCountry(idx);
                    shell.SetCountryListOpen(false);
                    used = 1;
                    took = true;
                }
            }
            if (clicked && !took) { used = 1; }   // click inside closes nothing
        }
        if (clicked && used == 0 && shell.CountryListOpen()) {
            shell.SetCountryListOpen(false);      // click elsewhere dismisses
        }

        if (clicked && hovPrev && used == 0) {
            shell.SelectMap(1);
            used = 1;
        }
        return action;
    }

    /// <summary>One options-panel stepper: gold label, then ‹ value ›. The
    /// arrows highlight under the cursor. Returns -1 minus clicked, +1 plus
    /// clicked, 0 otherwise.</summary>
    static int Stepper(R2Canvas r, int mx, int my, int x, int y,
                       string label, string value) {
        R2Text.Draw(r, label, x, y + 8, 1, 236, 208, 120, 255);
        R2Panel.RoundRectFill(r, x + 96, y, 26, 26, 4, 40, 44, 58, 255);
        R2Panel.RoundRectFill(r, x + 184, y, 26, 26, 4, 40, 44, 58, 255);
        R2Text.DrawCentered(r, "<", x + 109, y + 6, 2, 236, 208, 120, 255);
        R2Text.DrawCentered(r, ">", x + 197, y + 6, 2, 236, 208, 120, 255);
        R2Text.DrawCentered(r, value, x + 153, y + 6, 2, 224, 228, 238, 255);
        bool lm = R2Panel.PointIn(mx, my, x + 96, y, 26, 26);
        bool rm = R2Panel.PointIn(mx, my, x + 184, y, 26, 26);
        if (lm) {
            R2Panel.RoundRectStroke(r, x + 96, y, 26, 26, 4, 236, 2, 208, 120, 255);
        }
        if (rm) {
            R2Panel.RoundRectStroke(r, x + 184, y, 26, 26, 4, 236, 2, 208, 120, 255);
        }
        int act = 0;
        if (lm) { act = 0 - 1; }
        if (rm) { act = 1; }
        return act;
    }

    /// <summary>The setup screen's per-slot enemy colour, matching the
    /// minimap dots: slot i wears hue i so every AI is distinguishable.</summary>
    static void EnemySwatch(int slot, List<int> rgb) {
        int r = 196; int g = 32; int b = 32;
        if (slot == 2) { r = 230; g = 130; b = 40; }      // orange
        else if (slot == 3) { r = 60; g = 140; b = 232; } // blue
        else if (slot == 4) { r = 220; g = 80; b = 200; } // magenta
        else if (slot == 5) { r = 230; g = 200; b = 50; } // yellow
        else if (slot == 6) { r = 60; g = 210; b = 200; } // cyan
        else if (slot == 7) { r = 240; g = 240; b = 240; } // white
        Screens.Ra2AppLikeSet(rgb, r, g, b);
    }

    static void Ra2AppLikeSet(List<int> rgb, int r, int g, int b) {
        while (rgb.Count < 3) { rgb.Add(0); }
        rgb[0] = r;
        rgb[1] = g;
        rgb[2] = b;
    }

    static bool CheckRow(R2Canvas r, int mx, int my, int x, int y,
                         string label, bool on) {
        bool hov = R2Panel.PointIn(mx, my, x, y, 200, 20);
        R2Panel.RoundRectFill(r, x, y + 2, 14, 14, 3, 30, 34, 44, 255);
        R2Panel.RoundRectStroke(r, x, y + 2, 14, 14, 3, 2, 120, 128, 142, 255);
        if (on) {
            R2Panel.RoundRectFill(r, x + 3, y + 5, 8, 8, 2, 236, 208, 120, 255);
        }
        int tr = 210;
        int tg = 214;
        int tb = 224;
        if (hov) { tr = 236; tg = 208; tb = 120; }
        R2Text.Draw(r, label, x + 22, y + 3, 1, tr, tg, tb, 255);
        return hov;
    }

    // ---- loading screen ------------------------------------------------
    //
    // The original's skirmish load: an LS800<Country>.PCX backdrop per
    // country (Yuri falls back to LOAD.PCX), the country's own palette, the
    // rules' load colour for the progress bar and the sidebar accents, the
    // CSF briefing text for the country's special unit, and a fixed
    // geometry in the art's 800x600 design space -- special-unit name band
    // at (20,94)-(760,112), briefing band (20,170) 400x90, the loading
    // caption at (20,280) and the 400x13 bar at (20,302).

    /// <summary>The LS800 backdrop PCX name for a country token, what the
    /// original's loading screen mounted per sub-faction.</summary>
    static string LsBackdrop(string reg) {
        if (reg == "AMERICAN") { return "LS800USTATES.PCX"; }
        if (reg == "KOREA") { return "LS800KOREA.PCX"; }
        if (reg == "FRANCE") { return "LS800FRANCE.PCX"; }
        if (reg == "GERMANY") { return "LS800GERMANY.PCX"; }
        if (reg == "ENGLAND") { return "LS800ENGLAND.PCX"; }
        if (reg == "RUSSIA") { return "LS800RUSSIA.PCX"; }
        if (reg == "CUBA") { return "LS800CUBA.PCX"; }
        if (reg == "LIBYA") { return "LS800LIBYA.PCX"; }
        if (reg == "IRAQ") { return "LS800IRAQ.PCX"; }
        return "LOAD.PCX";   // Yuri's is generic; his art ships no LS800
    }

    /// <summary>The CSF briefing key for a country's special unit, the
    /// paragraph the loading screen showed while the bar filled.</summary>
    static string LsBriefing(string reg) {
        if (reg == "AMERICAN") { return "LoadBrief:USA"; }
        if (reg == "KOREA") { return "LoadBrief:Korea"; }
        if (reg == "FRANCE") { return "LoadBrief:French"; }
        if (reg == "GERMANY") { return "LoadBrief:Germans"; }
        if (reg == "ENGLAND") { return "LoadBrief:British"; }
        if (reg == "RUSSIA") { return "LoadBrief:Russia"; }
        if (reg == "CUBA") { return "LoadBrief:Cuba"; }
        if (reg == "LIBYA") { return "LoadBrief:Lybia"; }
        if (reg == "IRAQ") { return "LoadBrief:Iraq"; }
        return "";
    }

    /// <summary>The CSF name key of the special unit the briefing is about.</summary>
    static string LsSpecial(string reg) {
        if (reg == "AMERICAN") { return "Name:Para"; }
        if (reg == "KOREA") { return "Name:BEAGLE"; }
        if (reg == "FRANCE") { return "Name:GTGCAN"; }
        if (reg == "GERMANY") { return "Name:TNKD"; }
        if (reg == "ENGLAND") { return "Name:SNIPE"; }
        if (reg == "RUSSIA") { return "Name:TTNK"; }
        if (reg == "CUBA") { return "Name:TERROR"; }
        if (reg == "LIBYA") { return "Name:DTRUCK"; }
        if (reg == "IRAQ") { return "Name:DESO"; }
        return "";
    }

    /// <summary>Exactly the reference Color.fromHsv: h,s,v in 0..255, the
    /// six-sector chase the rules' load colours ride on.</summary>
    static void HsvToRgb(int h, int s, int v, List<int> rgb) {
        double hue = h / 255.0 * 360.0;
        double sat = s / 255.0;
        double val = v / 255.0;
        double c = val * sat;
        double x = c * (1.0 - Math.Abs(hue / 60.0 % 2.0 - 1.0));
        double m = val - c;
        double r2 = m;
        double g2 = m;
        double b2 = m;
        if (hue < 60.0) { r2 = r2 + c; g2 = g2 + x; }
        else if (hue < 120.0) { r2 = r2 + x; g2 = g2 + c; }
        else if (hue < 180.0) { g2 = g2 + c; b2 = b2 + x; }
        else if (hue < 240.0) { g2 = g2 + x; b2 = b2 + c; }
        else if (hue < 300.0) { r2 = r2 + x; b2 = b2 + c; }
        else { r2 = r2 + c; b2 = b2 + x; }
        Screens.Ra2AppLikeSet(rgb,
            (int)((r2 + m) * 255.0 + 0.5),
            (int)((g2 + m) * 255.0 + 0.5),
            (int)((b2 + m) * 255.0 + 0.5));
    }

    /// <summary>Char-fit word wrap at a pixel width, the briefing's line
    /// budget; CJK has no spaces so it wraps by the glyph.</summary>
    static void WrapText(R2Canvas r, string text, int maxW, int size,
                         List<string> lines) {
        string cur = "";
        int i = 0;
        while (i < text.Length) {
            string next = cur + text.Substring(i, 1);
            if (cur.Length > 0
             && R2Text.Width(r, next, size) > maxW) {
                lines.Add(cur);
                cur = text.Substring(i, 1);
            } else {
                cur = next;
            }
            i = i + 1;
        }
        if (cur.Length > 0) { lines.Add(cur); }
    }

    /// <summary>The skirmish load screen: LS800 backdrop, special-unit band,
    /// CSF briefing, the loading caption and the rules-coloured progress
    /// bar -- the reference geometry, in the art's 800x600 space.</summary>
    static void DrawLoading(R2Canvas r, ShellArt art, R2Tex backdrop,
                            Shell shell, Strings ui, string mapName, int pct,
                            int loadR, int loadG, int loadB, int viewW,
                            int viewH) {
        string reg = shell.CountryReg();
        int ah = viewH;
        int aw = ah * 4 / 3;
        if (aw > viewW) { aw = viewW; ah = aw * 3 / 4; }
        int ax = (viewW - aw) / 2;
        int ay = (viewH - ah) / 2;
        if (backdrop != null) {
            r.DrawTexture(backdrop, ax, ay, aw, ah);
        } else {
            R2Tex fallback = art != null ? art.Load() : null;
            if (fallback != null) {
                r.DrawTexture(fallback, ax, ay, aw, ah);
            } else {
                R2Panel.Backdrop(r, null, viewW, viewH);
            }
        }

        // Design-space helpers inlined at use sites: dx = ax + v*aw/800,
        // dy = ay + v*ah/600. No local functions in Zan, so the arithmetic
        // is spelled out where each band draws.

        // Special unit: its name on a black band, (20,94)-(760,112).
        string specialKey = Screens.LsSpecial(reg);
        if (specialKey.Length > 0) {
            string special = ui.Or(specialKey, "");
            r.SetColor(0, 0, 0, 255);
            r.FillRect(ax + 20 * aw / 800, ay + 94 * ah / 600,
                       740 * aw / 800, 18 * ah / 600);
            R2Text.Draw(r, special, ax + 24 * aw / 800, ay + 96 * ah / 600, 2,
                      236, 208, 120, 255);
        }

        // Briefing: half-transparent black band (20,170) 400x90, wrapped
        // text inside.
        string briefKey = Screens.LsBriefing(reg);
        if (briefKey.Length > 0) {
            string brief = ui.Or(briefKey, "");
            if (brief.Length > 0) {
                r.SetColor(0, 0, 0, 128);
                r.FillRect(ax + 20 * aw / 800, ay + 170 * ah / 600,
                           400 * aw / 800, 90 * ah / 600);
                List<string> lines = new List<string>();
                Screens.WrapText(r, brief, 392 * aw / 800, 2, lines);
                int ly = ay + 174 * ah / 600;
                for (int i = 0; i < lines.Count; i = i + 1) {
                    R2Text.Draw(r, lines[i], ax + 24 * aw / 800, ly, 2,
                              224, 228, 238, 255);
                    ly = ly + 14 * ah / 600;
                }
            }
        }

        // The loading caption and the bar: (20,280) and (20,302) 400x13.
        R2Text.Draw(r, ui.Or("GUI:LoadingEx", "正在装载"), ax + 20 * aw / 800,
                  ay + 280 * ah / 600, 2, loadR, loadG, loadB, 255);
        int barX = ax + 20 * aw / 800;
        int barY = ay + 302 * ah / 600;
        int barW = 400 * aw / 800;
        int barH = 13 * ah / 600;
        r.SetColor(12, 12, 14, 255);
        r.FillRect(barX, barY, barW, barH);
        int fill = barW * pct / 100;
        r.SetColor(loadR, loadG, loadB, 255);
        r.FillRect(barX + 2, barY + 2, (barW - 4) * pct / 100, barH - 4);
        r.SetColor(loadR, loadG, loadB, 200);
        r.DrawRect(barX, barY, barW, barH);
        R2Text.Draw(r, ui.Or("GUI:Commander", "指挥官") + " "
                  + Convert.ToString(pct) + "%",
                  barX + barW + 12 * aw / 800, barY, 2,
                  loadR, loadG, loadB, 255);

        // Bottom row: country name right-aligned at x=720 y=570, the map
        // name on a half-black band (20,570) 280x20.
        string cn = shell.CountryName();
        R2Text.Draw(r, cn, ax + 720 * aw / 800
                  - R2Text.Width(r, cn, 2), ay + 570 * ah / 600, 2,
                  236, 208, 120, 255);
        r.SetColor(0, 0, 0, 128);
        r.FillRect(ax + 20 * aw / 800, ay + 570 * ah / 600,
                   280 * aw / 800, 20 * ah / 600);
        R2Text.Draw(r, mapName, ax + 24 * aw / 800,
                  ay + 574 * ah / 600, 2, 224, 228, 238, 255);
    }

    /// <summary>The 单人游戏 page, composed like the reference's
    /// compose_single_player_page over the shell chrome: mnscrnl base,
    /// right column, the four entries 新战役/载入/遭遇战/主菜单 (载入 dimmed
    /// -- not implemented, exactly the reference's disabled set). The title
    /// is GUI:SinglePlayerMenu. Returns 1 campaign, 2 skirmish, 3 back, 0
    /// none.</summary>
    static int DrawSinglePlayer(R2Canvas r, ShellArt art, Strings ui,
                                Shell shell, int mx, int my, bool clicked,
                                int viewW, int viewH) {
        if (art != null && art.HasShellBg()) {
            List<int> rect = new List<int>();
            rect.Add(0); rect.Add(0); rect.Add(0); rect.Add(0);
            List<int> rgb = new List<int>();
            rgb.Add(0); rgb.Add(0); rgb.Add(0);
            ShellLayout.BaseRect(viewW, viewH, rect);
            int bx = rect[0];
            int by = rect[1];
            int bw = rect[2];
            int bh = rect[3];
            r.SetColor(0, 0, 0, 255);
            r.FillRect(bx, by, bw, bh);
            if (art.HasShellBg632()) {
                Screens.BlitShell(r, art.ShellBg632(), bx, by, 632, 570,
                                  bw, bh);
            } else {
                Screens.BlitShell(r, art.ShellBg(), bx, by, 800, 600,
                                  bw, bh);
            }
            Screens.ShellRightChrome(r, art, bx, by, bw, bh, false);

            // Four rows: the single-player stack plus back one row below.
            string[] labels = new string[4];
            labels[0] = ui.Or("GUI:NewCampaign", "新战役");
            labels[1] = ui.Or("GUI:LoadSavedGame", "载入");
            labels[2] = ui.Or("GUI:Skirmish", "遭遇战");
            labels[3] = ui.Or("GUI:MainMenu", "主菜单");
            bool[] enabled = new bool[4];
            enabled[0] = true; enabled[1] = false; enabled[2] = true;
            enabled[3] = true;
            int[] ids = new int[4];
            ids[0] = 1; ids[1] = 0; ids[2] = 2; ids[3] = 3;

            List<int> mp = new List<int>();
            mp.Add(0); mp.Add(0);
            bool inside = ShellLayout.FromBase(viewW, viewH, mx, my, mp);
            int action = 0;
            for (int i = 0; i < 4; i = i + 1) {
                int rowY = 199 + i * 42;
                ShellLayout.ButtonCell(rowY, rect);
                int cellX = bx + rect[0] * bw / 800;
                int cellY = by + rect[1] * bh / 600;
                int cellW = rect[2] * bw / 800;
                int cellH = rect[3] * bh / 600;
                bool hov = inside && enabled[i]
                    && R2Panel.PointIn(mp[0], mp[1], rect[0], rect[1],
                                       rect[2], rect[3]);
                bool pressed = hov && clicked;
                if (pressed) { action = ids[i]; }
                Screens.DrawSdbtnanm(r, art, cellX, cellY, cellW, cellH,
                                     pressed, !enabled[i]);
                ShellLayout.CaptionRect(rect[0], rect[1], rect[2], rect[3],
                                        pressed, rect);
                int capX = bx + rect[0] * bw / 800;
                int capY = by + rect[1] * bh / 600;
                int capW = rect[2] * bw / 800;
                if (enabled[i]) {
                    ShellLayout.TextEnabled(rgb);
                } else {
                    ShellLayout.TextDisabled(rgb);
                }
                R2Text.DrawCentered(r, labels[i], capX + capW / 2, capY,
                                    2, rgb[0], rgb[1], rgb[2], 255);
            }

            // Title and tooltip, the same slots as the main menu.
            int titleX = bx + (800 - 168 + 3) * bw / 800;
            int titleY = by + 9 * bh / 600;
            int titleW = 163 * bw / 800;
            ShellLayout.TextEnabled(rgb);
            R2Text.DrawCentered(r, ui.Or("GUI:SinglePlayerMenu", "单人游戏"),
                                titleX + titleW / 2, titleY, 2,
                                rgb[0], rgb[1], rgb[2], 255);
            return action;
        }

        // Stand-in: the drawn dialog with three rows, as before.
        R2Panel.Backdrop(r, null, viewW, viewH);
        int ah = viewH * 3 / 4;
        int aw = ah * 4 / 3;
        if (aw > viewW) { aw = viewW; ah = aw * 3 / 4; }
        int dx = (viewW - aw) / 2;
        int dy = (viewH - ah) / 2;
        int dh = ah * 400 / 480;
        if (art != null && art.HasDialog()) {
            r.DrawTexture(art.Dialog(), dx, dy + (ah - dh) / 2, aw, dh);
        } else {
            R2Panel.RoundRectFill(r, dx, dy + (ah - dh) / 2, aw, dh, 8,
                               24, 28, 38, 255);
        }
        dy = dy + (ah - dh) / 2;
        ah = dh;
        R2Text.DrawShadow(r, ui.Or("GUI:SinglePlayer", "单人游戏"),
                        dx + 20 * aw / 640, dy + 12 * aw / 640, 3,
                        236, 208, 120, 3);
        int colX = dx + 200 * aw / 640;
        int colW = 240 * aw / 640;
        int action2 = 0;
        bool hovA = Screens.MenuButton(r, art, mx, my, colX,
                                       dy + 120 * aw / 640, colW,
                                       42 * aw / 640,
                                       ui.Or("GUI:AlliedCampaign", "盟军战役"),
                                       true, false, clicked);
        bool hovS = Screens.MenuButton(r, art, mx, my, colX,
                                       dy + 180 * aw / 640, colW,
                                       42 * aw / 640,
                                       ui.Or("GUI:SovietCampaign", "苏俄战役"),
                                       true, false, clicked);
        bool hovY = Screens.MenuButton(r, art, mx, my, colX,
                                       dy + 240 * aw / 640, colW,
                                       42 * aw / 640,
                                       ui.Or("GUI:YuriCampaign", "尤里战役"),
                                       true, false, clicked);
        if (clicked) {
            if (hovA) { action2 = 1; }
            if (hovS) { action2 = 1; }
            if (hovY) { action2 = 1; }
        }
        R2Text.Draw(r, "Esc 返回", dx + 496 * aw / 640, dy + 22 * aw / 640, 1,
                  150, 158, 172, 255);
        return action2;
    }

    /// <summary>The right column chrome minus the lower strip: SDTP +
    /// SDWRNANM, nine SDBTNBKGD tiles, SDBTM. The skirmish lobby and
    /// similar pages draw exactly this (the main menu adds LWSCRNL).</summary>
    static void ShellRightChrome(R2Canvas r, ShellArt art, int bx, int by,
                                 int bw, int bh, bool withLowerStrip) {
        int panelX = 800 - 168;
        if (art.HasPanelTop()) {
            Screens.BlitShell(r, art.PanelTop(), bx + panelX * bw / 800, by,
                              168, 199, bw, bh);
        }
        if (art.HasWarnAnim()) {
            Screens.BlitShell(r, art.WarnAnim(),
                              bx + (panelX + 38) * bw / 800,
                              by + 48 * bh / 600,
                              art.WarnAnim().W(), art.WarnAnim().H(),
                              bw, bh);
        }
        if (art.HasPanelTile()) {
            for (int i = 0; i < 9; i = i + 1) {
                Screens.BlitShell(r, art.PanelTile(),
                                  bx + panelX * bw / 800,
                                  by + (199 + i * 42) * bh / 600,
                                  168, 42, bw, bh);
            }
        }
        if (art.HasPanelBottom()) {
            Screens.BlitShell(r, art.PanelBottom(), bx + panelX * bw / 800,
                              by + 577 * bh / 600, 168, 23, bw, bh);
        }
        if (withLowerStrip && art.HasLowerStrip()) {
            Screens.BlitShell(r, art.LowerStrip(), bx, by + 568 * bh / 600,
                              632, 32, bw, bh);
        }
    }

    /// <summary>The 选项 page: the game speed and edge-scroll sliders, the
    /// two the original's option screen carried over the skirmish options.
    /// Speed returns 10+v for the clicked cell v; scroll the same +100.</summary>
    static int DrawOptions(R2Canvas r, ShellArt art, Shell shell,
                           Strings ui, int mx, int my, bool clicked,
                           int viewW, int viewH, int scrollStep) {
        R2Panel.Backdrop(r, null, viewW, viewH);
        int ah = viewH * 3 / 4;
        int aw = ah * 4 / 3;
        if (aw > viewW) { aw = viewW; ah = aw * 3 / 4; }
        int dx = (viewW - aw) / 2;
        int dy = (viewH - ah) / 2;
        int dh = ah * 400 / 480;
        if (art != null && art.HasDialog()) {
            r.DrawTexture(art.Dialog(), dx, dy + (ah - dh) / 2, aw, dh);
        } else {
            R2Panel.RoundRectFill(r, dx, dy + (ah - dh) / 2, aw, dh, 8,
                               24, 28, 38, 255);
        }
        dy = dy + (ah - dh) / 2;
        ah = dh;
        R2Text.DrawShadow(r, ui.Or("GUI:Options", "选项"),
                        dx + 20 * aw / 640, dy + 12 * aw / 640, 3,
                        236, 208, 120, 3);
        R2Text.Draw(r, "Esc 返回", dx + 496 * aw / 640, dy + 22 * aw / 640, 1,
                  150, 158, 172, 255);
        int action = 0;
        action = Screens.SliderRow(r, mx, my, dx + 60 * aw / 640,
                                   dy + 90 * aw / 640,
                                   ui.Or("GUI:GameSpeed", "游戏速度"), 7,
                                   shell.GameSpeed(), clicked, action);
        int curScroll = scrollStep / 16 - 1;
        if (curScroll < 0) { curScroll = 0; }
        if (curScroll > 3) { curScroll = 3; }
        action = Screens.SliderRow(r, mx, my, dx + 60 * aw / 640,
                                   dy + 150 * aw / 640,
                                   ui.Or("GUI:ScrollSpeed", "滚动速度"), 4,
                                   curScroll, clicked, action);
        return action;
    }

    /// <summary>One options slider: the label, then n cells, filled gold up
    /// to the current position. Returns the incoming action, or 10+i (the
    /// clicked cell) when the click lands on one.</summary>
    static int SliderRow(R2Canvas r, int mx, int my, int x, int y,
                         string label, int n, int current, bool clicked,
                         int action) {
        R2Text.Draw(r, label, x, y + 6, 1, 236, 208, 120, 255);
        int cw = 28;
        int gap = 4;
        for (int i = 0; i < n; i = i + 1) {
            int cx = x + 96 + i * (cw + gap);
            bool hov = R2Panel.PointIn(mx, my, cx, y, cw, 26);
            if (i <= current) {
                r.SetColor(196, 168, 80, 255);
            } else {
                r.SetColor(40, 44, 58, 255);
            }
            r.FillRect(cx, y, cw, 26);
            if (hov) {
                r.SetColor(255, 255, 255, 255);
                r.DrawRect(cx, y, cw, 26);
                if (clicked) { action = 10 + i; }
            }
        }
        return action;
    }

    /// <summary>The in-game overlay: which map is loaded and the controls.
    /// The sidebar, minimap and build menu live in main.zan's sidebar pass;
    /// the original keeps the map view itself clean, so the facts ride on a
    /// single shadowed line instead of a panel.</summary>
    static void DrawHud(R2Canvas r, string mapName, string sideName,
                        int cells, int drawn, int viewW, int viewH) {
        R2Text.DrawShadow(r, mapName + " " + sideName
                        + "  单元 " + Convert.ToString(cells)
                        + "  绘制 " + Convert.ToString(drawn),
                        12, 12, 2, 200, 206, 218, 220);
        R2Text.DrawShadow(r, "方向键平移  +/- 缩放  Esc 返回",
                        12, viewH - 34, 2, 150, 158, 172, 220);
    }
}
