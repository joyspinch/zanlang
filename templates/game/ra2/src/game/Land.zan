using System;
using System.Collections.Generic;
using Ra2.Formats;

namespace Ra2.Game;

/// <summary>The surface class of a terrain cell, ported from the reference's
/// `game/type/LandType.ts`.
///
/// The reference does not decide "can a ground unit stand here" from a
/// height number. Every TMP template carries its own `terrainType` byte,
/// which maps to exactly one of these land classes, and every movement
/// rule -- passability, building placement, shore landings, wall
/// collisions -- asks for the class rather than comparing elevations.
///
/// The distinction matters most at cliffs. A cliff face and the ground
/// beside it can share a height byte in the coarse cell grid, so a height
/// comparison cannot tell "stand here" from "drive off the edge". Only the
/// class plus the ramp flag can.</summary>
class LandType {
    int value;

    static int Clear() { return 0; }
    static int Road() { return 1; }
    static int Rock() { return 2; }
    static int Beach() { return 3; }
    static int Rough() { return 4; }
    static int Railroad() { return 5; }
    static int Weeds() { return 6; }
    static int Water() { return 7; }
    static int Wall() { return 8; }
    static int Tiberium() { return 9; }
    static int Cliff() { return 10; }

    int Value() { return this.value; }
    bool Is(int t) { return this.value == t; }

    static LandType Of(int t) {
        LandType l = new LandType();
        l.value = t;
        return l;
    }

    /// <summary>The land class a TMP template's terrain-type byte denotes,
    /// the reference's `terrainToLandTypeMap` (`LandType.ts:15-28`).
    ///
    /// An unknown byte maps to Clear rather than throwing: the reference
    /// raises, which is right for a validator and wrong for a renderer, and
    /// this port has to keep drawing a map whose theater table is partly
    /// missing (the Lunar and Desert sets are not in every install).</summary>
    static int FromTerrainType(int terrainType) {
        // The reference's TerrainType enum (engine/type/TerrainType.ts).
        if (terrainType == 0) { return LandType.Clear(); }    // Default
        if (terrainType == 5) { return LandType.Cliff(); }    // Tunnel
        if (terrainType == 6) { return LandType.Railroad(); } // Railroad
        if (terrainType == 7) { return LandType.Rock(); }     // Rock1
        if (terrainType == 8) { return LandType.Rock(); }     // Rock2
        if (terrainType == 9) { return LandType.Water(); }    // Water
        if (terrainType == 10) { return LandType.Beach(); }   // Shore
        if (terrainType == 11) { return LandType.Road(); }    // Pavement
        if (terrainType == 12) { return LandType.Road(); }    // Dirt
        if (terrainType == 13) { return LandType.Clear(); }   // Clear
        if (terrainType == 14) { return LandType.Rough(); }   // Rough
        if (terrainType == 15) { return LandType.Cliff(); }   // Cliff
        return LandType.Clear();
    }

    /// <summary>True when a ground unit may occupy a cell of this class.
    ///
    /// The reference's passability test (LandType plus the object layer)
    /// rejects cliff faces, walls, water (unless amphibious) and
    /// impassable rock. Rough, road, beach and clear are all walkable --
    /// they differ in speed, not in legality.</summary>
    bool GroundPassable() {
        return !this.Is(LandType.Cliff())
            && !this.Is(LandType.Wall())
            && !this.Is(LandType.Water());
    }

    bool IsWaterClass() { return this.Is(LandType.Water()); }
    bool IsCliffClass() { return this.Is(LandType.Cliff()); }
    bool IsRoadClass() {
        return this.Is(LandType.Road()) || this.Is(LandType.Railroad());
    }
    bool IsRoughClass() {
        return this.Is(LandType.Rough()) || this.Is(LandType.Weeds());
    }

    /// <summary>The land-speed multiplier for a tracked or wheeled vehicle.
    /// The reference holds these in the theater's speed tables; the ratios
    /// here are the ones its `Vehicle` movement uses (road fastest, rough
    /// slowest) and are the hook a full speed-table port replaces.</summary>
    int SpeedPercent() {
        if (this.IsRoadClass()) { return 100; }
        if (this.Is(LandType.Clear())) { return 100; }
        if (this.Is(LandType.Beach())) { return 80; }
        if (this.IsRoughClass()) { return 70; }
        if (this.Is(LandType.Rock())) { return 60; }
        if (this.IsWaterClass()) { return 60; }
        return 100;
    }

    string Name() {
        if (this.Is(LandType.Clear())) { return "Clear"; }
        if (this.Is(LandType.Road())) { return "Road"; }
        if (this.Is(LandType.Rock())) { return "Rock"; }
        if (this.Is(LandType.Beach())) { return "Beach"; }
        if (this.Is(LandType.Rough())) { return "Rough"; }
        if (this.Is(LandType.Railroad())) { return "Railroad"; }
        if (this.Is(LandType.Weeds())) { return "Weeds"; }
        if (this.Is(LandType.Water())) { return "Water"; }
        if (this.Is(LandType.Wall())) { return "Wall"; }
        if (this.Is(LandType.Tiberium())) { return "Tiberium"; }
        if (this.Is(LandType.Cliff())) { return "Cliff"; }
        return "?";
    }
}
