using System;
using System.Collections.Generic;

namespace Ra2.Game;

/// <summary>Which screen the shell is showing.</summary>
class Scene {
    static int MainMenu() { return 0; }
    static int SkirmishSetup() { return 1; }
    static int Playing() { return 2; }
    // The loading screen between 遭遇战 and the battle: StartGame() parks the
    // shell here while the LS800 backdrop and the briefing draw, then 100%
    // flips it to Playing -- the original hides its map load behind the
    // finished bar the same way.
    static int Loading() { return 3; }
    // The 选项 page, reached from the home list. The reference's Skirmish
    // entry is top-level (`HomeScreen.ts:55` goToScreen(Skirmish)), so there
    // is no 单人游戏 page between the menu and the setup screen.
    static int Options() { return 5; }
    // The map picker, pushed from setup by 选图 and popped by 使用地图/取消
    // (`MapSelScreen.ts:124` title GUI:ChooseMap).
    static int MapSelect() { return 6; }
}

/// <summary>The three RA2 sides a player can pick.</summary>
class Side {
    static int Allied() { return 0; }
    static int Soviet() { return 1; }
    static int Yuri() { return 2; }

    static string NameOf(int side) {
        if (side == Side.Soviet()) { return "苏联"; }
        if (side == Side.Yuri()) { return "尤里"; }
        return "盟军";
    }
}

/// <summary>The sub-factions each side fields, in the order the original's
/// skirmish country list shows them. The index is what the shell stores; the
/// rules' Side- and Country-specific behaviour keys off the reg name.</summary>
class Country {
    static string NameOf(int side, int i) {
        if (side == Side.Allied()) {
            if (i == 1) { return "韩国"; }
            if (i == 2) { return "法国"; }
            if (i == 3) { return "德国"; }
            if (i == 4) { return "英国"; }
            return "美国";
        }
        if (side == Side.Soviet()) {
            if (i == 1) { return "古巴"; }
            if (i == 2) { return "利比亚"; }
            if (i == 3) { return "伊拉克"; }
            return "苏俄";
        }
        return "尤里";
    }

    /// <summary>The rules' country token: the load screen's sub-faction tag
    /// and the same token rulesmd.ini keys special-case sections on.</summary>
    static string RegOf(int side, int i) {
        if (side == Side.Allied()) {
            if (i == 1) { return "KOREA"; }
            if (i == 2) { return "FRANCE"; }
            if (i == 3) { return "GERMANY"; }
            if (i == 4) { return "ENGLAND"; }
            return "AMERICAN";
        }
        if (side == Side.Soviet()) {
            if (i == 1) { return "CUBA"; }
            if (i == 2) { return "LIBYA"; }
            if (i == 3) { return "IRAQ"; }
            return "RUSSIA";
        }
        return "YURI";
    }

    static int Count(int side) {
        if (side == Side.Allied()) { return 5; }
        if (side == Side.Soviet()) { return 4; }
        return 1;
    }
}

/// <summary>AI skill levels, the words the original's enemy slots offer. The
/// reference lists five (`PregameController.ts:312-323`: Normal, Easy, Brutal,
/// Medium, Custom); the skirmish slot picks one of them.</summary>
class Difficulty {
    static int Easy() { return 0; }
    static int Normal() { return 1; }
    static int Brutal() { return 2; }
    static int Medium() { return 3; }
    static int Custom() { return 4; }

    static int Count() { return 5; }

    static string NameOf(int d) {
        if (d == Difficulty.Easy()) { return "简单的敌人"; }
        if (d == Difficulty.Brutal()) { return "冷酷的敌人"; }
        if (d == Difficulty.Medium()) { return "中等的敌人"; }
        if (d == Difficulty.Custom()) { return "自订的敌人"; }
        return "普通的敌人";
    }

    /// <summary>How much harder the AI fights: its income and its build pace
    /// both scale by this. 中等的敌人 sits between 普通 and 冷酷; 自订 is the
    /// placeholder the reference leaves unconfigured, played at 普通.</summary>
    static double Multiplier(int d) {
        if (d == Difficulty.Easy()) { return 0.6; }
        if (d == Difficulty.Brutal()) { return 1.6; }
        if (d == Difficulty.Medium()) { return 1.25; }
        return 1.0;
    }
}

/// <summary>The alliance teams the skirmish screen offers: 无 plus A..D, the
/// four the reference caps at (`PregameController.ts:357`, maxTeams 4). The AI
/// slots play FFA, so a team is carried for the UI and the start-game check
/// rather than for diplomacy.</summary>
class Team {
    static int None() { return 0 - 1; }
    static int Max() { return 4; }

    static string NameOf(int t) {
        if (t < 0 || t >= Team.Max()) { return "无"; }
        if (t == 0) { return "A"; }
        if (t == 1) { return "B"; }
        if (t == 2) { return "C"; }
        return "D";
    }
}

/// <summary>Shell state: which screen is up, and what the player has chosen
/// on the skirmish setup screen -- map, side, country, colour, start spot,
/// the enemy slots' difficulty, and the game options (credits, speed, unit
/// count, superweapons and friends).</summary>
///
/// Kept apart from rendering so the flow -- menu to setup to game, and back --
/// can be tested without a window. The screens themselves only read this and
/// call the transitions.
class Shell {
    int scene;
    int mapIndex;
    int side;
    int country;
    int color;
    int startPos;      // 0 = random, else waypoint startPos
    int mapCount;
    int startCredits;
    int gameSpeed;     // 0..6, 6 fastest -- the original's slider
    int unitCount;     // starting units per side, 0..10
    bool superweapons;
    bool shortGame;
    bool mcvRedeploy;
    bool crates;
    // The option rows the reference's lobby form shows besides the four above
    // (`LobbyForm.tsx:148-217`): bridges, multi-engineer, dog/engineer kills,
    // and the right column's build-off-ally.
    bool destroyableBridges;
    bool multiEngineer;
    bool noDogEngiKills;
    bool buildOffAlly;
    int[] enemyDiff;   // difficulty per enemy slot, up to seven AIs
    bool[] enemyOpen;  // which enemy slots are in the game (slot 0 always on)
    // Per-slot country and colour, the way the reference gives every AI row a
    // real CountrySelect and ColorSelect (`LobbyForm.tsx:247-256`). -1 means
    // 随机, which is what an AI slot starts as.
    int[] enemyCountry;
    int[] enemyColor;
    int team;          // the player's own team, Team.None() by default
    int[] enemyTeam;
    // Which popup list is down: 0 none, 1 the player's country, 2 colour,
    // 3 start position, 4 team, 5 an AI slot's difficulty. Only one at a time,
    // the way the original's modal lists behave. openSlot carries the AI row
    // for kind 5.
    int openList;
    int openSlot;
    // The map picker's own state (`MapSel.tsx:49-95`): which game mode is
    // selected, the map scrolled to, the sort order and the search text.
    // mapPick is the pending choice; it is committed to mapIndex only when
    // 使用地图 is pressed, so 取消 really cancels.
    int pickMode;
    int pickMap;
    int pickSort;      // SortType: 0 none, 1 nameAsc, 2 nameDesc, 3 slotsAsc, 4 slotsDesc
    int pickScroll;
    string pickSearch;
    bool quit;

    static Shell Create(int mapCount) {
        Shell s = new Shell();
        s.scene = Scene.MainMenu();
        s.mapIndex = 0;
        s.side = Side.Allied();
        s.country = 0;
        s.color = 0;
        s.startPos = 0;
        s.mapCount = mapCount;
        s.startCredits = 10000;
        s.gameSpeed = 6;
        s.unitCount = 10;
        s.superweapons = true;
        s.shortGame = false;
        s.mcvRedeploy = true;
        s.crates = false;
        s.destroyableBridges = true;
        s.multiEngineer = false;
        s.noDogEngiKills = false;
        s.buildOffAlly = false;
        s.team = Team.None();
        s.openList = 0;
        s.openSlot = 0 - 1;
        s.pickMode = 0;
        s.pickMap = 0;
        s.pickSort = 0;
        s.pickScroll = 0;
        s.pickSearch = "";
        s.enemyDiff = new int[7];
        s.enemyOpen = new bool[7];
        s.enemyCountry = new int[7];
        s.enemyColor = new int[7];
        s.enemyTeam = new int[7];
        for (int i = 0; i < 7; i = i + 1) {
            s.enemyDiff[i] = Difficulty.Brutal();
            // The classic 1v1: one AI. More open from the setup screen.
            s.enemyOpen[i] = i == 0;
            // 随机 for both, so an AI row reads 随机 until the player picks a
            // concrete country or colour for it.
            s.enemyCountry[i] = 0 - 1;
            s.enemyColor[i] = 0 - 1;
            s.enemyTeam[i] = Team.None();
        }
        s.quit = false;
        return s;
    }

    int CurrentScene() { return this.scene; }
    int MapIndex() { return this.mapIndex; }
    int SideIndex() { return this.side; }
    int CountryIndex() { return this.country; }
    int ColorIndex() { return this.color; }
    int StartPosIndex() { return this.startPos; }
    int MapCount() { return this.mapCount; }
    int StartCredits() { return this.startCredits; }
    int GameSpeed() { return this.gameSpeed; }
    int UnitCount() { return this.unitCount; }
    bool Superweapons() { return this.superweapons; }
    bool ShortGame() { return this.shortGame; }
    bool McvRedeploy() { return this.mcvRedeploy; }
    bool Crates() { return this.crates; }
    bool DestroyableBridges() { return this.destroyableBridges; }
    bool MultiEngineer() { return this.multiEngineer; }
    bool NoDogEngiKills() { return this.noDogEngiKills; }
    bool BuildOffAlly() { return this.buildOffAlly; }
    bool WantsQuit() { return this.quit; }

    int OpenList() { return this.openList; }
    int OpenSlot() { return this.openSlot; }
    void SetOpenList(int kind, int slot) {
        this.openList = kind;
        this.openSlot = slot;
    }
    void CloseList() { this.openList = 0; this.openSlot = 0 - 1; }

    int TeamIndex() { return this.team; }
    void SetTeam(int t) { this.team = t; }

    void ToggleDestroyableBridges() {
        this.destroyableBridges = !this.destroyableBridges;
    }
    void ToggleMultiEngineer() { this.multiEngineer = !this.multiEngineer; }
    void ToggleNoDogEngiKills() { this.noDogEngiKills = !this.noDogEngiKills; }
    void ToggleBuildOffAlly() { this.buildOffAlly = !this.buildOffAlly; }

    int EnemyDifficulty(int slot) {
        if (slot < 0 || slot >= 7) { return Difficulty.Normal(); }
        return this.enemyDiff[slot];
    }

    /// <summary>Steps to the next difficulty; the reference's slot offers all
    /// five of its AI names, so this walks the full list.</summary>
    void CycleEnemyDifficulty(int slot) {
        if (slot < 0 || slot >= 7) { return; }
        this.enemyDiff[slot] =
            (this.enemyDiff[slot] + 1) % Difficulty.Count();
    }

    void SetEnemyDifficulty(int slot, int d) {
        if (slot < 0 || slot >= 7) { return; }
        if (d < 0 || d >= Difficulty.Count()) { return; }
        this.enemyDiff[slot] = d;
    }

    /// <summary>An AI slot's country: -1 is 随机, the value it starts at.
    /// A concrete index is into the flat country list (`SetFlatCountry`).</summary>
    int EnemyCountry(int slot) {
        if (slot < 0 || slot >= 7) { return 0 - 1; }
        return this.enemyCountry[slot];
    }

    void SetEnemyCountry(int slot, int flat) {
        if (slot < 0 || slot >= 7) { return; }
        this.enemyCountry[slot] = flat;
    }

    /// <summary>An AI slot's colour: -1 is 随机, else a 0..7 house colour.</summary>
    int EnemyColor(int slot) {
        if (slot < 0 || slot >= 7) { return 0 - 1; }
        return this.enemyColor[slot];
    }

    void SetEnemyColor(int slot, int c) {
        if (slot < 0 || slot >= 7) { return; }
        this.enemyColor[slot] = c;
    }

    int EnemyTeam(int slot) {
        if (slot < 0 || slot >= 7) { return Team.None(); }
        return this.enemyTeam[slot];
    }

    void SetEnemyTeam(int slot, int t) {
        if (slot < 0 || slot >= 7) { return; }
        this.enemyTeam[slot] = t;
    }

    /// <summary>An AI row's country label: 随机(???) until the player picks a
    /// concrete one, which is what the reference shows for a random slot.</summary>
    string EnemyCountryName(int slot) {
        int flat = this.EnemyCountry(slot);
        if (flat < 1) { return "随机(???)"; }
        return Shell.FlatName(flat);
    }

    bool EnemyOpen(int slot) {
        if (slot < 0 || slot >= 7) { return false; }
        return this.enemyOpen[slot];
    }

    void ToggleEnemyOpen(int slot) {
        if (slot < 1 || slot >= 7) { return; }   // slot 0 stays in the game
        this.enemyOpen[slot] = !this.enemyOpen[slot];
    }

    // How many enemy slots are open -- the load path's AI count.
    int EnemySlotsOpen() {
        int n = 0;
        for (int i = 0; i < 7; i = i + 1) {
            if (this.enemyOpen[i]) { n = n + 1; }
        }
        return n;
    }

    string CountryName() {
        return Country.NameOf(this.side, this.country);
    }

    string CountryReg() {
        return Country.RegOf(this.side, this.country);
    }

    void Quit() { this.quit = true; }

    /// <summary>Main menu -> skirmish setup.</summary>
    void OpenSkirmish() {
        if (this.mapCount > 0) { this.scene = Scene.SkirmishSetup(); }
    }

    /// <summary>Main menu -> the 选项 page.</summary>
    void OpenOptions() {
        this.scene = Scene.Options();
    }

    // ---- the map picker -------------------------------------------------
    // Pushed from setup (`MapSelScreen.ts:160` onEnter). The pending choice
    // starts on what is already selected, so opening and cancelling is a
    // no-op.
    void OpenMapSelect() {
        this.pickMode = 0;
        this.pickMap = this.mapIndex;
        this.pickScroll = 0;
        this.pickSearch = "";
        this.scene = Scene.MapSelect();
    }

    int PickMode() { return this.pickMode; }
    void SetPickMode(int m) {
        if (m >= 0 && m < Shell.ModeCount()) { this.pickMode = m; }
    }
    int PickMap() { return this.pickMap; }
    void SetPickMap(int m, int count) {
        if (m >= 0 && m < count) { this.pickMap = m; }
    }
    int PickSort() { return this.pickSort; }
    void SetPickSort(int s) {
        if (s >= 0 && s <= 4) { this.pickSort = s; }
    }
    int PickScroll() { return this.pickScroll; }
    void SetPickScroll(int v) {
        if (v < 0) { v = 0; }
        this.pickScroll = v;
    }
    string PickSearch() { return this.pickSearch; }
    void SetPickSearch(string s) { this.pickSearch = s; }

    /// <summary>The game modes the reference's picker lists
    /// (`MapSel.tsx:65-70` title GUI:GameType): 遭遇战, 合作战役 and 战役.
    /// Cooperative is filtered out of the selectable list
    /// (`MapSelScreen.ts:182-184`), leaving the two the picker shows.</summary>
    static int ModeCount() { return 3; }

    static string ModeLabel(int m) {
        if (m == 0) { return "遭遇战"; }
        if (m == 1) { return "合作战役"; }
        return "战役";
    }

    static string ModeDescription(int m) {
        if (m == 0) { return "标准的自由混战"; }
        if (m == 1) { return "与其他指挥官并肩作战"; }
        return "原版战役任务";
    }

    /// <summary>Commits the picker's choice -- 使用地图 (`MapSelScreen.ts:214`).</summary>
    void UseMap() {
        this.mapIndex = this.pickMap;
        this.scene = Scene.SkirmishSetup();
    }

    /// <summary>Pops the picker without taking its choice -- 取消.</summary>
    void CancelMap() {
        this.scene = Scene.SkirmishSetup();
    }

    /// <summary>Why the game cannot start yet, or "" when it can. The
    /// reference blocks below one AI (`SkirmishScreen.ts:281-294`) and shows
    /// a message box; the shell keeps the same rule and the screen reports
    /// it.</summary>
    string StartBlockedReason() {
        if (this.mapCount == 0) { return "没有可用的地图"; }
        if (this.EnemySlotsOpen() < 1) { return "至少需要一个敌人"; }
        return "";
    }

    /// <summary>Setup -> playing. Refused when the install has no maps or no
    /// enemy is in the game, so the shell cannot enter a game with nothing to
    /// fight. The load screen first: it draws the LS800 backdrop and fills the
    /// bar, then EnterGame() flips to Playing once the map is built.</summary>
    bool StartGame() {
        if (this.StartBlockedReason() != "") { return false; }
        this.scene = Scene.Loading();
        return true;
    }

    /// <summary>Loading screen -> playing, at 100%. Gated on the loading
    /// scene so a stray call cannot skip the setup screen.</summary>
    void EnterGame() {
        if (this.scene == Scene.Loading()) {
            this.scene = Scene.Playing();
        }
    }

    /// <summary>Back out one screen. From the game or its load screen that
    /// means the setup screen; from setup and the 选项 page it is the main
    /// menu. The reference stacks screens and pops them (`Controller.ts:61-76`),
    /// and its Skirmish entry sits directly on the home list
    /// (`HomeScreen.ts:55`), so setup's parent is the menu.</summary>
    void Back() {
        if (this.scene == Scene.Playing()
         || this.scene == Scene.Loading()) {
            this.scene = Scene.SkirmishSetup();
            return;
        }
        if (this.scene == Scene.MapSelect()) {
            this.scene = Scene.SkirmishSetup();
            return;
        }
        this.scene = Scene.MainMenu();
    }

    /// <summary>Moves the map selection, wrapping at both ends so the arrow
    /// keys cycle rather than sticking.</summary>
    void SelectMap(int delta) {
        if (this.mapCount <= 0) { return; }
        int n = this.mapIndex + delta;
        while (n < 0) { n = n + this.mapCount; }
        this.mapIndex = n % this.mapCount;
    }

    void SelectMapAt(int index) {
        if (index < 0 || index >= this.mapCount) { return; }
        this.mapIndex = index;
    }

    void SetSide(int side) {
        if (side == Side.Allied() || side == Side.Soviet()
         || side == Side.Yuri()) {
            if (side != this.side) {
                this.side = side;
                this.country = 0;   // the country list belongs to the side
            }
        }
    }

    void SetCountry(int index) {
        if (index >= 0 && index < Country.Count(this.side)) {
            this.country = index;
        }
    }

    /// <summary>The player colours, the eight the original offers, as the
    /// RGB the UI paints the swatch with and the RGB the world's remap uses.
    /// Index order matches the original's colour dropdown.</summary>
    static void ColorRgb(int i, List<int> rgb) {
        if (i == 1) { RgbSet(rgb, 196, 32, 32); }             // 红
        else if (i == 2) { RgbSet(rgb, 32, 168, 32); }        // 绿
        else if (i == 3) { RgbSet(rgb, 232, 144, 32); }       // 橙
        else if (i == 4) { RgbSet(rgb, 140, 64, 216); }       // 紫
        else if (i == 5) { RgbSet(rgb, 32, 188, 188); }       // 青
        else if (i == 6) { RgbSet(rgb, 232, 96, 176); }       // 粉
        else if (i == 7) { RgbSet(rgb, 216, 184, 64); }       // 金
        else { RgbSet(rgb, 48, 88, 232); }                    // 蓝
    }

    static void RgbSet(List<int> rgb, int r, int g, int b) {
        if (rgb.Count < 3) { rgb.Add(0); rgb.Add(0); rgb.Add(0); }
        rgb[0] = r;
        rgb[1] = g;
        rgb[2] = b;
    }

    void SetColor(int index) {
        if (index >= 0 && index <= 7) { this.color = index; }
    }

    void SetStartPos(int index) {
        // 0 = random; 1..8 name a waypoint. Validation against the map's own
        // count happens at game start, which knows the map.
        if (index >= 0 && index <= 8) { this.startPos = index; }
    }

    void AdjustCredits(int delta) {
        int v = this.startCredits + delta;
        if (v < 500) { v = 500; }
        if (v > 100000) { v = 100000; }
        this.startCredits = v;
    }

    void AdjustSpeed(int delta) {
        int v = this.gameSpeed + delta;
        if (v < 0) { v = 0; }
        if (v > 6) { v = 6; }
        this.gameSpeed = v;
    }

    /// <summary>The 选项 page's speed slider sets the value directly: the
    /// original's option screen offers the seven stop positions.</summary>
    void SetSpeed(int v) {
        if (v < 0) { v = 0; }
        if (v > 6) { v = 6; }
        this.gameSpeed = v;
    }

    void AdjustUnits(int delta) {
        int v = this.unitCount + delta;
        if (v < 0) { v = 0; }
        if (v > 10) { v = 10; }
        this.unitCount = v;
    }

    void ToggleSuperweapons() { this.superweapons = !this.superweapons; }
    void ToggleShortGame() { this.shortGame = !this.shortGame; }
    void ToggleMcvRedeploy() { this.mcvRedeploy = !this.mcvRedeploy; }
    void ToggleCrates() { this.crates = !this.crates; }

    // Country dropdown kind in openList: 1 is the player's flat country list.
    static int ListNone() { return 0; }
    static int ListCountry() { return 1; }
    static int ListColor() { return 2; }
    static int ListStartPos() { return 3; }
    static int ListTeam() { return 4; }
    static int ListEnemyDiff() { return 5; }
    static int ListEnemyCountry() { return 6; }
    static int ListEnemyColor() { return 7; }
    static int ListEnemyTeam() { return 8; }

    /// <summary>The player's country dropdown, expressed through the shared
    /// open-list state so only one popup is ever down.</summary>
    bool CountryListOpen() { return this.openList == Shell.ListCountry(); }
    void SetCountryListOpen(bool open) {
        if (open) {
            this.SetOpenList(Shell.ListCountry(), 0 - 1);
        } else if (this.CountryListOpen()) {
            this.CloseList();
        }
    }

    // The skirmish country dropdown is one flat list across the sides, the
    // way the original presented it: picking 苏俄 moves the player to the
    // Soviet side without a separate side toggle. Index 0 is not used -- the
    // player always fields a concrete country; only the AI plays 随机.
    // Indices 1..5 Allied, 6..9 Soviet, 10 Yuri -- ten real entries.
    static int FlatCount() { return 10; }

    static string FlatName(int i) {
        if (i >= 1 && i <= 5) { return Country.NameOf(Side.Allied(), i - 1); }
        if (i >= 6 && i <= 9) { return Country.NameOf(Side.Soviet(), i - 6); }
        if (i == 10) { return Country.NameOf(Side.Yuri(), 0); }
        return "随机(???)";
    }

    int FlatIndex() {
        if (this.side == Side.Allied()) { return 1 + this.country; }
        if (this.side == Side.Soviet()) { return 6 + this.country; }
        if (this.side == Side.Yuri()) { return 10; }
        return 1;
    }

    void SetFlatCountry(int i) {
        if (i >= 1 && i <= 5) {
            this.SetSide(Side.Allied());
            this.SetCountry(i - 1);
        } else if (i >= 6 && i <= 9) {
            this.SetSide(Side.Soviet());
            this.SetCountry(i - 6);
        } else if (i == 10) {
            this.SetSide(Side.Yuri());
            this.SetCountry(0);
        }
    }
}
