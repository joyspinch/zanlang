using System;

namespace ZanWeb;

/* sys_setting 表的键名集中定义，防止拼写错误导致静默回退默认值。*/
class SettingKeys {
    static string SiteTitle = "site.title";
    static string SiteTimezone = "site.timezone";

    /* 授权策略：下发到 SDK 的掉线宽限秒数与默认座位策略。*/
    static string LicenseGrace = "license.grace.seconds";
    static string LicenseHeartbeat = "license.heartbeat.seconds";
}

/* 应用内部路径与路由 action 命名常量。*/
class Routes {
    static string Login = "/admin/login";
    static string Logout = "/admin/logout";
    static string Admin = "/admin";
    static string Home = "/";
}

/* 返回码：0000 成功，其余为客户端可分支判断的错误原因。*/
class Codes {
    static string Ok = "0000";
    static string NoAuth = "0001";
    static string NoPerm = "0403";
    static string BadInput = "0003";
    static string NotFound = "0404";
    static string Conflict = "0409";
    static string Failed = "0500";
}

/* 授权域的业务码：SDK 按 code 分支，msg 是给人看的一句拒绝理由。*/
class LicenseCodes {
    static string Ok = "0000";
    static string BadInput = "0003";
    static string NoProduct = "2001";
    static string BadCode = "2002";
    static string BadAccount = "2003";
    static string Expired = "2004";
    static string DeviceMismatch = "2005";
    static string SeatLimit = "2006";
    static string Revoked = "2007";
    static string BadSession = "2008";
}
