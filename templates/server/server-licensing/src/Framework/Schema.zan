using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model.Sys;
using ZanWeb.Model.Lic;
using ZanWeb.Dao.Sys;

namespace ZanWeb;

/* 表结构 + 种子数据，启动时由 main.zan 一次性应用。CodeFirst (SyncStructure) 读取数据库目录发 DDL，不做每次请求触发。种子带计数保护，重复启动不变。权限仅 seed 内置角色持有哪些 action，其余从路由表派生。*/
class Schema {
    /* 创建/更新全部表并填充种子数据。数据库不可达时返回 false，服务器仍启动。*/
    static async bool Ensure(DbContext ctx) {
        IDbConnection db = await ctx.Acquire();
        if (db == null) { return false; }
        try {
            /* SQLite 启用 WAL（其他引擎无操作）：多 worker 共享文件时避免写者阻塞读者。*/
            await DbSchema.UseWriteAheadLogAsync(db);
            /* 编译期已知所有 [Table] 类，一行调用覆盖全部，新模型无需补行。*/
            await db.SyncStructureAllAsync();

            if (!await Schema.SeedAdmin(db)) { return false; }
            if (!await Schema.SeedRoles(db)) { return false; }
            if (!await Schema.SeedDepartments(db)) { return false; }
            if (!await Schema.SeedSettings(db)) { return false; }
            if (!await Schema.SeedLicense(db)) { return false; }
            return true;
        } finally {
            ctx.Release(db);
        }
    }

    /* 空库创建 bootstrap 账号；密码为开发用，部署前必须修改。*/
    static async bool SeedAdmin(IDbConnection db) {
        UserDao users = new UserDao(db);
        int have = await users.Count();
        if (have > 0) { return true; }
        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        User admin = new User();
        admin.username = "admin";
        admin.passwordSalt = salt;
        admin.passwordHash = AuthUser.PasswordHash("admin1234", salt);
        admin.nickname = "系统管理员";
        admin.status = AuthUser.Active;
        admin.isSuper = 1;
        admin.tokenVersion = 1;
        admin.createdAt = WebApp.NowSeconds();
        int _id = await users.Insert(admin);
        return _id > 0;
    }

    /* 两个内置角色：admin（全部管理）和 operator（日常运营）。bootstrap 账号绕过角色表，防止误操作锁死。具体权限由 SyncRoleGrants 从路由表填充。*/
    static async bool SeedRoles(IDbConnection db) {
        int have = await db.Select<Role>().CountAsync();
        if (have > 0) { return true; }
        int _admin = await Schema.AddRole(db, "系统管理员", "admin", 1,
            "除超级管理员外的全部管理权限", DataScope.RoleAll);
        int _operator = await Schema.AddRole(db, "授权运营", "operator", 10,
            "发放激活码与账号授权、处理解绑", DataScope.RoleAll);
        return _admin > 0 && _operator > 0;
    }

    static async int AddRole(IDbConnection db, string name, string code, int rank,
                          string description, int dataScope) {
        Role r = new Role();
        r.name = name;
        r.code = code;
        r.rank = rank;
        r.status = 1;
        r.description = description;
        /* 旧行缺此列则读作 0，DataScope 视为 全部数据，升级不缩权。*/
        r.dataScope = dataScope;
        r.scopeDepts = "";
        r.createdAt = WebApp.NowSeconds();
        r.updatedAt = r.createdAt;
        return await db.Insert<Role>(r).ExecuteIdentityAsync();
    }

    static async bool Grant(IDbConnection db, int roleId, string screen, int mask,
                            long now) {
        RoleGrant g = new RoleGrant();
        g.roleId = roleId;
        g.action = screen;
        g.mask = mask;
        g.createdAt = now;
        int _id = await db.Insert<RoleGrant>(g).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedDepartments(IDbConnection db) {
        int have = await db.Select<Department>().CountAsync();
        if (have > 0) { return true; }
        if (!await Schema.AddDept(db, 0, "总部", "root", 1)) { return false; }
        if (!await Schema.AddDept(db, 1, "技术部", "tech", 2)) { return false; }
        return await Schema.AddDept(db, 1, "内容运营", "content", 3);
    }

    static async bool AddDept(IDbConnection db, int parentId, string name,
                           string code, int sortOrder) {
        Department d = new Department();
        d.parentId = parentId;
        d.name = name;
        d.code = code;
        d.leaderUserId = 0;
        d.sortOrder = sortOrder;
        d.status = 1;
        int _id = await db.Insert<Department>(d).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedSettings(IDbConnection db) {
        int have = await db.Select<SiteSetting>().CountAsync();
        if (have > 0) { return true; }
        if (!await Schema.AddSetting(db, "基本", "site.title", "站点名称",
            "Zan 授权服务", "text", "浏览器标题与管理后台品牌使用", 1)) { return false; }
        if (!await Schema.AddSetting(db, "基本", "site.timezone", "时区偏移",
            "480", "text",
            "与 UTC 的分钟偏移，例如 480 表示 UTC+8（北京时间）", 5)) { return false; }
        if (!await Schema.EnsureSetting(db, "授权策略", "license.grace.seconds",
            "掉线宽限秒数", "86400", "text",
            "客户端断网后在此秒数内仍放行；下发到 SDK 的 grace_seconds", 10)) { return false; }
        return await Schema.EnsureSetting(db, "授权策略", "license.heartbeat.seconds",
            "建议心跳间隔秒数", "300", "text",
            "管理页面展示用；SDK 默认按 300 秒心跳", 11);
    }

    static async bool EnsureSetting(IDbConnection db, string groupName, string name,
                                string label, string value, string kind,
                                string tip, int sortOrder) {
        int have = await db.Select<SiteSetting>().Where(a => a.name == name).CountAsync();
        if (have > 0) { return true; }
        return await Schema.AddSetting(db, groupName, name, label, value, kind, tip, sortOrder);
    }

    static async bool AddSetting(IDbConnection db, string groupName, string name,
                             string label, string value, string kind,
                             string tip, int sortOrder) {
        SiteSetting s = new SiteSetting();
        s.groupName = groupName;
        s.name = name;
        s.label = label;
        s.value = value;
        s.kind = kind;
        s.tip = tip;
        s.sortOrder = sortOrder;
        s.updatedAt = WebApp.NowSeconds();
        int _id = await db.Insert<SiteSetting>(s).ExecuteIdentityAsync();
        return _id > 0;
    }

    /* 授权域种子：示例产品 + 两个示例激活码 + editor 角色说明外的账号授权示例。
     * 明文码只在种子注释中出现一次，库里存摘要。*/
    static async bool SeedLicense(IDbConnection db) {
        int products = await db.Select<Product>().CountAsync();
        if (products > 0) { return true; }
        Product demo = new Product();
        demo.productId = "demo-app";
        demo.name = "示例桌面软件";
        demo.secret = "";
        demo.status = 1;
        demo.note = "模板自带示例；在客户端 SDK 里用 Product(\"demo-app\") 指向它";
        demo.createdAt = WebApp.NowSeconds();
        int pid = await db.Insert<Product>(demo).ExecuteIdentityAsync();
        if (pid <= 0) { return false; }
        long now = WebApp.NowSeconds();

        /* 月度码 ZPQ-D1QJ-M8RR-K3SA（按月，1 台设备）；终身码 ETJ-3FGW-HG62-UU1D。*/
        if (!await Schema.SeedCode(db, pid, "ZPQ-D1QJ-M8RR-K3SA", 30, 1, now)) {
            return false;
        }
        return await Schema.SeedCode(db, pid, "ETJ-3FGW-HG62-UU1D", 0, 1, now);
    }

    static async bool SeedCode(IDbConnection db, int productId, string text,
                            int durationDays, int maxDevices, long now) {
        LicenseCode c = new LicenseCode();
        c.productId = productId;
        c.codeDigest = Hex.Encode(Sha256.Hash(text, text.Length), 32);
        c.codeTail = text;
        c.durationDays = durationDays;
        c.maxDevices = maxDevices;
        c.status = 1;
        c.redeemed = 0;
        c.redeemedAt = 0;
        c.note = "示例激活码";
        c.createdAt = now;
        int _id = await db.Insert<LicenseCode>(c).ExecuteIdentityAsync();
        return _id > 0;
    }

    /* ---- 路由派生授权 ---- */
    /* 存在的权限 = 路由表。部署决策写入 sys_role_grant 行。内置 admin 始终覆盖全部管理屏，内置 editor 始终覆盖内容屏。本方法只 INSERT，操作者撤销的权限不会被重新添加。*/

    /* 将 mask=0 的旧授权行按 screen 合并为一条屏掩码行；仅 mask=0 的行参与，第二次启动起即 no-op。未声明位的 action 丢弃并在 Perm.Index boot 行提示。*/
    static async bool MigrateGrants(IDbConnection db) {
        List<RoleGrant> old = await db.Select<RoleGrant>()
            .Where(a => a.mask == 0).ToListAsync();
        if (old.Count == 0) { return true; }

        List<string> keys = new List<string>();
        List<int> masks = new List<int>();
        for (int i = 0; i < old.Count; i = i + 1) {
            RoleGrant g = old[i];
            int bit = Perm.BitOf(g.action);
            if (bit == 0) { continue; }
            string key = Convert.ToString(g.roleId) + "|"
                + Perm.ScreenOf(g.action);
            int at = keys.IndexOf(key);
            if (at < 0) { keys.Add(key); masks.Add(bit); }
            else { masks[at] = masks[at] | bit; }
        }

        int _gone = await db.Delete<RoleGrant>().Where(a => a.mask == 0)
            .ExecuteAffrowsAsync();
        long now = WebApp.NowSeconds();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string key = keys[i];
            int bar = key.IndexOf("|");
            int roleId = Convert.ToInt32(key.Substring(0, bar));
            string screen = key.Substring(bar + 1);
            RoleGrant have = await db.Select<RoleGrant>()
                .Where(a => a.roleId == roleId && a.action == screen)
                .FirstAsync();
            if (have != null) {
                int merged = have.mask | masks[i];
                int _n = await db.Update<RoleGrant>()
                    .Set(a => a.mask, merged)
                    .Where(a => a.id == have.id).ExecuteAffrowsAsync();
                continue;
            }
            if (!await Schema.Grant(db, roleId, screen, masks[i], now)) { return false; }
        }
        Console.WriteLine("[rbac] 旧授权已合并为 "
            + Convert.ToString(keys.Count) + " 条屏掩码");
        return true;
    }

    /* 将不再存在的旧屏键迁移到带模块前缀的新键；无匹配或多匹配的不动并在日志中标出。*/
    static async bool MigrateGrantKeys(IDbConnection db) {
        List<RoleGrant> rows = await db.Select<RoleGrant>()
            .Where(a => a.mask != 0).ToListAsync();
        int moved = 0;
        List<string> stray = new List<string>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            RoleGrant g = rows[i];
            if (Perm.MaskOf(g.action) != 0) { continue; }
            string now = Perm.Qualify(g.action);
            if (now.Length == 0) { stray.Add(g.action); continue; }
            int gid = g.id;
            int _n = await db.Update<RoleGrant>().Set(a => a.action, now)
                .Where(a => a.id == gid).ExecuteAffrowsAsync();
            moved = moved + 1;
        }
        if (moved > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(moved)
                + " 条授权已改用带模块前缀的屏键");
        }
        if (stray.Count > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(stray.Count)
                + " 条授权的屏幕已不存在，保留未动: "
                + Perm.Join(stray, 8));
        }
        return true;
    }

    /* 给内置角色补发尚未持有的受控 action。每次启动安全，永不删除。
     * admin 拿全部屏；operator 只拿授权域（/admin/lic/ 前缀）屏。*/
    static async bool SyncRoleGrants(WebApp app) {
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return false; }
        try {
            if (!await Schema.MigrateGrants(db)) { return false; }
            if (!await Schema.MigrateGrantKeys(db)) { return false; }
            Role admin = await db.Select<Role>()
                .Where(a => a.code == "admin").FirstAsync();
            Role op = await db.Select<Role>()
                .Where(a => a.code == "operator").FirstAsync();
            if (admin == null && op == null) { return true; }

            List<RoleGrant> rows = await db.Select<RoleGrant>().ToListAsync();
            string adminHas = ",";
            string opHas = ",";
            for (int i = 0; i < rows.Count; i = i + 1) {
                RoleGrant g = rows[i];
                if (admin != null && g.roleId == admin.id) {
                    adminHas = adminHas + g.action + ",";
                }
                if (op != null && g.roleId == op.id) {
                    opHas = opHas + g.action + ",";
                }
            }

            bool fillAdmin = admin != null && adminHas == ",";
            bool fillOp = op != null && opHas == ",";
            if (!fillAdmin && !fillOp) { return true; }

            long now = WebApp.NowSeconds();
            List<Route> routes = app.router.All();
            List<string> screens = new List<string>();
            List<int> masks = new List<int>();
            List<bool> lic = new List<bool>();
            for (int i = 0; i < routes.Count; i = i + 1) {
                Route r = routes[i];
                if (r.action.Length == 0 || !r.needsAuth) { continue; }
                int bit = Perm.BitOf(r.action);
                if (bit == 0) { continue; }
                string screen = Perm.ScreenOf(r.action);
                int at = screens.IndexOf(screen);
                if (at < 0) {
                    screens.Add(screen);
                    masks.Add(bit);
                    lic.Add(Schema.IsLic(r.pattern));
                } else {
                    masks[at] = masks[at] | bit;
                    if (Schema.IsLic(r.pattern)) { lic[at] = true; }
                }
            }
            for (int i = 0; i < screens.Count; i = i + 1) {
                if (fillAdmin && !await Schema.Grant(db, admin.id, screens[i], masks[i], now)) {
                    return false;
                }
                if (fillOp && lic[i] &&
                    !await Schema.Grant(db, op.id, screens[i], masks[i], now)) {
                    return false;
                }
            }
            return true;
        } finally {
            AuthUser.Give(db);
        }
    }

    static bool IsLic(string pattern) {
        return pattern.StartsWith("/admin/lic/");
    }

}
